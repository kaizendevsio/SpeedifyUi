{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnetwork.local/schemas/xbond-lab-result-v1.json",
  "title": "XBond local network-condition lab result",
  "$defs": {
    "iperfDirectionResult": {
      "type": "object",
      "required": [
        "exit_code",
        "valid_complete_json",
        "mbps"
      ],
      "properties": {
        "exit_code": { "type": "integer" },
        "valid_complete_json": { "type": "boolean" },
        "mbps": { "type": "number", "minimum": 0 }
      }
    },
    "throughputResult": {
      "type": "object",
      "required": ["upload", "download"],
      "properties": {
        "upload": { "$ref": "#/$defs/iperfDirectionResult" },
        "download": { "$ref": "#/$defs/iperfDirectionResult" }
      },
      "additionalProperties": false
    },
    "completeIperfDirectionResult": {
      "allOf": [
        { "$ref": "#/$defs/iperfDirectionResult" },
        {
          "properties": {
            "exit_code": { "const": 0 },
            "valid_complete_json": { "const": true }
          }
        }
      ]
    },
    "completeThroughputResult": {
      "type": "object",
      "required": ["upload", "download"],
      "properties": {
        "upload": {
          "$ref": "#/$defs/completeIperfDirectionResult"
        },
        "download": {
          "$ref": "#/$defs/completeIperfDirectionResult"
        }
      },
      "additionalProperties": false
    },
    "baselineWarmup": {
      "type": "object",
      "required": [
        "valid_complete",
        "floor_mbps",
        "throughput"
      ],
      "properties": {
        "valid_complete": { "type": "boolean" },
        "floor_mbps": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "throughput": { "$ref": "#/$defs/throughputResult" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "valid_complete": { "const": true } },
            "required": ["valid_complete"]
          },
          "then": {
            "properties": {
              "floor_mbps": {
                "type": "number",
                "minimum": 0
              },
              "throughput": {
                "$ref": "#/$defs/completeThroughputResult"
              }
            }
          },
          "else": {
            "properties": {
              "floor_mbps": { "type": "null" },
              "throughput": {
                "not": {
                  "$ref": "#/$defs/completeThroughputResult"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "baselineAttempt": {
      "type": "object",
      "required": [
        "attempt",
        "valid_complete",
        "floor_mbps",
        "throughput"
      ],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "valid_complete": { "type": "boolean" },
        "floor_mbps": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "throughput": { "$ref": "#/$defs/throughputResult" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "valid_complete": { "const": true } },
            "required": ["valid_complete"]
          },
          "then": {
            "properties": {
              "floor_mbps": {
                "type": "number",
                "minimum": 0
              },
              "throughput": {
                "$ref": "#/$defs/completeThroughputResult"
              }
            }
          },
          "else": {
            "properties": {
              "floor_mbps": { "type": "null" },
              "throughput": {
                "not": {
                  "$ref": "#/$defs/completeThroughputResult"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "baselineMeasurement": {
      "type": "object",
      "required": [
        "warmup_seconds",
        "warmup",
        "sample_seconds",
        "required_valid_samples",
        "max_attempts",
        "attempt_count",
        "valid_attempt_count",
        "attempts",
        "complete",
        "selected_attempt",
        "selected_median_floor_mbps",
        "selected_throughput"
      ],
      "properties": {
        "warmup_seconds": { "const": 2 },
        "warmup": { "$ref": "#/$defs/baselineWarmup" },
        "sample_seconds": { "const": 3 },
        "required_valid_samples": { "const": 3 },
        "max_attempts": { "const": 5 },
        "attempt_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "valid_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "attempts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/baselineAttempt" }
        },
        "complete": { "type": "boolean" },
        "selected_attempt": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "selected_median_floor_mbps": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "selected_throughput": {
          "oneOf": [
            { "$ref": "#/$defs/throughputResult" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "complete": { "const": true } },
            "required": ["complete"]
          },
          "then": {
            "properties": {
              "attempt_count": { "minimum": 3 },
              "valid_attempt_count": { "const": 3 },
              "attempts": {
                "minItems": 3,
                "maxItems": 5,
                "contains": {
                  "type": "object",
                  "properties": {
                    "valid_complete": { "const": true }
                  },
                  "required": ["valid_complete"]
                },
                "minContains": 3,
                "maxContains": 3
              },
              "selected_attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "selected_median_floor_mbps": {
                "type": "number",
                "minimum": 0
              },
              "selected_throughput": {
                "$ref": "#/$defs/completeThroughputResult"
              }
            }
          },
          "else": {
            "properties": {
              "attempt_count": { "const": 5 },
              "valid_attempt_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "attempts": {
                "minItems": 5,
                "maxItems": 5,
                "contains": {
                  "type": "object",
                  "properties": {
                    "valid_complete": { "const": true }
                  },
                  "required": ["valid_complete"]
                },
                "minContains": 0,
                "maxContains": 2
              },
              "selected_attempt": { "type": "null" },
              "selected_median_floor_mbps": { "type": "null" },
              "selected_throughput": { "type": "null" }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "attempt_count": { "const": 3 },
                "attempts": {
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 1 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 2 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 3 } },
                      "required": ["attempt"]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "attempt_count": { "const": 4 },
                "attempts": {
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 1 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 2 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 3 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 4 } },
                      "required": ["attempt"]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "attempt_count": { "const": 5 },
                "attempts": {
                  "minItems": 5,
                  "maxItems": 5,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 1 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 2 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 3 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 4 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 5 } },
                      "required": ["attempt"]
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "valid_attempt_count": { "const": 0 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 0,
                  "maxContains": 0
                }
              }
            },
            {
              "properties": {
                "valid_attempt_count": { "const": 1 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              }
            },
            {
              "properties": {
                "valid_attempt_count": { "const": 2 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 2,
                  "maxContains": 2
                }
              }
            },
            {
              "properties": {
                "valid_attempt_count": { "const": 3 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 3,
                  "maxContains": 3
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": { "complete": { "const": true } },
            "required": ["complete"]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "selected_attempt": { "const": 1 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 1 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 2 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 2 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 3 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 3 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 4 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 4 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 5 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 5 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "status",
    "started_at",
    "finished_at",
    "metrics",
    "thresholds",
    "cleanup",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario": {
      "enum": [
        "topology-smoke",
        "healthy-single",
        "anchor-bad-backup",
        "all-intermittent",
        "heavy-bidirectional",
        "silent-blackhole",
        "usb-reenumeration",
        "tun-read-failure",
        "server-process-restart",
        "tun-write-backpressure",
        "server-tun-write-backpressure",
        "clock-rollback",
        "clock-skew",
        "stale-return-schedule",
        "queue-saturation",
        "mtu-sweep",
        "soak"
      ]
    },
    "status": { "enum": ["pass", "fail", "blocked", "error"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "reason": { "type": ["string", "null"] },
    "metrics": { "type": "object" },
    "thresholds": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": [
        "git_commit",
        "git_branch",
        "git_dirty",
        "docker_context",
        "docker_host",
        "docker_engine_version",
        "docker_kernel",
        "docker_os",
        "image_id",
        "image_digests",
        "lab_orchestrator_sha256",
        "result_schema_sha256",
        "lab_orchestrator_source_sha256",
        "result_schema_source_sha256",
        "lab_orchestrator_hash_matches_source",
        "result_schema_hash_matches_source",
        "client_binary_sha256",
        "server_binary_sha256"
      ],
      "properties": {
        "git_commit": { "type": "string", "minLength": 40 },
        "git_branch": { "type": "string", "minLength": 1 },
        "git_dirty": { "type": "boolean" },
        "docker_context": { "const": "xeon-dev" },
        "docker_host": { "type": "string", "minLength": 1 },
        "docker_engine_version": { "type": "string", "minLength": 1 },
        "docker_kernel": { "type": "string", "minLength": 1 },
        "docker_os": { "type": "string", "minLength": 1 },
        "image_id": { "type": "string", "pattern": "^sha256:" },
        "image_digests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "client_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "server_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lab_orchestrator_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lab_orchestrator_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_schema_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lab_orchestrator_hash_matches_source": { "const": true },
        "result_schema_hash_matches_source": { "const": true }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": [
        "namespaces_remaining",
        "processes_remaining",
        "process_groups_remaining",
        "namespace_pids_remaining",
        "qdisc_state_removed",
        "qdisc_remaining"
      ],
      "properties": {
        "namespaces_remaining": { "type": "array", "items": { "type": "string" } },
        "processes_remaining": { "type": "array", "items": { "type": "integer" } },
        "process_groups_remaining": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "namespace_pids_remaining": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "qdisc_state_removed": { "type": "boolean" },
        "qdisc_remaining": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scenario": { "const": "server-process-restart" } },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "baseline_ping",
              "post_restart_ping",
              "restored_throughput",
              "automatic_recovery_observed",
              "recovery_seconds",
              "client_pid_unchanged",
              "server_pid_changed",
              "session_id_changed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": { "const": "server-tun-write-backpressure" }
        },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": ["responsive_pressure", "severe_pressure"],
            "properties": {
              "responsive_pressure": {
                "type": "object",
                "required": [
                  "peak_tun_write_queue_depth",
                  "queue_remained_bounded",
                  "client_and_server_alive_during_pressure",
                  "status_control_and_heartbeat_progressed"
                ]
              },
              "severe_pressure": {
                "type": "object",
                "required": [
                  "server_exit_code",
                  "fail_closed_seconds",
                  "explicit_saturation_failure",
                  "client_remained_running"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "scenario": { "const": "soak" } },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "configured_duration_seconds",
              "baseline_measurement"
            ],
            "properties": {
              "configured_duration_seconds": {
                "type": "integer",
                "minimum": 1800
              },
              "baseline_measurement": {
                "$ref": "#/$defs/baselineMeasurement"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": { "const": "soak" },
          "status": { "const": "pass" }
        },
        "required": ["scenario", "status"]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "baseline_measurement": {
                "properties": {
                  "complete": { "const": true },
                  "warmup": {
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  }
                },
                "required": ["complete", "warmup"]
              }
            }
          }
        }
      }
    }
  ]
}
