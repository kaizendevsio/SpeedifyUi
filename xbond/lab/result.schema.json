{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xnetwork.local/schemas/xbond-lab-result-v1.json",
  "title": "XBond local network-condition lab result",
  "$defs": {
    "iperfDirectionResult": {
      "type": "object",
      "required": [
        "exit_code",
        "valid_complete_json",
        "mbps"
      ],
      "properties": {
        "exit_code": { "type": "integer" },
        "valid_complete_json": { "type": "boolean" },
        "mbps": { "type": "number", "minimum": 0 }
      }
    },
    "throughputResult": {
      "type": "object",
      "required": ["upload", "download"],
      "properties": {
        "upload": { "$ref": "#/$defs/iperfDirectionResult" },
        "download": { "$ref": "#/$defs/iperfDirectionResult" }
      },
      "additionalProperties": false
    },
    "completeIperfDirectionResult": {
      "allOf": [
        { "$ref": "#/$defs/iperfDirectionResult" },
        {
          "properties": {
            "exit_code": { "const": 0 },
            "valid_complete_json": { "const": true }
          }
        }
      ]
    },
    "completeThroughputResult": {
      "type": "object",
      "required": ["upload", "download"],
      "properties": {
        "upload": {
          "$ref": "#/$defs/completeIperfDirectionResult"
        },
        "download": {
          "$ref": "#/$defs/completeIperfDirectionResult"
        }
      },
      "additionalProperties": false
    },
    "baselineWarmup": {
      "type": "object",
      "required": [
        "valid_complete",
        "floor_mbps",
        "throughput"
      ],
      "properties": {
        "valid_complete": { "type": "boolean" },
        "floor_mbps": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "throughput": { "$ref": "#/$defs/throughputResult" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "valid_complete": { "const": true } },
            "required": ["valid_complete"]
          },
          "then": {
            "properties": {
              "floor_mbps": {
                "type": "number",
                "minimum": 0
              },
              "throughput": {
                "$ref": "#/$defs/completeThroughputResult"
              }
            }
          },
          "else": {
            "properties": {
              "floor_mbps": { "type": "null" },
              "throughput": {
                "not": {
                  "$ref": "#/$defs/completeThroughputResult"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "baselineAttempt": {
      "type": "object",
      "required": [
        "attempt",
        "valid_complete",
        "floor_mbps",
        "throughput"
      ],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "valid_complete": { "type": "boolean" },
        "floor_mbps": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "throughput": { "$ref": "#/$defs/throughputResult" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "valid_complete": { "const": true } },
            "required": ["valid_complete"]
          },
          "then": {
            "properties": {
              "floor_mbps": {
                "type": "number",
                "minimum": 0
              },
              "throughput": {
                "$ref": "#/$defs/completeThroughputResult"
              }
            }
          },
          "else": {
            "properties": {
              "floor_mbps": { "type": "null" },
              "throughput": {
                "not": {
                  "$ref": "#/$defs/completeThroughputResult"
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "baselineMeasurement": {
      "type": "object",
      "required": [
        "warmup_seconds",
        "warmup",
        "sample_seconds",
        "required_valid_samples",
        "max_attempts",
        "attempt_count",
        "valid_attempt_count",
        "attempts",
        "complete",
        "selected_attempt",
        "selected_median_floor_mbps",
        "selected_throughput"
      ],
      "properties": {
        "warmup_seconds": { "const": 2 },
        "warmup": { "$ref": "#/$defs/baselineWarmup" },
        "sample_seconds": { "const": 3 },
        "required_valid_samples": { "const": 3 },
        "max_attempts": { "const": 5 },
        "attempt_count": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "valid_attempt_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "attempts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/baselineAttempt" }
        },
        "complete": { "type": "boolean" },
        "selected_attempt": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "selected_median_floor_mbps": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "selected_throughput": {
          "oneOf": [
            { "$ref": "#/$defs/throughputResult" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "complete": { "const": true } },
            "required": ["complete"]
          },
          "then": {
            "properties": {
              "attempt_count": { "minimum": 3 },
              "valid_attempt_count": { "const": 3 },
              "attempts": {
                "minItems": 3,
                "maxItems": 5,
                "contains": {
                  "type": "object",
                  "properties": {
                    "valid_complete": { "const": true }
                  },
                  "required": ["valid_complete"]
                },
                "minContains": 3,
                "maxContains": 3
              },
              "selected_attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "selected_median_floor_mbps": {
                "type": "number",
                "minimum": 0
              },
              "selected_throughput": {
                "$ref": "#/$defs/completeThroughputResult"
              }
            }
          },
          "else": {
            "properties": {
              "attempt_count": { "const": 5 },
              "valid_attempt_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "attempts": {
                "minItems": 5,
                "maxItems": 5,
                "contains": {
                  "type": "object",
                  "properties": {
                    "valid_complete": { "const": true }
                  },
                  "required": ["valid_complete"]
                },
                "minContains": 0,
                "maxContains": 2
              },
              "selected_attempt": { "type": "null" },
              "selected_median_floor_mbps": { "type": "null" },
              "selected_throughput": { "type": "null" }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "attempt_count": { "const": 3 },
                "attempts": {
                  "minItems": 3,
                  "maxItems": 3,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 1 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 2 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 3 } },
                      "required": ["attempt"]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "attempt_count": { "const": 4 },
                "attempts": {
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 1 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 2 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 3 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 4 } },
                      "required": ["attempt"]
                    }
                  ]
                }
              }
            },
            {
              "properties": {
                "attempt_count": { "const": 5 },
                "attempts": {
                  "minItems": 5,
                  "maxItems": 5,
                  "prefixItems": [
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 1 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 2 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 3 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 4 } },
                      "required": ["attempt"]
                    },
                    {
                      "type": "object",
                      "properties": { "attempt": { "const": 5 } },
                      "required": ["attempt"]
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "valid_attempt_count": { "const": 0 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 0,
                  "maxContains": 0
                }
              }
            },
            {
              "properties": {
                "valid_attempt_count": { "const": 1 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              }
            },
            {
              "properties": {
                "valid_attempt_count": { "const": 2 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 2,
                  "maxContains": 2
                }
              }
            },
            {
              "properties": {
                "valid_attempt_count": { "const": 3 },
                "attempts": {
                  "contains": {
                    "type": "object",
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  },
                  "minContains": 3,
                  "maxContains": 3
                }
              }
            }
          ]
        },
        {
          "if": {
            "properties": { "complete": { "const": true } },
            "required": ["complete"]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "selected_attempt": { "const": 1 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 1 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 2 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 2 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 3 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 3 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 4 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 4 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              },
              {
                "properties": {
                  "selected_attempt": { "const": 5 },
                  "attempts": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "attempt": { "const": 5 },
                        "valid_complete": { "const": true }
                      },
                      "required": ["attempt", "valid_complete"]
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "anchorPreconditionStage": {
      "type": "object",
      "required": [
        "stage",
        "valid",
        "failures",
        "anchor_path_id",
        "anchor_path_loss_percent",
        "recovery_active",
        "require_degraded_backups",
        "backup_paths",
        "checks",
        "stabilization"
      ],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "valid": { "type": "boolean" },
        "failures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "anchor_path_id": { "type": ["integer", "null"] },
        "anchor_path_loss_percent": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "recovery_active": { "type": ["boolean", "null"] },
        "require_degraded_backups": { "type": "boolean" },
        "backup_paths": {
          "type": "object",
          "required": ["2", "3"],
          "properties": {
            "2": { "$ref": "#/$defs/anchorBackupPathEvidence" },
            "3": { "$ref": "#/$defs/anchorBackupPathEvidence" }
          },
          "additionalProperties": false
        },
        "checks": {
          "type": "object",
          "required": [
            "anchor_loss_available",
            "anchor_path_loss_within_limit",
            "correct_anchor_selected",
            "recovery_inactive",
            "backup_paths_present",
            "backup_paths_degraded",
            "sustained_health_evidence"
          ],
          "properties": {
            "anchor_loss_available": { "type": "boolean" },
            "anchor_path_loss_within_limit": { "type": "boolean" },
            "correct_anchor_selected": { "type": "boolean" },
            "recovery_inactive": { "type": "boolean" },
            "backup_paths_present": { "type": "boolean" },
            "backup_paths_degraded": { "type": "boolean" },
            "sustained_health_evidence": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "stabilization": {
          "$ref": "#/$defs/anchorStabilizationEvidence"
        }
      },
      "additionalProperties": false
    },
    "anchorStabilizationEvidence": {
      "type": "object",
      "required": [
        "achieved",
        "required_consecutive_updates",
        "observed_unique_updates",
        "ending_consecutive_valid_updates",
        "maximum_consecutive_valid_updates",
        "elapsed_seconds",
        "observations"
      ],
      "properties": {
        "achieved": { "type": "boolean" },
        "required_consecutive_updates": { "type": "integer", "minimum": 1 },
        "observed_unique_updates": { "type": "integer", "minimum": 0 },
        "ending_consecutive_valid_updates": { "type": "integer", "minimum": 0 },
        "maximum_consecutive_valid_updates": { "type": "integer", "minimum": 0 },
        "elapsed_seconds": { "type": "number", "minimum": 0 },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at_seconds",
              "status_mtime_ns",
              "valid",
              "anchor_path_id",
              "anchor_path_loss_percent",
              "recovery_active",
              "backup_paths"
            ],
            "properties": {
              "at_seconds": { "type": "number", "minimum": 0 },
              "status_mtime_ns": { "type": "integer", "minimum": 0 },
              "valid": { "type": "boolean" },
              "anchor_path_id": { "type": ["integer", "null"] },
              "anchor_path_loss_percent": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "recovery_active": { "type": ["boolean", "null"] },
              "backup_paths": {
                "type": "object",
                "required": ["2", "3"],
                "properties": {
                  "2": { "$ref": "#/$defs/anchorBackupPathEvidence" },
                  "3": { "$ref": "#/$defs/anchorBackupPathEvidence" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "anchorBackupPathEvidence": {
      "type": "object",
      "required": ["present", "loss_percent", "role", "degraded"],
      "properties": {
        "present": { "type": "boolean" },
        "loss_percent": { "type": ["number", "null"], "minimum": 0 },
        "role": { "type": ["string", "null"] },
        "degraded": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "anchorPreconditions": {
      "type": "object",
      "required": [
        "valid",
        "failures",
        "clean_tunnel_baseline",
        "clean_tunnel_baseline_after",
        "impaired_tunnel_measurement",
        "impaired_tunnel_measurement_after"
      ],
      "properties": {
        "valid": { "type": "boolean" },
        "failures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "clean_tunnel_baseline": {
          "$ref": "#/$defs/anchorPreconditionStage"
        },
        "clean_tunnel_baseline_after": {
          "$ref": "#/$defs/anchorPreconditionStage"
        },
        "impaired_tunnel_measurement": {
          "$ref": "#/$defs/anchorPreconditionStage"
        },
        "impaired_tunnel_measurement_after": {
          "$ref": "#/$defs/anchorPreconditionStage"
        }
      },
      "additionalProperties": false
    },
    "repairCacheQuiescenceSide": {
      "type": "object",
      "required": [
        "telemetry_available",
        "authoritative_fields_present",
        "metrics",
        "missing_metrics",
        "legacy_metrics",
        "all_zero"
      ],
      "properties": {
        "telemetry_available": { "type": "boolean" },
        "authoritative_fields_present": { "type": "boolean" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "missing_metrics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "legacy_metrics": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 }
        },
        "all_zero": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "repairCacheQuiescenceClientSide": {
      "allOf": [
        { "$ref": "#/$defs/repairCacheQuiescenceSide" },
        {
          "properties": {
            "metrics": {
              "type": "object",
              "properties": {
                "process.repair_cache.entries": {
                  "type": "number",
                  "minimum": 0
                },
                "process.repair_cache.accounted_bytes": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "repairCacheQuiescenceServerSide": {
      "allOf": [
        { "$ref": "#/$defs/repairCacheQuiescenceSide" },
        {
          "properties": {
            "metrics": {
              "type": "object",
              "properties": {
                "control_plane.repair_cache.entries": {
                  "type": "number",
                  "minimum": 0
                },
                "control_plane.repair_cache.accounted_bytes": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "repairCacheQuiescenceEvidence": {
      "type": "object",
      "required": ["verified", "waited_seconds", "client", "server"],
      "properties": {
        "verified": { "type": "boolean" },
        "waited_seconds": { "type": "number", "minimum": 0 },
        "client": { "$ref": "#/$defs/repairCacheQuiescenceClientSide" },
        "server": { "$ref": "#/$defs/repairCacheQuiescenceServerSide" }
      },
      "additionalProperties": false
    },
    "robustMemoryWindow": {
      "type": "object",
      "required": [
        "sample_count",
        "start_at_seconds",
        "end_at_seconds",
        "duration_seconds",
        "theil_sen_slope_kib_per_minute",
        "edge_sample_count",
        "start_edge_median_kib",
        "end_edge_median_kib",
        "edge_median_growth_kib"
      ],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 0 },
        "start_at_seconds": { "type": ["number", "null"] },
        "end_at_seconds": { "type": ["number", "null"] },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
        "theil_sen_slope_kib_per_minute": {
          "type": ["number", "null"]
        },
        "edge_sample_count": { "type": "integer", "minimum": 0 },
        "start_edge_median_kib": { "type": ["number", "null"] },
        "end_edge_median_kib": { "type": ["number", "null"] },
        "edge_median_growth_kib": { "type": ["number", "null"] }
      },
      "additionalProperties": false
    },
    "robustMemoryEvidence": {
      "type": "object",
      "required": ["sample_count", "final_half", "final_10_minutes"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 0 },
        "final_half": { "$ref": "#/$defs/robustMemoryWindow" },
        "final_10_minutes": { "$ref": "#/$defs/robustMemoryWindow" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "status",
    "started_at",
    "finished_at",
    "metrics",
    "thresholds",
    "cleanup",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario": {
      "enum": [
        "topology-smoke",
        "four-wan-smoke",
        "four-wan-resilience",
        "app-smoke",
        "dev-stack",
        "healthy-single",
        "anchor-bad-backup",
        "all-intermittent",
        "heavy-bidirectional",
        "throughput-stress",
        "multi-session-scale",
        "silent-blackhole",
        "usb-reenumeration",
        "heartbeat-integrity",
        "tun-read-failure",
        "server-process-restart",
        "tun-write-backpressure",
        "server-tun-write-backpressure",
        "clock-rollback",
        "clock-skew",
        "stale-return-schedule",
        "queue-saturation",
        "mtu-sweep",
        "soak",
        "direct-failover",
        "adaptive-fallback"
      ]
    },
    "status": { "enum": ["pass", "fail", "blocked", "error"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "reason": { "type": ["string", "null"] },
    "metrics": { "type": "object" },
    "thresholds": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": [
        "git_commit",
        "git_branch",
        "git_dirty",
        "docker_context",
        "docker_host",
        "docker_engine_version",
        "docker_kernel",
        "docker_os",
        "image_id",
        "image_digests",
        "lab_orchestrator_sha256",
        "result_schema_sha256",
        "lab_orchestrator_source_sha256",
        "result_schema_source_sha256",
        "lab_orchestrator_hash_matches_source",
        "result_schema_hash_matches_source",
        "client_binary_sha256",
        "server_binary_sha256"
      ],
      "properties": {
        "git_commit": { "type": "string", "minLength": 40 },
        "git_branch": { "type": "string", "minLength": 1 },
        "git_dirty": { "type": "boolean" },
        "docker_context": { "const": "xeon-dev" },
        "docker_host": { "type": "string", "minLength": 1 },
        "docker_engine_version": { "type": "string", "minLength": 1 },
        "docker_kernel": { "type": "string", "minLength": 1 },
        "docker_os": { "type": "string", "minLength": 1 },
        "image_id": { "type": "string", "pattern": "^sha256:" },
        "image_digests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "client_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "server_binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lab_orchestrator_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lab_orchestrator_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_schema_source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "lab_orchestrator_hash_matches_source": { "const": true },
        "result_schema_hash_matches_source": { "const": true }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": [
        "namespaces_remaining",
        "processes_remaining",
        "process_groups_remaining",
        "namespace_pids_remaining",
        "qdisc_state_removed",
        "qdisc_remaining"
      ],
      "properties": {
        "namespaces_remaining": { "type": "array", "items": { "type": "string" } },
        "processes_remaining": { "type": "array", "items": { "type": "integer" } },
        "process_groups_remaining": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "namespace_pids_remaining": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "integer" }
          }
        },
        "qdisc_state_removed": { "type": "boolean" },
        "qdisc_remaining": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scenario": { "const": "anchor-bad-backup" } },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "stable_anchor_native_baseline",
              "clean_tunnel_baseline_measurement",
              "impaired_tunnel_measurement",
              "preconditions",
              "comparison_valid",
              "throughput",
              "throughput_retained_ratio"
            ],
            "properties": {
              "stable_anchor_native_baseline": {
                "$ref": "#/$defs/throughputResult"
              },
              "clean_tunnel_baseline_measurement": {
                "$ref": "#/$defs/baselineMeasurement"
              },
              "impaired_tunnel_measurement": {
                "$ref": "#/$defs/baselineMeasurement"
              },
              "preconditions": {
                "$ref": "#/$defs/anchorPreconditions"
              },
              "comparison_valid": { "type": "boolean" },
              "throughput": { "$ref": "#/$defs/throughputResult" },
              "throughput_retained_ratio": {
                "type": ["number", "null"],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": { "const": "anchor-bad-backup" },
          "status": { "const": "pass" }
        },
        "required": ["scenario", "status"]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "comparison_valid": { "const": true },
              "throughput_retained_ratio": { "type": "number" },
              "preconditions": {
                "properties": { "valid": { "const": true } },
                "required": ["valid"]
              },
              "clean_tunnel_baseline_measurement": {
                "properties": { "complete": { "const": true } },
                "required": ["complete"]
              },
              "impaired_tunnel_measurement": {
                "properties": { "complete": { "const": true } },
                "required": ["complete"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "scenario": { "const": "server-process-restart" } },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "baseline_ping",
              "post_restart_ping",
              "restored_throughput",
              "automatic_recovery_observed",
              "recovery_seconds",
              "client_pid_unchanged",
              "server_pid_changed",
              "session_id_changed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": { "const": "server-tun-write-backpressure" }
        },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": ["responsive_pressure", "severe_pressure"],
            "properties": {
              "responsive_pressure": {
                "type": "object",
                "required": [
                  "peak_tun_write_queue_depth",
                  "queue_remained_bounded",
                  "client_and_server_alive_during_pressure",
                  "status_control_and_heartbeat_progressed"
                ]
              },
              "severe_pressure": {
                "type": "object",
                "required": [
                  "server_exit_code",
                  "fail_closed_seconds",
                  "explicit_saturation_failure",
                  "client_remained_running"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "scenario": { "const": "soak" } },
        "required": ["scenario"]
      },
      "then": {
        "properties": {
          "metrics": {
            "required": [
              "configured_duration_seconds",
              "samples",
              "baseline_measurement",
              "rss_samples_complete",
              "rss_trends",
              "rss_robust_steady_state",
              "memory_sample_coverage",
              "memory_trends",
              "memory_robust_steady_state",
              "quiescent_sample_phase"
            ],
            "properties": {
              "configured_duration_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "samples": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "repair_cache_quiescence",
                    "processes"
                  ],
                  "properties": {
                    "repair_cache_quiescence": {
                      "$ref": "#/$defs/repairCacheQuiescenceEvidence"
                    },
                    "processes": { "type": "object" }
                  }
                }
              },
              "baseline_measurement": {
                "$ref": "#/$defs/baselineMeasurement"
              },
              "rss_samples_complete": { "type": "boolean" },
              "rss_trends": {
                "type": "object",
                "required": ["client", "server"]
              },
              "rss_robust_steady_state": {
                "type": "object",
                "required": ["client", "server"],
                "properties": {
                  "client": { "$ref": "#/$defs/robustMemoryEvidence" },
                  "server": { "$ref": "#/$defs/robustMemoryEvidence" }
                },
                "additionalProperties": false
              },
              "memory_sample_coverage": { "type": "object" },
              "memory_trends": { "type": "object" },
              "memory_robust_steady_state": { "type": "object" },
              "quiescent_sample_phase": {
                "type": "object",
                "required": [
                  "repair_cache_ttl_seconds",
                  "quiescent_delay_seconds",
                  "cache_quiescence_timeout_seconds",
                  "target_sample_period_seconds",
                  "all_samples_after_cache_ttl",
                  "all_samples_cache_quiescent"
                ],
                "properties": {
                  "repair_cache_ttl_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "quiescent_delay_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 3
                  },
                  "cache_quiescence_timeout_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "target_sample_period_seconds": {
                    "type": "number",
                    "minimum": 1
                  },
                  "all_samples_after_cache_ttl": { "type": "boolean" },
                  "all_samples_cache_quiescent": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario": { "const": "soak" },
          "status": { "const": "pass" }
        },
        "required": ["scenario", "status"]
      },
      "then": {
        "properties": {
          "metrics": {
            "properties": {
              "configured_duration_seconds": { "minimum": 1800 },
              "rss_samples_complete": { "const": true },
              "quiescent_sample_phase": {
                "properties": {
                  "all_samples_after_cache_ttl": { "const": true },
                  "all_samples_cache_quiescent": { "const": true }
                },
                "required": [
                  "all_samples_after_cache_ttl",
                  "all_samples_cache_quiescent"
                ]
              },
              "baseline_measurement": {
                "properties": {
                  "complete": { "const": true },
                  "warmup": {
                    "properties": {
                      "valid_complete": { "const": true }
                    },
                    "required": ["valid_complete"]
                  }
                },
                "required": ["complete", "warmup"]
              }
            }
          }
        }
      }
    }
  ]
}
