@using XNetwork.Models
@using XNetwork.Utils
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<!-- Overall Connection Summary -->
<div class="@GetContainerClass()"
     role="@(ShowTrafficDetailsHint ? "button" : null)"
     tabindex="@(ShowTrafficDetailsHint ? "0" : null)"
     @onclick="HandleTrafficDetailsRequested"
     @onkeydown="HandleSummaryKeyDown">
    <div class="relative z-10 p-4 pb-5">
        <div class="flex items-center gap-3 mb-3">
            @{
                var (status, statusColor) = GetConnectionStatus();
                var barCount = GetSignalBarCount(status);
                var isInitializing = status.ToLowerInvariant().Contains("initializing");
            }
            <div class="flex items-end gap-0.5 w-10 h-6">
                @for (int i = 0; i < 4; i++)
                {
                    var isActive = i < barCount;
                    var heightClass = i switch
                    {
                        0 => "h-2",  // 25% height
                        1 => "h-3",  // 37.5% height
                        2 => "h-4",  // 50% height
                        3 => "h-6",  // 100% height
                        _ => "h-2"
                    };
                    var animationClass = isInitializing ? "animate-pulse" : "";
                    <div class="@heightClass w-1.5 rounded-sm @animationClass"
                         style="background-color: @(isActive ? GetBarColorHex(statusColor) : "#334155")"></div>
                }
            </div>
            <div class="flex-grow">
                <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-semibold text-lg text-white">@ConnectionStatus</h3>
                </div>
                <p class="mt-1 text-xs text-slate-400">@GetStatusDescription()</p>
                <div class="connection-summary-pills mt-2 flex flex-wrap items-center">
                    <span class="@GetPillSlotClass(!IsStable && !isInitializing)" aria-hidden="@(IsStable || isInitializing)">
                        <span class="connection-summary-pill connection-summary-pill-warning" title="Tunnel health is currently unstable">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>Unstable</span>
                        </span>
                    </span>
                    <span class="@GetPillSlotClass(!string.IsNullOrWhiteSpace(Mode))" aria-hidden="@string.IsNullOrWhiteSpace(Mode)">
                        <span class="connection-summary-pill connection-summary-pill-neutral" title="XBond redundancy policy">
                            <i class="fas fa-layer-group"></i>
                            <span>@Mode</span>
                        </span>
                    </span>
                    <span class="@GetPillSlotClass(IsProtectingFromLoss)" aria-hidden="@(!IsProtectingFromLoss)">
                        <span class="connection-summary-pill connection-summary-pill-good" title="@ProtectionReason">
                            <i class="fas fa-shield-alt"></i>
                            <span>Protecting from loss</span>
                        </span>
                    </span>
                    <span class="@GetPillSlotClass(IsRecoveryActive)" aria-hidden="@(!IsRecoveryActive)">
                        <span class="connection-summary-pill connection-summary-pill-warning" title="@RecoveryReason">
                            <i class="fas fa-heart-pulse"></i>
                            <span>Recovery @RecoveryHoldMs ms</span>
                        </span>
                    </span>
                    <span class="@GetPillSlotClass(ShowServerHealth)" aria-hidden="@(!ShowServerHealth)">
                        <span class="@GetServerHealthPillClass()" title="@ServerHealthDetails">
                            <i class="fas fa-cloud-arrow-up"></i>
                            <span>@ServerHealthLabel</span>
                        </span>
                    </span>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm sm:grid-cols-4">
            <div>
                <p class="text-slate-400" title="XBond tunnel heartbeat RTT to the Vultr endpoint.">Tunnel</p>
                <p class="text-white font-bold text-xl"><AnimatedNumber Value="@Latency" Decimals="0" AriaLabel="@($"{Latency} milliseconds")" /> <span class="text-base font-medium text-slate-300">ms</span></p>
            </div>
            <div>
                <p class="text-slate-400" title="Rolling ping to 8.8.8.8 through the current default route.">Internet</p>
                @if (InternetLatency.HasValue)
                {
                    <p class="text-white font-bold text-xl"><AnimatedNumber Value="@InternetLatency.Value" Decimals="0" AriaLabel="@($"{InternetLatency.Value} milliseconds internet latency")" /> <span class="text-base font-medium text-slate-300">ms</span></p>
                }
                else
                {
                    <p class="text-white font-bold text-xl">-- <span class="text-base font-medium text-slate-300">ms</span></p>
                }
            </div>
            <div>
                <p class="text-slate-400" title="Useful XBond tunnel payload after duplicates, probes, and control traffic are removed.">Download</p>
                <p class="text-white font-bold text-xl"><AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(Download)" Decimals="@SpeedFormatter.GetDisplayDecimals(Download)" AriaLabel="@SpeedFormatter.FormatSpeed(Download)" /> <span class="text-base font-medium text-slate-300">@SpeedFormatter.GetSpeedUnit(Download)</span></p>
            </div>
            <div>
                <p class="text-slate-400" title="Useful XBond tunnel payload after duplicates, probes, and control traffic are removed.">Upload</p>
                <p class="text-white font-bold text-xl"><AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(Upload)" Decimals="@SpeedFormatter.GetDisplayDecimals(Upload)" AriaLabel="@SpeedFormatter.FormatSpeed(Upload)" /> <span class="text-base font-medium text-slate-300">@SpeedFormatter.GetSpeedUnit(Upload)</span></p>
            </div>
        </div>
    </div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-24 opacity-90 sm:h-20">
        <canvas id="@_chartId" class="h-full w-full"></canvas>
    </div>
</div>

@code {
    private readonly string _chartId = $"dashboard-chart-{Guid.NewGuid():N}";

    [Parameter] public string ConnectionStatus { get; set; } = "Excellent Connection";
    [Parameter] public int Latency { get; set; } = 12;
    [Parameter] public int? InternetLatency { get; set; }
    [Parameter] public double Download { get; set; } = 85.3;
    [Parameter] public double Upload { get; set; } = 15.9;
    [Parameter] public double? AnchorDownload { get; set; }
    [Parameter] public double? BackupDownload { get; set; }
    [Parameter] public bool IsStable { get; set; } = true;
    [Parameter] public string? Mode { get; set; }
    [Parameter] public bool IsProtectingFromLoss { get; set; }
    [Parameter] public string? ProtectionReason { get; set; }
    [Parameter] public bool IsRecoveryActive { get; set; }
    [Parameter] public int RecoveryHoldMs { get; set; }
    [Parameter] public string? RecoveryReason { get; set; }
    [Parameter] public string? ServerHealthStatus { get; set; }
    [Parameter] public string? ServerHealthLabel { get; set; }
    [Parameter] public string? ServerHealthDetails { get; set; }
    [Parameter] public bool ShowTrafficDetailsHint { get; set; }
    [Parameter] public EventCallback OnTrafficDetailsRequested { get; set; }
    
    private IJSObjectReference? _chartModule;
    private bool _chartInitialized;
    private Timer? _chartUpdateTimer;
    private double _previousDownload = 0;
    private double? _previousAnchorDownload;
    private double? _previousBackupDownload;
    private int _sparklineUpdateInProgress;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_chartInitialized)
        {
            await InitializeChartAsync();
            _chartUpdateTimer = new Timer(async _ => await UpdateSparkline(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        
        if (_chartInitialized && HasSparklineValuesChanged())
        {
            await UpdateSparkline();
        }
    }

    private bool HasSparklineValuesChanged()
    {
        return Math.Abs(Download - _previousDownload) > 0.01 ||
               HasNullableValueChanged(AnchorDownload, _previousAnchorDownload) ||
               HasNullableValueChanged(BackupDownload, _previousBackupDownload);
    }

    private static bool HasNullableValueChanged(double? current, double? previous)
    {
        if (current.HasValue != previous.HasValue)
        {
            return true;
        }

        return current.HasValue && Math.Abs(current.Value - previous!.Value) > 0.01;
    }

    private async Task UpdateSparkline()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(UpdateSparklineCoreAsync);
        }
        catch (InvalidOperationException)
        {
            // The renderer can be unavailable during route-transition disposal.
        }
    }

    private async Task InitializeChartAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            _chartModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/statisticsCharts.js");
            _chartInitialized = await _chartModule.InvokeAsync<bool>("initializeDashboardSparkline", _chartId);
            if (_chartInitialized)
            {
                await UpdateSparklineCoreAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ConnectionSummary: Error initializing chart: {ex.Message}");
        }
    }

    private async Task UpdateSparklineCoreAsync()
    {
        if (_chartModule == null || !_chartInitialized)
        {
            return;
        }

        if (Interlocked.Exchange(ref _sparklineUpdateInProgress, 1) == 1)
        {
            return;
        }

        try
        {
            var updated = await _chartModule.InvokeAsync<bool>(
                "updateDashboardSparkline",
                _chartId,
                Download,
                AnchorDownload,
                BackupDownload);

            if (!updated)
            {
                _chartInitialized = false;
                await InitializeChartAsync();
                return;
            }

            _previousDownload = Download;
            _previousAnchorDownload = AnchorDownload;
            _previousBackupDownload = BackupDownload;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ConnectionSummary: Error updating sparkline: {ex.Message}");
        }
        finally
        {
            Interlocked.Exchange(ref _sparklineUpdateInProgress, 0);
        }
    }

    private (string status, string color) GetConnectionStatus()
    {
        var status = ConnectionStatus.ToLowerInvariant();
        var color = status switch
        {
            var s when s.Contains("initializing") => "cyan-400",
            var s when s.Contains("excellent") => "green-400",
            var s when s.Contains("good") => "cyan-400",
            var s when s.Contains("fair") => "yellow-400",
            var s when s.Contains("partial") => "orange-400",
            var s when s.Contains("poor") => "red-400",
            var s when s.Contains("disconnected") || s.Contains("no connection") => "red-500",
            _ => "slate-400"
        };
        return (ConnectionStatus, color);
    }

    private string GetContainerClass()
    {
        var interactiveClass = ShowTrafficDetailsHint
            ? "cursor-pointer hover:border-cyan-500/50 hover:bg-slate-800/70 focus:outline-none focus:ring-2 focus:ring-cyan-500/60 transition-colors"
            : "";

        return $"relative isolate bg-slate-800/50 border border-slate-700 rounded-xl shadow-lg mb-6 overflow-hidden {interactiveClass}";
    }

    private bool ShowServerHealth =>
        !string.IsNullOrWhiteSpace(ServerHealthStatus) &&
        !string.Equals(ServerHealthStatus, "healthy", StringComparison.OrdinalIgnoreCase);

    private string GetServerHealthPillClass()
    {
        var stateClass = ServerHealthStatus?.ToLowerInvariant() switch
        {
            "degraded" => "connection-summary-pill-warning",
            "down" => "connection-summary-pill-danger",
            _ => "connection-summary-pill-neutral"
        };

        return $"connection-summary-pill {stateClass}";
    }

    private static string GetPillSlotClass(bool visible) =>
        $"connection-summary-pill-slot{(visible ? " connection-summary-pill-slot-visible" : string.Empty)}";

    private async Task HandleTrafficDetailsRequested()
    {
        if (ShowTrafficDetailsHint && OnTrafficDetailsRequested.HasDelegate)
        {
            await OnTrafficDetailsRequested.InvokeAsync();
        }
    }

    private async Task HandleSummaryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            await HandleTrafficDetailsRequested();
        }
    }

    private int GetSignalBarCount(string status)
    {
        return status.ToLowerInvariant() switch
        {
            var s when s.Contains("initializing") => 2,  // 2 bars while loading
            var s when s.Contains("excellent") => 4,     // All 4 bars
            var s when s.Contains("good") => 3,          // 3 bars
            var s when s.Contains("fair") => 2,          // 2 bars
            var s when s.Contains("partial") => 1,       // 1 bar
            var s when s.Contains("poor") => 1,          // 1 bar - Poor (red)
            _ => 0  // Disconnected or No Connection - 0 bars
        };
    }

    private string GetBarColorHex(string color)
    {
        return color switch
        {
            "green-400" => "#86efac",
            "cyan-400" => "#86efac",
            "yellow-400" => "#fde68a",
            "orange-400" => "#fdba74",
            "red-400" => "#fca5a5",
            "red-500" => "#fca5a5",
            "slate-400" => "#a3a3a3",
            _ => "#525252"
        };
    }

    private string GetStatusDescription()
    {
        var status = ConnectionStatus.ToLowerInvariant();
        
        // Initializing state
        if (status.Contains("initializing"))
        {
            return "Gathering connection data...";
        }
        
        // Disconnected state
        if (status.Contains("disconnected") || status.Contains("no connection"))
        {
            return "No active connection detected";
        }
        
        // Health-based descriptions with context
        if (status.Contains("excellent"))
        {
            return $"Low latency ({Latency}ms), optimal performance";
        }
        
        if (status.Contains("good"))
        {
            return $"Normal latency ({Latency}ms), stable connection";
        }
        
        if (status.Contains("fair"))
        {
            if (Latency > 250)
            {
                return $"Elevated latency ({Latency}ms) may affect real-time apps";
            }
            return "Moderate performance, some fluctuation detected";
        }
        
        if (status.Contains("partial"))
        {
            return "Limited connectivity detected";
        }
        
        if (status.Contains("poor"))
        {
            return $"High latency ({Latency}ms) impacting performance";
        }
        
        if (status.Contains("critical"))
        {
            return "Severe connection issues detected";
        }
        
        // Default fallback
        return "Monitoring connection quality";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (_chartUpdateTimer != null)
        {
            await _chartUpdateTimer.DisposeAsync();
        }
        
        if (_chartModule != null)
        {
            try
            {
                if (_chartInitialized)
                {
                    await _chartModule.InvokeVoidAsync("disposeChart", _chartId);
                }
                await _chartModule.DisposeAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ConnectionSummary: Error disposing chart: {ex.Message}");
            }
        }
    }
}
