@inject IJSRuntime JSRuntime

@if (_isRendered)
{
    <div class="@GetBackdropClass()" @onclick="CloseAsync">
        <section class="@GetPanelClass()" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="@_titleId">
            <header class="action-sheet-header">
                <div class="min-w-0">
                    <h3 id="@_titleId" class="action-sheet-title">@Title</h3>
                    @if (!string.IsNullOrWhiteSpace(Description))
                    {
                        <p class="action-sheet-description">@Description</p>
                    }
                </div>
                <button type="button" class="action-sheet-close" @onclick="CloseAsync" aria-label="@CloseLabel">
                    <i class="fas fa-times"></i>
                </button>
            </header>

            <div class="@GetBodyClass()">
                @ChildContent
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string CloseLabel { get; set; } = "Close";
    [Parameter] public string MaxWidthClass { get; set; } = "md:max-w-3xl";
    [Parameter] public string BackdropClass { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string BodyClass { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _titleId = $"action-sheet-title-{Guid.NewGuid():N}";
    private bool _isRendered;
    private bool _isClosing;
    private int _transitionVersion;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            _transitionVersion++;
            _isRendered = true;
            _isClosing = false;
            return;
        }

        if (_isRendered && !_isClosing)
        {
            _isClosing = true;
            var transitionVersion = ++_transitionVersion;
            _ = CompleteCloseAsync(transitionVersion);
        }
    }

    private async Task CloseAsync()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    private string GetPanelClass()
    {
        var transitionClass = _isClosing ? "action-sheet-panel-closing" : "action-sheet-panel-opening";
        return $"action-sheet-panel {transitionClass} {MaxWidthClass} {CssClass}".Trim();
    }

    private string GetBackdropClass()
    {
        var transitionClass = _isClosing ? "action-sheet-backdrop-closing" : "action-sheet-backdrop-opening";
        return $"action-sheet-backdrop {transitionClass} {BackdropClass}".Trim();
    }

    private string GetBodyClass()
    {
        return $"action-sheet-body {BodyClass}".Trim();
    }

    private async Task CompleteCloseAsync(int transitionVersion)
    {
        var delay = 240;

        try
        {
            var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/animatedUi.js");
            if (await module.InvokeAsync<bool>("prefersReducedMotion"))
            {
                delay = 0;
            }

            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            delay = 0;
        }

        if (delay > 0)
        {
            await Task.Delay(delay);
        }

        await InvokeAsync(() =>
        {
            if (transitionVersion != _transitionVersion || IsOpen)
            {
                return;
            }

            _isRendered = false;
            _isClosing = false;
            StateHasChanged();
        });
    }
}
