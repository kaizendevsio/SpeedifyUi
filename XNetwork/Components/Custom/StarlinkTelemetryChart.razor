@using System.Globalization
@using Microsoft.JSInterop
@using XNetwork.Models
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="bg-slate-800/50 border border-slate-700 rounded-xl shadow-lg overflow-hidden">
    <div class="p-4">
        <div class="flex items-start justify-between gap-3">
            <div>
                <h3 class="font-semibold text-white">@Title</h3>
                <p class="mt-1 text-lg font-semibold @ValueClass">@FormatValue(LatestValue)</p>
            </div>
            <span class="text-[11px] text-slate-500">@PointCount points</span>
        </div>
    </div>
    <div class="h-44 w-full px-2 pb-3">
        <canvas id="@_chartId" aria-label="@Title chart"></canvas>
    </div>
</div>

@code {
    private readonly string _chartId = $"starlink-chart-{Guid.NewGuid():N}";
    private IJSObjectReference? _chartModule;
    private int _lastRenderedHash;
    private bool _chartInitialized;

    [Parameter] public IReadOnlyList<StarlinkTelemetrySnapshot> Samples { get; set; } = Array.Empty<StarlinkTelemetrySnapshot>();
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Metric { get; set; } = string.Empty;
    [Parameter] public string Unit { get; set; } = string.Empty;
    [Parameter] public string Stroke { get; set; } = "#22d3ee";

    private IReadOnlyList<double> Values => Samples
        .Select(GetMetricValue)
        .Where(value => value is not null && !double.IsNaN(value.Value) && !double.IsInfinity(value.Value))
        .Select(value => value!.Value)
        .ToList();

    private int PointCount => Values.Count;

    private double? LatestValue
    {
        get
        {
            var values = Values;
            return values.Count > 0 ? values[^1] : null;
        }
    }

    private string ValueClass => Metric switch
    {
        "download" => "text-cyan-200",
        "upload" => "text-pink-200",
        "obstruction" => "text-amber-200",
        _ => "text-white"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await RenderChartAsync();
    }

    private async Task RenderChartAsync()
    {
        var values = Values;
        var renderHash = HashCode.Combine(Samples.Count, LatestValue, Title, Metric, Unit);
        if (_chartInitialized && renderHash == _lastRenderedHash)
        {
            return;
        }

        try
        {
            _chartModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/statisticsCharts.js");

            if (!_chartInitialized)
            {
                _chartInitialized = await _chartModule.InvokeAsync<bool>(
                    "initializeOrUpdateSingleSeriesChart",
                    _chartId,
                    FormatYAxisLabel(),
                    Title,
                    Stroke);
            }

            if (_chartInitialized)
            {
                await _chartModule.InvokeVoidAsync(
                    "setSingleSeriesChartData",
                    _chartId,
                    BuildLabels(),
                    values);

                _lastRenderedHash = renderHash;
            }
        }
        catch (JSDisconnectedException)
        {
            // The dashboard can be torn down during a Blazor reconnect.
        }
    }

    private string FormatYAxisLabel()
    {
        return string.IsNullOrWhiteSpace(Unit)
            ? Title
            : $"{Title} ({Unit})";
    }

    private IReadOnlyList<string> BuildLabels()
    {
        return Samples
            .Where(sample => GetMetricValue(sample) is not null)
            .Select(sample => sample.LastUpdatedUtc?.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture) ?? string.Empty)
            .ToList();
    }

    private double? GetMetricValue(StarlinkTelemetrySnapshot sample)
    {
        return Metric switch
        {
            "latency" => sample.PopPingLatencyMs,
            "download" => sample.DownlinkMbps,
            "upload" => sample.UplinkMbps,
            "obstruction" => sample.ObstructionPercent,
            "alignment" => sample.AlignmentErrorDegrees,
            _ => null
        };
    }

    private string FormatValue(double? value)
    {
        if (value is null)
        {
            return "--";
        }

        var rawValue = value.Value;
        var rounded = rawValue < 1
            ? Math.Round(rawValue, 2)
            : rawValue < 10
                ? Math.Round(rawValue, 1)
                : Math.Round(rawValue);

        return string.IsNullOrWhiteSpace(Unit)
            ? rounded.ToString(CultureInfo.InvariantCulture)
            : $"{rounded.ToString(CultureInfo.InvariantCulture)} {Unit}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_chartModule is null)
        {
            return;
        }

        try
        {
            await _chartModule.InvokeVoidAsync("disposeChart", _chartId);
            await _chartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Safe during reconnect/navigation disposal.
        }
    }
}
