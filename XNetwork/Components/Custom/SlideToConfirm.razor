<div class="@GetRootClass()" style="@GetStyle()" aria-busy="@IsBusy">
    <div class="slide-confirm-track">
        <span class="slide-confirm-fill"></span>
        <span class="slide-confirm-label">
            @if (IsBusy)
            {
                <i class="fas fa-spinner animate-spin text-xs"></i>
                <span>@BusyLabel</span>
            }
            else
            {
                <i class="fas @IconClass text-xs"></i>
                <span>@Label</span>
            }
        </span>
        <input type="range"
               min="0"
               max="100"
               step="1"
               value="@_progress"
               disabled="@(Disabled || IsBusy)"
               aria-label="@Label"
               @oninput="HandleInputAsync"
               @onchange="HandleChange" />
    </div>
</div>

<style>
    .slide-confirm {
        --slide-progress: 0%;
        --slide-fill: rgba(34, 211, 238, 0.18);
        --slide-border: rgba(34, 211, 238, 0.32);
        --slide-thumb: #22d3ee;
        position: relative;
        width: 100%;
    }

    .slide-confirm-track {
        position: relative;
        height: 3.25rem;
        overflow: hidden;
        border: 1px solid var(--slide-border);
        border-radius: 0.875rem;
        background: rgba(15, 23, 42, 0.82);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
        touch-action: pan-y;
        user-select: none;
    }

    .slide-confirm-fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--slide-progress);
        border-radius: inherit;
        background: var(--slide-fill);
        transition: width 120ms ease;
    }

    .slide-confirm-label {
        position: absolute;
        inset: 0 3.75rem 0 3.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: #e2e8f0;
        font-size: 0.875rem;
        font-weight: 700;
        pointer-events: none;
        text-align: center;
    }

    .slide-confirm input[type="range"] {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 2;
        appearance: none;
        background: transparent;
        cursor: grab;
    }

    .slide-confirm input[type="range"]:active {
        cursor: grabbing;
    }

    .slide-confirm input[type="range"]::-webkit-slider-runnable-track {
        height: 3.25rem;
        background: transparent;
    }

    .slide-confirm input[type="range"]::-webkit-slider-thumb {
        appearance: none;
        width: 2.5rem;
        height: 2.5rem;
        margin-top: 0.375rem;
        border: 0;
        border-radius: 0.75rem;
        background: var(--slide-thumb);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.24);
    }

    .slide-confirm input[type="range"]::-moz-range-track {
        height: 3.25rem;
        background: transparent;
        border: 0;
    }

    .slide-confirm input[type="range"]::-moz-range-thumb {
        width: 2.5rem;
        height: 2.5rem;
        border: 0;
        border-radius: 0.75rem;
        background: var(--slide-thumb);
        box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.24);
    }

    .slide-confirm-danger {
        --slide-fill: rgba(239, 68, 68, 0.22);
        --slide-border: rgba(248, 113, 113, 0.38);
        --slide-thumb: #f87171;
    }

    .slide-confirm-warning {
        --slide-fill: rgba(245, 158, 11, 0.2);
        --slide-border: rgba(251, 191, 36, 0.36);
        --slide-thumb: #fbbf24;
    }

    .slide-confirm-info {
        --slide-fill: rgba(34, 211, 238, 0.18);
        --slide-border: rgba(34, 211, 238, 0.32);
        --slide-thumb: #22d3ee;
    }

    .slide-confirm-disabled {
        opacity: 0.55;
    }

    .slide-confirm-disabled input[type="range"] {
        cursor: not-allowed;
    }
</style>

@code {
    private const int ConfirmThreshold = 96;
    private int _progress;
    private bool _confirmed;

    [Parameter] public string Label { get; set; } = "Slide to confirm";

    [Parameter] public string BusyLabel { get; set; } = "Running...";

    [Parameter] public string IconClass { get; set; } = "fa-arrow-right";

    [Parameter] public string Tone { get; set; } = "info";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool IsBusy { get; set; }

    [Parameter] public EventCallback OnConfirmed { get; set; }

    protected override void OnParametersSet()
    {
        if (!IsBusy && _confirmed)
        {
            Reset();
        }
    }

    private async Task HandleInputAsync(ChangeEventArgs args)
    {
        if (Disabled || IsBusy || _confirmed)
        {
            return;
        }

        _progress = ParseProgress(args.Value);
        if (_progress < ConfirmThreshold)
        {
            return;
        }

        _progress = 100;
        _confirmed = true;
        if (OnConfirmed.HasDelegate)
        {
            await OnConfirmed.InvokeAsync();
        }
    }

    private void HandleChange(ChangeEventArgs args)
    {
        if (!_confirmed)
        {
            Reset();
        }
    }

    private void Reset()
    {
        _progress = 0;
        _confirmed = false;
    }

    private static int ParseProgress(object? value)
    {
        return int.TryParse(value?.ToString(), out var progress)
            ? Math.Clamp(progress, 0, 100)
            : 0;
    }

    private string GetRootClass()
    {
        var tone = Tone.Trim().ToLowerInvariant() switch
        {
            "danger" => "slide-confirm-danger",
            "warning" => "slide-confirm-warning",
            _ => "slide-confirm-info"
        };

        var disabled = Disabled || IsBusy ? " slide-confirm-disabled" : string.Empty;
        return $"slide-confirm {tone}{disabled}";
    }

    private string GetStyle()
    {
        return $"--slide-progress: {_progress}%;";
    }
}
