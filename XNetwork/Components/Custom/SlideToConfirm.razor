@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="@GetRootClass()" style="@GetStyle()" aria-busy="@IsBusy">
    <div id="@_trackId"
         class="slide-confirm-track"
         @onpointermove="HandlePointerMoveAsync"
         @onpointerup="HandlePointerEndAsync"
         @onpointercancel="HandlePointerEndAsync">
        <span class="slide-confirm-fill"></span>
        <span class="slide-confirm-label">
            @if (IsBusy)
            {
                <i class="fas fa-spinner animate-spin text-xs"></i>
                <span>@BusyLabel</span>
            }
            else
            {
                <span>@Label</span>
                <i class="fas fa-angles-right slide-confirm-chevrons"></i>
            }
        </span>
        <button id="@_handleId"
                type="button"
                class="slide-confirm-thumb"
                style="@GetThumbStyle()"
                disabled="@(Disabled || IsBusy)"
                aria-label="@Label"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="@_progress"
                @onpointerdown="HandlePointerStartAsync"
                @onpointerdown:stopPropagation="true"
                @onkeydown="HandleKeyDownAsync">
            <i class="fas @IconClass text-xs"></i>
        </button>
    </div>
</div>

<style>
    .slide-confirm {
        --slide-progress: 0%;
        --slide-fill: linear-gradient(90deg, rgba(34, 211, 238, 0.2), rgba(34, 211, 238, 0.08));
        --slide-border: rgba(34, 211, 238, 0.26);
        --slide-thumb: #22d3ee;
        position: relative;
        width: 100%;
    }

    .slide-confirm-track {
        position: relative;
        height: 2.75rem;
        overflow: hidden;
        border: 1px solid var(--slide-border);
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.72);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
        touch-action: pan-y;
        user-select: none;
    }

    .slide-confirm-fill {
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--slide-progress);
        border-radius: inherit;
        background: var(--slide-fill);
        transition: width 120ms ease;
    }

    .slide-confirm-label {
        position: absolute;
        inset: 0 3.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        color: #e2e8f0;
        font-size: 0.8125rem;
        font-weight: 700;
        letter-spacing: 0;
        pointer-events: none;
        text-align: center;
    }

    .slide-confirm-chevrons {
        color: color-mix(in srgb, var(--slide-thumb), white 16%);
        font-size: 0.6875rem;
    }

    .slide-confirm-thumb {
        position: absolute;
        top: 0.275rem;
        z-index: 2;
        display: inline-flex;
        width: 2.2rem;
        height: 2.2rem;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 999px;
        background: var(--slide-thumb);
        color: #020617;
        box-shadow: 0 0.45rem 1rem rgba(0, 0, 0, 0.28);
        cursor: grab;
        transition: left 120ms ease, transform 120ms ease;
    }

    .slide-confirm-dragging .slide-confirm-thumb {
        cursor: grabbing;
        transition: none;
    }

    .slide-confirm-dragging .slide-confirm-fill {
        transition: none;
    }

    .slide-confirm-thumb:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--slide-thumb), white 24%);
        outline-offset: 3px;
    }

    .slide-confirm-danger {
        --slide-fill: linear-gradient(90deg, rgba(248, 113, 113, 0.24), rgba(248, 113, 113, 0.08));
        --slide-border: rgba(248, 113, 113, 0.3);
        --slide-thumb: #f87171;
    }

    .slide-confirm-warning {
        --slide-fill: linear-gradient(90deg, rgba(251, 191, 36, 0.24), rgba(251, 191, 36, 0.08));
        --slide-border: rgba(251, 191, 36, 0.3);
        --slide-thumb: #fbbf24;
    }

    .slide-confirm-info {
        --slide-fill: linear-gradient(90deg, rgba(34, 211, 238, 0.2), rgba(34, 211, 238, 0.08));
        --slide-border: rgba(34, 211, 238, 0.26);
        --slide-thumb: #22d3ee;
    }

    .slide-confirm-disabled {
        opacity: 0.55;
    }

    .slide-confirm-disabled .slide-confirm-thumb {
        cursor: not-allowed;
    }
</style>

@code {
    private const int ConfirmThreshold = 96;
    private readonly string _trackId = $"slide-confirm-track-{Guid.NewGuid():N}";
    private readonly string _handleId = $"slide-confirm-handle-{Guid.NewGuid():N}";
    private int _progress;
    private bool _confirmed;
    private bool _dragging;
    private double _dragStartX;
    private int _dragStartProgress;
    private double _dragTravelPx = 1;
    private IJSObjectReference? _module;

    [Parameter] public string Label { get; set; } = "Slide to confirm";

    [Parameter] public string BusyLabel { get; set; } = "Running...";

    [Parameter] public string IconClass { get; set; } = "fa-arrow-right";

    [Parameter] public string Tone { get; set; } = "info";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool IsBusy { get; set; }

    [Parameter] public EventCallback OnConfirmed { get; set; }

    protected override void OnParametersSet()
    {
        if (!IsBusy && _confirmed)
        {
            Reset();
        }
    }

    private async Task HandlePointerStartAsync(PointerEventArgs args)
    {
        if (Disabled || IsBusy || _confirmed)
        {
            return;
        }

        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/slideToConfirm.js");
        var metrics = await _module.InvokeAsync<SlideConfirmMetrics>("getSlideConfirmMetrics", _trackId, _handleId);

        _dragging = true;
        _dragStartX = args.ClientX;
        _dragStartProgress = _progress;
        _dragTravelPx = Math.Max(1, metrics.TrackWidth - metrics.ThumbWidth);

        await _module.InvokeVoidAsync("captureSlideConfirmPointer", _handleId, args.PointerId);
    }

    private async Task HandlePointerMoveAsync(PointerEventArgs args)
    {
        if (!_dragging || Disabled || IsBusy || _confirmed)
        {
            return;
        }

        var delta = args.ClientX - _dragStartX;
        var progress = _dragStartProgress + (int)Math.Round(delta / _dragTravelPx * 100);
        _progress = Math.Clamp(progress, 0, 100);

        if (_progress >= ConfirmThreshold)
        {
            await ConfirmAsync();
        }
    }

    private async Task HandlePointerEndAsync(PointerEventArgs args)
    {
        if (!_dragging)
        {
            return;
        }

        _dragging = false;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("releaseSlideConfirmPointer", _handleId, args.PointerId);
        }

        if (!_confirmed)
        {
            Reset();
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (Disabled || IsBusy || _confirmed)
        {
            return;
        }

        switch (args.Key)
        {
            case "ArrowRight":
            case "PageUp":
                _progress = Math.Clamp(_progress + 12, 0, 100);
                if (_progress >= ConfirmThreshold)
                {
                    await ConfirmAsync();
                }
                break;
            case "ArrowLeft":
            case "PageDown":
                _progress = Math.Clamp(_progress - 12, 0, 100);
                break;
            case "Home":
            case "Escape":
                Reset();
                break;
            case "End":
                _progress = 100;
                await ConfirmAsync();
                break;
        }
    }

    private async Task ConfirmAsync()
    {
        _progress = 100;
        _confirmed = true;
        _dragging = false;
        if (OnConfirmed.HasDelegate)
        {
            await OnConfirmed.InvokeAsync();
        }
    }

    private void Reset()
    {
        _progress = 0;
        _confirmed = false;
        _dragging = false;
    }

    private string GetRootClass()
    {
        var tone = Tone.Trim().ToLowerInvariant() switch
        {
            "danger" => "slide-confirm-danger",
            "warning" => "slide-confirm-warning",
            _ => "slide-confirm-info"
        };

        var disabled = Disabled || IsBusy ? " slide-confirm-disabled" : string.Empty;
        var dragging = _dragging ? " slide-confirm-dragging" : string.Empty;
        return $"slide-confirm {tone}{disabled}{dragging}";
    }

    private string GetStyle()
    {
        return $"--slide-progress: {_progress.ToString(CultureInfo.InvariantCulture)}%;";
    }

    private string GetThumbStyle()
    {
        var progress = _progress.ToString(CultureInfo.InvariantCulture);
        return $"left: {progress}%; transform: translateX(-{progress}%);";
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Safe during reconnect/navigation disposal.
        }
    }

    private sealed class SlideConfirmMetrics
    {
        public double TrackWidth { get; set; }

        public double ThumbWidth { get; set; }
    }
}
