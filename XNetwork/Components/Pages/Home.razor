    private async Task RefreshStarlinkAdapterDetectionAsync(IReadOnlyList<Adapter> adapters)
    {
        if (!StarlinkTelemetrySettings.Enabled ||
            !StarlinkTelemetrySettings.AdapterProbeEnabled ||
            Interlocked.Exchange(ref _starlinkAdapterProbeInProgress, 1) == 1)
        {
            return;
        }

        try
        {
            var now = DateTime.UtcNow;
            if (now - _lastStarlinkAdapterProbeUtc < StarlinkTelemetrySettings.AdapterProbeInterval)
            {
                return;
            }

            _lastStarlinkAdapterProbeUtc = now;

            var activeAdapterIds = adapters
                .Select(a => a.AdapterId)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            foreach (var staleAdapterId in _starlinkAdapterProbeCache.Keys.Where(id => !activeAdapterIds.Contains(id)).ToList())
            {
                _starlinkAdapterProbeCache.Remove(staleAdapterId);
            }

            foreach (var adapter in adapters.Where(a => !IsAdapterOffline(a)))
            {
                if (StarlinkAdapterDetector.HasStarlinkMetadata(adapter, StarlinkTelemetrySettings.AdapterNameHints))
                {
                    _starlinkAdapterProbeCache[adapter.AdapterId] = true;
                    continue;
                }

                var gateway = _gatewayCache.GetValueOrDefault(adapter.AdapterId);
                if (StarlinkAdapterDetector.MatchesManagementGateway(gateway, StarlinkTelemetrySettings.Host))
                {
                    _starlinkAdapterProbeCache[adapter.AdapterId] = true;
                    continue;
                }

                _starlinkAdapterProbeCache[adapter.AdapterId] =
                    await NetworkMonitorService.CanReachHttpHostViaInterfaceAsync(
                        adapter.Name,
                        StarlinkTelemetrySettings.Host,
                        port: 80,
                        timeout: StarlinkTelemetrySettings.RequestTimeout);
            }
        }
        finally
        {
            Interlocked.Exchange(ref _starlinkAdapterProbeInProgress, 0);
        }
    }

