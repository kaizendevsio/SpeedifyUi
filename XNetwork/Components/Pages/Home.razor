    private string GetBondingModeLabel()
    {
        var mode = NormalizeTransportMode(_speedifySettings?.BondingMode);
        return mode switch
        {
            "redundant" => $"Redundant x{Math.Max(1, _speedifySettings?.MaxRedundant ?? 1)}",
            "streaming" => "Streaming",
            "speed" => "Speed",
            _ => "Mode unknown"
        };
    }

    private string? GetActualTransportProtocol()
    {
        var protocol = _stats
            .Where(s => s.Connected)
            .Where(s => !IsSpeedifyAggregate(s))
            .Where(s => !IsAuxiliaryConnection(s))
            .Select(s => NormalizeTransportMode(s.Protocol))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Where(s => s is not "auto" and not "proxy" and not "share")
            .GroupBy(s => s)
            .OrderByDescending(g => g.Count())
            .ThenByDescending(g => _stats
                .Where(s => NormalizeTransportMode(s.Protocol) == g.Key)
                .Sum(s => s.ReceiveBps + s.SendBps))
            .FirstOrDefault()
            ?.Key;

        return string.IsNullOrWhiteSpace(protocol) ? null : protocol;
    }

    private static bool IsAuxiliaryConnection(ConnectionItem stat)
    {
        return stat.ConnectionId.Contains("%proxy", StringComparison.OrdinalIgnoreCase) ||
               stat.ConnectionId.Contains("%share", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TransportModesMatch(string configured, string actual)
    {
        if (configured == actual)
        {
            return true;
        }

        return configured == "tcp-multi" && actual == "tcp";
    }

    private static string NormalizeTransportMode(string? mode)
    {
        return string.IsNullOrWhiteSpace(mode)
            ? ""
            : mode.Trim().ToLowerInvariant();
    }

    private static string FormatTransportMode(string? mode)
    {
        return NormalizeTransportMode(mode) switch
        {
            "tcp-multi" => "TCP Multi",
            "tcp" => "TCP",
            "udp" => "UDP",
            "https" => "HTTPS",
            "auto" => "Auto",
            _ => "Unknown"
        };
    }

    private static string FormatProcessDetail(LocalProcessTrafficItem process)
