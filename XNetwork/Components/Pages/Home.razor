@page "/"
@using XNetwork.Models
@using XNetwork.Services
@using XNetwork.Utils
@implements IAsyncDisposable
@inject XBondSnapshotCache XBondSnapshotCache
@inject IStarlinkTelemetryService StarlinkTelemetryService

<PageTitle>XNetwork</PageTitle>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-5 px-4 pb-28 pt-4 md:px-6 md:pb-10">
    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5 shadow-xl shadow-slate-950/20">
        <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <h2 class="text-xl font-bold text-white">XBond Tunnel</h2>
                    <span class="@StatePillClass">@StateLabel</span>
                </div>
                <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-400">
                    <span><i class="fas fa-server mr-1 text-cyan-300"></i>@(_snapshot?.ServerAddress ?? "No server")</span>
                    <span><i class="fas fa-network-wired mr-1 text-emerald-300"></i>@(_snapshot?.TunnelDevice ?? "xbond0")</span>
                    <span><i class="fas fa-layer-group mr-1 text-teal-300"></i>@FormatMode(_snapshot?.Mode)</span>
                </div>
            </div>
            <button type="button"
                    class="rounded-lg border border-slate-700/80 bg-slate-950/60 px-3 py-2 text-sm font-semibold text-slate-200 transition hover:border-cyan-500/50 hover:text-white"
                    @onclick="RefreshAsync">
                <i class="fas fa-rotate mr-2"></i>Refresh
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_snapshot?.Error))
        {
            <p class="mt-4 rounded-md border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-sm text-rose-100">@_snapshot.Error</p>
        }
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="flex items-center justify-between gap-3">
            <div>
                <h2 class="text-2xl font-bold text-white">@ConnectionTitle</h2>
                <p class="mt-1 text-sm text-slate-400">@ConnectionSubtitle</p>
            </div>
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-cyan-500/10 text-cyan-300">
                <i class="fas fa-signal text-2xl"></i>
            </div>
        </div>

        <div class="mt-5 grid grid-cols-3 gap-3">
            @Metric("Latency", FormatLatency(_snapshot?.AverageRttMs))
            @Metric("Download", SpeedFormatter.FormatSpeed(_snapshot?.DownloadMbps ?? 0))
            @Metric("Upload", SpeedFormatter.FormatSpeed(_snapshot?.UploadMbps ?? 0))
        </div>
    </section>

    @if (_starlink.IsAvailable)
    {
        <section class="rounded-lg border border-cyan-500/20 bg-slate-900/75 p-4">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h3 class="font-semibold text-white">Starlink Telemetry</h3>
                    <p class="mt-1 text-sm text-slate-400">
                        Dish @FormatLatency(_starlink.PopPingLatencyMs), obstruction @FormatPercent(_starlink.ObstructionPercent), alignment @FormatDegrees(_starlink.AlignmentErrorDegrees)
                    </p>
                </div>
                <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200">Live</span>
            </div>
        </section>
    }

    <section>
        <div class="mb-3 flex items-center gap-3">
            <h2 class="text-2xl font-bold text-white">Adapters</h2>
            <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-sm font-semibold text-emerald-300">
                @((_snapshot?.DashboardPaths.Count(path => path.InterfaceUp)).GetValueOrDefault()) live
            </span>
        </div>

        @if (_snapshot is null)
        {
            <div class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5 text-slate-400">Loading XBond paths...</div>
        }
        else
        {
            @if (_snapshot.ActivePaths.Count > 0)
            {
                <div class="mb-4 rounded-lg border border-cyan-500/25 bg-cyan-500/[0.06] p-3">
                    <div class="mb-3 flex items-center gap-2 px-1">
                        <i class="fas fa-shield-halved text-cyan-300"></i>
                        <h3 class="font-semibold text-white">Actively Redundant</h3>
                    </div>
                    <div class="grid gap-3">
                        @foreach (var path in _snapshot.ActivePaths)
                        {
                            @PathCard(path)
                        }
                    </div>
                </div>
            }

            @if (_snapshot.StandbyPaths.Count > 0)
            {
                <div class="grid gap-3">
                    @foreach (var path in _snapshot.StandbyPaths)
                    {
                        @PathCard(path)
                    }
                </div>
            }
        }
    </section>
</div>

@code {
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(1));
    private readonly CancellationTokenSource _refreshCts = new();
    private XBondStatsSnapshot? _snapshot;
    private StarlinkTelemetrySnapshot _starlink = StarlinkTelemetrySnapshot.Unavailable();

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        _snapshot = await XBondSnapshotCache.GetSnapshotAsync(_refreshCts.Token);
        _starlink = StarlinkTelemetryService.GetSnapshot();
        StateHasChanged();
    }

    private string StateLabel => _snapshot switch
    {
        null => "Loading",
        { HasError: true } => "Needs attention",
        { IsRunning: true } => "XBond active",
        _ => "Stopped"
    };

    private string StatePillClass => _snapshot switch
    {
        null => "rounded-full border border-slate-600 bg-slate-700/40 px-2.5 py-1 text-xs font-semibold text-slate-200",
        { HasError: true } => "rounded-full border border-rose-500/30 bg-rose-500/10 px-2.5 py-1 text-xs font-semibold text-rose-200",
        { IsRunning: true } => "rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200",
        _ => "rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-200"
    };

    private string ConnectionTitle => _snapshot switch
    {
        null => "Checking XBond",
        { HasError: true } => "Status Unavailable",
        { IsRunning: true, MaxLossPercent: <= 1, AverageRttMs: <= 100 } => "Good Connection",
        { IsRunning: true } => "Degraded Connection",
        _ => "Tunnel Stopped"
    };

    private string ConnectionSubtitle => _snapshot switch
    {
        null => "Reading XBond runtime status.",
        { HasError: true } => "XBond status could not be read.",
        { IsRunning: true } => $"{_snapshot.ActivePaths.Count} active path(s), {_snapshot.StandbyPaths.Count} standby path(s).",
        _ => _snapshot.Message
    };

    private static RenderFragment Metric(string label, string value) => @<div>
        <p class="text-sm text-slate-400">@label</p>
        <p class="mt-1 text-2xl font-bold text-white">@value</p>
    </div>;

    private static RenderFragment PathCard(XBondPathStatsSnapshot path) => @<article class="rounded-lg border border-slate-700/70 bg-slate-900/85 p-4">
        <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <h3 class="truncate text-lg font-semibold text-white">@path.Name</h3>
                    <span class="@RoleClass(path)">@RoleLabel(path)</span>
                </div>
                <p class="mt-1 truncate text-sm text-slate-400">@path.InterfaceName</p>
            </div>
            <span class="@DotClass(path)" title="@path.StateText"></span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
            <span class="text-cyan-300"><i class="fas fa-clock mr-1 text-slate-500"></i>@FormatLatency(path.RttMs)</span>
            <span class="text-rose-300"><i class="fas fa-triangle-exclamation mr-1 text-slate-500"></i>@FormatPercent(path.LossPercent)</span>
            <span class="text-cyan-300" title="@DownloadTitle(path)">
                <i class="fas fa-arrow-down mr-1 text-slate-500"></i>Down @SpeedFormatter.FormatSpeed(path.DownloadMbps)
            </span>
            <span class="text-pink-300"><i class="fas fa-arrow-up mr-1 text-slate-500"></i>Up @SpeedFormatter.FormatSpeed(path.UploadMbps)</span>
        </div>
        <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-400">
            <span>Score @Math.Round(path.Score)</span>
            <span>Late @FormatPercent(path.LatePercent)</span>
            <span>Queue @path.QueueDepth</span>
            @if (path.DuplicateDownloadMbps > 0)
            {
                <span>Duplicate down @SpeedFormatter.FormatSpeed(path.DuplicateDownloadMbps)</span>
            }
            @if (path.InCooldown)
            {
                <span class="text-amber-300">Cooldown</span>
            }
        </div>
    </article>;

    private static string DotClass(XBondPathStatsSnapshot path)
    {
        if (!path.InterfaceUp)
        {
            return "mt-1 h-3 w-3 rounded-full bg-slate-500";
        }

        if (path.InCooldown)
        {
            return "mt-1 h-3 w-3 rounded-full bg-amber-400";
        }

        return path.IsActive
            ? "mt-1 h-3 w-3 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.55)]"
            : "mt-1 h-3 w-3 rounded-full bg-cyan-400";
    }

    private static string RoleClass(XBondPathStatsSnapshot path) => path.Role.ToLowerInvariant() switch
    {
        "anchor" => "rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200",
        "backup" => "rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 text-xs font-semibold text-cyan-200",
        "cooldown" => "rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-200",
        "unavailable" => "rounded-full border border-slate-600 bg-slate-700/40 px-2 py-0.5 text-xs font-semibold text-slate-300",
        _ => "rounded-full border border-slate-600 bg-slate-700/40 px-2 py-0.5 text-xs font-semibold text-slate-300"
    };

    private static string RoleLabel(XBondPathStatsSnapshot path)
    {
        if (!path.IsConfigured)
        {
            return "not in XBond";
        }

        if (path.IsActive && !path.IsAnchor && string.Equals(path.Role, "probe", StringComparison.OrdinalIgnoreCase))
        {
            return "backup";
        }

        return path.Role;
    }

    private static string FormatLatency(double? value) => value.HasValue && value.Value > 0
        ? $"{Math.Round(value.Value)} ms"
        : "--";

    private static string FormatPercent(double? value) => value.HasValue
        ? $"{Math.Round(value.Value, 1)}%"
        : "--";

    private static string DownloadTitle(XBondPathStatsSnapshot path) =>
        path.DuplicateDownloadMbps > 0
            ? $"Raw adapter receive: {SpeedFormatter.FormatSpeed(path.DownloadMbps)}. Useful tunnel receive: {SpeedFormatter.FormatSpeed(path.UsefulDownloadMbps)}. Duplicate receive: {SpeedFormatter.FormatSpeed(path.DuplicateDownloadMbps)}."
            : $"Useful tunnel receive: {SpeedFormatter.FormatSpeed(path.UsefulDownloadMbps)}.";

    private static string FormatDegrees(double? value) => value.HasValue
        ? $"{Math.Round(value.Value, 1)} deg"
        : "--";

    private static string FormatMode(string? mode) => string.IsNullOrWhiteSpace(mode)
        ? "XBond"
        : mode.Replace('-', ' ');

    public async ValueTask DisposeAsync()
    {
        await _refreshCts.CancelAsync();
        _timer.Dispose();
        _refreshCts.Dispose();
    }
}
