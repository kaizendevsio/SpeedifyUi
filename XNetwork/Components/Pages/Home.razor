    private IEnumerable<DashboardAlert> GetDashboardAlerts()
    {
        if (!string.IsNullOrWhiteSpace(_error))
        {
            yield return Alert("Speedify CLI", _error, "fa-terminal", "border-red-500/35 bg-red-500/10");
        }

        if (!string.IsNullOrWhiteSpace(_speedifySettingsError))
        {
            yield return Alert("Speedify settings", _speedifySettingsError, "fa-sliders", "border-red-500/35 bg-red-500/10");
        }

        if (_autoSwitchStatus?.IsEnabled == true && !string.IsNullOrWhiteSpace(_autoSwitchStatus.ProbeApiError))
        {
            yield return Alert("External probe", _autoSwitchStatus.ProbeApiError!, "fa-satellite-dish", "border-amber-500/35 bg-amber-500/10");
        }

        if (!string.IsNullOrWhiteSpace(_cudyClientHealthError))
        {
            yield return Alert("Cudy clients", _cudyClientHealthError, "fa-wifi", "border-amber-500/35 bg-amber-500/10");
        }

        if (!string.IsNullOrWhiteSpace(_cudyApStatus?.LastError))
        {
            yield return Alert("Cudy AP automation", _cudyApStatus.LastError!, "fa-tower-broadcast", "border-amber-500/35 bg-amber-500/10");
        }

        if (XRouterService.IsConfigured && _localProcessTrafficHealth is { IsSupported: false })
        {
            yield return Alert("Local process traffic", _localProcessTrafficHealth.Message, "fa-magnifying-glass-chart", "border-blue-500/35 bg-blue-500/10");
        }

    }

    private static DashboardAlert Alert(string title, string message, string icon, string cssClass)
    {
        return new DashboardAlert(title, message, icon, cssClass);
    }

    private bool IsRedundantMode()
    {
        return string.Equals(_speedifySettings?.BondingMode, "redundant", StringComparison.OrdinalIgnoreCase);
    }

    private int GetMaxRedundantConnections()
    {
        return Math.Max(1, _speedifySettings?.MaxRedundant ?? 1);
    }

    private sealed record DashboardAlert(string Title, string Message, string Icon, string CssClass);

    public async ValueTask DisposeAsync()
    {
        if (_autoRefreshTimer != null)
        {
            await _autoRefreshTimer.DisposeAsync();
        }
        
        if (_serverInfoRefreshTimer != null)
        {
            await _serverInfoRefreshTimer.DisposeAsync();
        }

        if (_healthAlertRefreshTimer != null)
        {
            await _healthAlertRefreshTimer.DisposeAsync();
        }

        if (_routerTrafficRefreshTimer != null)
        {
            await _routerTrafficRefreshTimer.DisposeAsync();
        }

        if (_statsCts != null)
        {
            if (!_statsCts.IsCancellationRequested) await _statsCts.CancelAsync();
            _statsCts.Dispose();
            _statsCts = null;
        }

        if (_animatedUiModule != null)
        {
            try
            {
                await _animatedUiModule.InvokeVoidAsync("disableAutoAnimate", _adapterListElement);
                await _animatedUiModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
