@page "/"
@using XNetwork.Models
@using XNetwork.Services
@using XNetwork.Components.Custom
@using XNetwork.Utils
@inject SpeedifyService SpeedifyService
@inject XRouterService XRouterService
@inject IConnectionHealthService ConnectionHealthService
@inject NetworkMonitorService NetworkMonitorService
@inject AutoServerSwitchService AutoServerSwitchService
@inject CudyApControlService CudyApControlService
@inject LocalProcessTrafficService LocalProcessTrafficService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Dashboard - XNetwork</PageTitle>

<div class="p-4 md:p-6">
    <div class="hidden md:block">
        <h2 class="text-3xl font-bold text-white mb-1">Dashboard</h2>
        <p class="text-slate-400 mb-6">Manage and monitor network adapters in real-time.</p>
    </div>

    @{
        var dashboardAlerts = GetDashboardAlerts().ToList();
    }
    @if (dashboardAlerts.Any())
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 mb-6" aria-label="Network health alerts">
            @foreach (var alert in dashboardAlerts)
            {
                <div class="rounded-xl border p-4 @alert.CssClass">
                    <div class="flex items-start gap-3">
                        <i class="fas @alert.Icon mt-0.5"></i>
                        <div class="min-w-0">
                            <p class="font-semibold text-white">@alert.Title</p>
                            <p class="text-sm text-slate-300 mt-1">@alert.Message</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_error) && _adapters == null && !_initialLoadComplete) 
    {
        <div class="bg-red-500/10 border border-red-500/50 text-red-400 p-4 mb-6 rounded-lg" role="alert">
            <p class="font-bold">Error Loading Adapters</p>
            <p>@_error</p>
            <button @onclick="StreamSpeedifyDataAsync" class="mt-2 px-3 py-1 bg-red-600 text-white text-sm font-semibold rounded hover:bg-red-700" disabled="@_isProcessingAction">Retry</button>
        </div>
    }
    else if (_adapters == null && !_initialLoadComplete) 
    {
        <div class="space-y-6" aria-label="Loading dashboard">
            <div class="bg-slate-800/50 border border-slate-700 rounded-xl shadow-lg p-4">
                <div class="flex items-center gap-3">
                    <SkeletonBlock CssClass="w-10 h-10 rounded-full flex-shrink-0" />
                    <div class="flex-grow space-y-2">
                        <SkeletonBlock CssClass="h-5 w-2/5" />
                        <SkeletonBlock CssClass="h-4 w-3/5" />
                    </div>
                </div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700 rounded-xl shadow-lg p-5">
                <SkeletonBlock CssClass="h-5 w-1/3 mb-5" />
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    @for (var i = 0; i < 4; i++)
                    {
                        <div class="bg-slate-900/50 rounded-lg p-4 space-y-3">
                            <SkeletonBlock CssClass="h-4 w-3/5" />
                            <SkeletonBlock CssClass="h-8 w-2/3" />
                            <SkeletonBlock CssClass="h-3 w-1/2" />
                        </div>
                    }
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex items-center gap-3 px-1">
                    <SkeletonBlock CssClass="h-6 w-28" />
                    <SkeletonBlock CssClass="h-7 w-24 rounded-full" />
                </div>
                @for (var i = 0; i < 3; i++)
                {
                    <div class="bg-slate-800/50 border border-slate-700 rounded-xl px-3 py-3 shadow-lg">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3 flex-grow min-w-0">
                                <SkeletonBlock CssClass="w-10 h-6" />
                                <div class="flex-grow space-y-2">
                                    <SkeletonBlock CssClass="h-5 w-2/5" />
                                    <SkeletonBlock CssClass="h-4 w-3/5" />
                                </div>
                            </div>
                            <SkeletonBlock CssClass="h-7 w-20 rounded-full" />
                        </div>
                        <div class="flex items-center gap-4 mt-3">
                            <SkeletonBlock CssClass="h-4 w-20" />
                            <SkeletonBlock CssClass="h-4 w-20" />
                            <SkeletonBlock CssClass="h-4 w-16" />
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (_adapters != null && !_adapters.Any())
    {
        <p class="text-slate-400">No network adapters found.</p>
    }
    else if (_adapters != null)
    {
        <!-- Current Server Information -->
        <a href="/server-statistics" class="block bg-slate-800/50 border border-slate-700 rounded-xl shadow-lg mb-6 p-4 hover:border-cyan-500/60 hover:bg-slate-800/70 transition-colors focus:outline-none focus:ring-2 focus:ring-cyan-500/60">
            @if (_serverInfoLoading)
            {
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-3 flex-grow">
                        <SkeletonBlock CssClass="w-10 h-10 rounded-full flex-shrink-0" />
                        <div class="flex-grow space-y-2">
                            <SkeletonBlock CssClass="h-5 w-1/3" />
                            <SkeletonBlock CssClass="h-4 w-1/2" />
                        </div>
                    </div>
                </div>
            }
            else if (_serverInfo == null)
            {
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-slate-700 rounded-full flex items-center justify-center">
                        <i class="fas fa-server text-slate-500 text-lg"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-semibold text-slate-400">Not Connected to Server</h3>
                        <p class="text-sm text-slate-500">Connect to a Speedify server to see details</p>
                    </div>
                </div>
            }
            else
            {
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-green-500/10 border border-green-500/30 rounded-full flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-server text-green-400 text-lg"></i>
                    </div>
                    <div class="flex-grow min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <h3 class="text-base font-semibold text-white truncate">@_serverInfo.FriendlyName</h3>
                            <span class="px-2 py-0.5 text-xs font-medium rounded-full flex-shrink-0 @GetServerBadgeClass()">
                                @GetServerConnectionType()
                            </span>
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-400">
                            <i class="fas fa-map-marker-alt text-xs"></i>
                            <span>@_serverInfo.City, @_serverInfo.Country</span>
                        </div>
                    </div>
                    <div class="flex-shrink-0 flex items-center gap-3">
                        <span class="hidden sm:inline text-xs text-slate-500">Server tests</span>
                        <i class="fas fa-chevron-right text-slate-500 text-xs"></i>
                    </div>
                </div>
            }
        </a>

        <!-- Overall Connection Summary -->
        <ConnectionSummary
            ConnectionStatus="@GetOverallConnectionStatus()"
            Latency="@GetAverageLatency()"
            Download="@GetTotalDownload()"
            Upload="@GetTotalUpload()"
            TransportProtocol="@GetTransportProtocolLabel()"
            TransportDetail="@GetTransportDetailLabel()"
            IsStable="@IsConnectionStable()"
            ShowTrafficDetailsHint="@XRouterService.IsConfigured"
            OnTrafficDetailsRequested="ShowTrafficBreakdownAsync" />

        <!-- Adapter List -->
        <div class="space-y-3">
            <div class="flex items-center gap-3 px-1">
                <h3 class="text-lg font-semibold text-white">Adapters</h3>
                <span class="px-3 py-1 bg-green-500/10 text-green-400 text-sm font-medium rounded-full">
                    @GetConnectedCount() connected
                </span>
            </div>
            
            <div class="space-y-3" @ref="_adapterListElement">
                @foreach (var adapter in GetSortedAdapters())
                {
                    var currentStats = GetStatsForAdapter(adapter.AdapterId);
                    var isOffline = adapter.State.ToLowerInvariant() == "disconnected" || adapter.State.ToLowerInvariant() == "offline";
                    var isConnecting = adapter.State.ToLowerInvariant() == "connecting";
                    var bgClass = GetAdapterBackgroundClass(adapter, currentStats);
                    var signalStrength = !isOffline ? GetSignalStrength(adapter, currentStats) : 0;
                    var signalColor = !isOffline ? GetSignalColor(adapter.State, signalStrength) : "slate-700";

                    <div @key="adapter.AdapterId"
                         class="@bgClass border border-slate-700 rounded-xl px-3 py-3 shadow-lg relative cursor-pointer hover:bg-slate-700/30 transition-colors"
                         @onclick="() => OnAdapterClick(adapter)">
                        <!-- Row 1: Header -->
                        <div class="flex items-center justify-between gap-3 text-sm">
                        <div class="flex items-center gap-3 flex-grow min-w-0">
                            @if (!isOffline)
                            {
                                <div class="flex items-end gap-0.5 w-10 h-6 flex-shrink-0">
                                    @for (int i = 0; i < 4; i++)
                                    {
                                        var isActive = isConnecting ? (i < 2) : (i < signalStrength);
                                        var heightClass = i switch
                                        {
                                            0 => "h-2",  // 25% height
                                            1 => "h-3",  // 37.5% height
                                            2 => "h-4",  // 50% height
                                            3 => "h-6",  // 100% height
                                            _ => "h-2"
                                        };
                                        var animationClass = isConnecting && isActive ? "animate-pulse" : "";
                                        var colorClass = isActive ? $"bg-{signalColor}" : "bg-slate-700";
                                        <div class="@heightClass @colorClass @animationClass w-1.5 rounded-sm transition-all"></div>
                                    }
                                </div>
                            }
                                else
                                {
                                    <i class="fas fa-signal-slash text-red-400 text-lg w-8 text-center flex-shrink-0"></i>
                                }
                                <div class="flex flex-col min-w-0">
                                    <span class="text-base font-medium text-white truncate">@GetProviderName(adapter)</span>
                                    <span class="text-sm text-slate-400 truncate">@adapter.Name</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                @{
                                    var gateway = _gatewayCache.GetValueOrDefault(adapter.AdapterId);
                                }
                                @if (!string.IsNullOrEmpty(gateway))
                                {
                                    <a href="http://@gateway"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-700/50 hover:bg-slate-600/50 text-slate-300 hover:text-white transition-colors border border-slate-600/50 hover:border-slate-500"
                                       title="Open Router Admin (@gateway)"
                                       @onclick:stopPropagation="true">
                                         <span class="text-base">↗</span>
                                     </a>
                                 }
                                 <span class="text-xs font-medium @GetStatusPillClass(adapter.State) px-2.5 py-1 rounded-full">
                                     @adapter.State
                                 </span>
                            </div>
                        </div>
                        
                        <!-- Row 2: Stats -->
                        @if (!isOffline && currentStats != null)
                        {
                            var downloadSpeedMbps = SpeedifyStatsUnits.RateFieldToMbps(currentStats.ReceiveBps);
                            var uploadSpeedMbps = SpeedifyStatsUnits.RateFieldToMbps(currentStats.SendBps);

                            <div class="flex items-center gap-4 mt-3 text-sm">
                                <div class="flex items-center gap-1.5">
                                    <i class="fas fa-arrow-down text-cyan-400 text-sm"></i>
                                    <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(downloadSpeedMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(downloadSpeedMbps)" CssClass="text-white font-semibold" AriaLabel="@SpeedFormatter.FormatSpeed(downloadSpeedMbps)" />
                                    <span class="text-xs text-slate-400">@SpeedFormatter.GetSpeedUnit(downloadSpeedMbps)</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <i class="fas fa-arrow-up text-pink-400 text-sm"></i>
                                    <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(uploadSpeedMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(uploadSpeedMbps)" CssClass="text-white font-semibold" AriaLabel="@SpeedFormatter.FormatSpeed(uploadSpeedMbps)" />
                                    <span class="text-xs text-slate-400">@SpeedFormatter.GetSpeedUnit(uploadSpeedMbps)</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <i class="far fa-clock text-slate-400 text-sm"></i>
                                    <AnimatedNumber Value="@currentStats.LatencyMs" Decimals="0" CssClass="text-white font-semibold" AriaLabel="@($"{currentStats.LatencyMs} milliseconds")" />
                                    <span class="text-xs text-slate-400">ms</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<ActionSheet IsOpen="_showTrafficBreakdown"
             Title="Traffic Breakdown"
             Description="Speedify tunnel traffic split by Wifi clients, local router processes, and estimated VPN overhead."
             CloseLabel="Close traffic breakdown"
             MaxWidthClass="md:max-w-5xl"
             OnClose="CloseTrafficBreakdownAsync">
    <div class="space-y-5">
        @if (_routerTrafficLoading && _routerTrafficSummary is null)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3" aria-label="Loading traffic breakdown">
                @for (var i = 0; i < 4; i++)
                {
                    <div class="bg-slate-950/60 rounded-xl p-4 space-y-3">
                        <SkeletonBlock CssClass="h-4 w-2/5" />
                        <SkeletonBlock CssClass="h-8 w-3/5" />
                        <SkeletonBlock CssClass="h-4 w-1/2" />
                    </div>
                }
            </div>
        }
        else if (_routerTrafficSummary is not null)
        {
            var trafficSummary = GetCurrentRouterTrafficSummary();
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
                <div class="bg-slate-950/60 rounded-xl p-4 border border-slate-800">
                    <p class="text-xs text-slate-400 mb-2">Speedify Tunnel</p>
                    <p class="text-2xl font-bold text-cyan-300">↓ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.SpeedifyDownloadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.SpeedifyDownloadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.SpeedifyDownloadMbps)" /> <span class="text-sm font-semibold text-cyan-200/80">@SpeedFormatter.GetSpeedUnit(trafficSummary.SpeedifyDownloadMbps)</span></p>
                    <p class="text-sm text-pink-300">↑ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.SpeedifyUploadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.SpeedifyUploadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.SpeedifyUploadMbps)" /> <span class="text-xs font-semibold text-pink-200/80">@SpeedFormatter.GetSpeedUnit(trafficSummary.SpeedifyUploadMbps)</span></p>
                </div>
                <div class="bg-slate-950/60 rounded-xl p-4 border border-slate-800">
                    <p class="text-xs text-slate-400 mb-2">Wifi Clients</p>
                    <p class="text-2xl font-bold text-cyan-300">↓ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.CudyClientDownloadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.CudyClientDownloadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.CudyClientDownloadMbps)" /> <span class="text-sm font-semibold text-cyan-200/80">@SpeedFormatter.GetSpeedUnit(trafficSummary.CudyClientDownloadMbps)</span></p>
                    <p class="text-sm text-pink-300">↑ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.CudyClientUploadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.CudyClientUploadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.CudyClientUploadMbps)" /> <span class="text-xs font-semibold text-pink-200/80">@SpeedFormatter.GetSpeedUnit(trafficSummary.CudyClientUploadMbps)</span></p>
                    <p class="text-xs text-slate-500 mt-2">@trafficSummary.CudyClientCount Cudy clients</p>
                </div>
                <div class="bg-slate-950/60 rounded-xl p-4 border border-blue-500/20">
                    <p class="text-xs text-blue-200 mb-2">Local Processes</p>
                    <p class="text-2xl font-bold text-blue-200">↓ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.LocalProcessDownloadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.LocalProcessDownloadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.LocalProcessDownloadMbps)" /> <span class="text-sm font-semibold text-blue-100/70">@SpeedFormatter.GetSpeedUnit(trafficSummary.LocalProcessDownloadMbps)</span></p>
                    <p class="text-sm text-blue-100/80">↑ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.LocalProcessUploadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.LocalProcessUploadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.LocalProcessUploadMbps)" /> <span class="text-xs font-semibold text-blue-100/60">@SpeedFormatter.GetSpeedUnit(trafficSummary.LocalProcessUploadMbps)</span></p>
                </div>
                <div class="bg-slate-950/60 rounded-xl p-4 border border-amber-500/25">
                    <p class="text-xs text-amber-200 mb-2">Estimated VPN / Overhead</p>
                    <p class="text-2xl font-bold text-amber-200">↓ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.EstimatedOverheadDownloadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.EstimatedOverheadDownloadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.EstimatedOverheadDownloadMbps)" /> <span class="text-sm font-semibold text-amber-100/70">@SpeedFormatter.GetSpeedUnit(trafficSummary.EstimatedOverheadDownloadMbps)</span></p>
                    <p class="text-sm text-amber-100/80">↑ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(trafficSummary.EstimatedOverheadUploadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(trafficSummary.EstimatedOverheadUploadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(trafficSummary.EstimatedOverheadUploadMbps)" /> <span class="text-xs font-semibold text-amber-100/60">@SpeedFormatter.GetSpeedUnit(trafficSummary.EstimatedOverheadUploadMbps)</span></p>
                </div>
            </div>

            @if (IsRedundantMode())
            {
                <div class="rounded-xl border border-amber-500/25 bg-amber-500/10 p-4 text-sm text-amber-100">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-clone mt-0.5 text-amber-300"></i>
                        <p>
                            Speedify redundant mode is active. Tunnel traffic can exceed Wifi client traffic because packets may be duplicated across up to @GetMaxRedundantConnections() available connections, plus retransmits and timing mismatch.
                        </p>
                    </div>
                </div>
            }

            <section class="bg-slate-950/50 border border-slate-800 rounded-xl overflow-hidden">
                <div class="p-4 border-b border-slate-800 flex items-center justify-between gap-3">
                    <div>
                        <h4 class="font-semibold text-white">Top Local Processes</h4>
                        <p class="text-xs text-slate-400">Live process names and throughput observed on the Speedify tunnel interface.</p>
                    </div>
                    <span class="text-xs text-slate-500">@trafficSummary.LocalProcessTraffic.Source</span>
                </div>

                @if (!trafficSummary.LocalProcessTraffic.IsSupported)
                {
                    <div class="p-4 text-sm text-slate-300">
                        @trafficSummary.LocalProcessTraffic.Message
                    </div>
                }
                else if (!trafficSummary.LocalProcessTraffic.Processes.Any())
                {
                    <div class="p-4 text-sm text-slate-300">
                        @trafficSummary.LocalProcessTraffic.Message
                    </div>
                }
                else
                {
                    <div class="divide-y divide-slate-800">
                        @foreach (var process in trafficSummary.LocalProcessTraffic.Processes)
                        {
                            <div class="p-4 flex items-center justify-between gap-4">
                                <div class="min-w-0">
                                    <p class="font-semibold text-white truncate">@process.ProcessName</p>
                                    <p class="text-xs text-slate-500 truncate">@FormatProcessDetail(process)</p>
                                </div>
                                <div class="text-right flex-shrink-0">
                                    <p class="text-sm text-cyan-300">↓ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(process.DownloadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(process.DownloadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(process.DownloadMbps)" /> <span class="text-xs text-cyan-200/70">@SpeedFormatter.GetSpeedUnit(process.DownloadMbps)</span></p>
                                    <p class="text-sm text-pink-300">↑ <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(process.UploadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(process.UploadMbps)" AriaLabel="@SpeedFormatter.FormatSpeed(process.UploadMbps)" /> <span class="text-xs text-pink-200/70">@SpeedFormatter.GetSpeedUnit(process.UploadMbps)</span></p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <p class="text-xs text-slate-500">
                Estimated VPN / overhead is the unmatched part after subtracting Wifi clients and observed local processes from Speedify tunnel totals. It can include Speedify encapsulation, retransmits, timing-window mismatch, forwarded client packets that nethogs cannot map to a Pi process, or local traffic the process sampler cannot attribute.
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(_routerTrafficError))
        {
            <p class="text-sm text-red-300">Traffic breakdown refresh failed: @_routerTrafficError</p>
        }
    </div>
</ActionSheet>

@code {
    private IReadOnlyList<Adapter>? _adapters;
    private List<ConnectionItem> _stats = new();
    private ConnectionItem? _aggregateStats;
    private ServerInfo? _serverInfo;
    private string? _error;
    private CancellationTokenSource? _statsCts;
    private Timer? _autoRefreshTimer;
    private Timer? _serverInfoRefreshTimer;
    private Timer? _routerTrafficRefreshTimer;
    private Timer? _healthAlertRefreshTimer;
    private readonly string[] _prios = ["automatic", "always", "secondary", "backup", "never"];
    private Dictionary<string, string?> _gatewayCache = new();
    private RouterTrafficSummary? _routerTrafficSummary;
    private SpeedifySettings? _speedifySettings;
    private TransportSettings? _transportSettings;
    private AutoServerSwitchStatus? _autoSwitchStatus;
    private CudyApControlStatus? _cudyApStatus;
    private LocalProcessTrafficSnapshot? _localProcessTrafficHealth;
    private string? _cudyClientHealthError;
    private string? _speedifySettingsError;
    private string? _routerTrafficError;
    private bool _routerTrafficLoading;
    private bool _showTrafficBreakdown;
    private int _adapterRefreshInProgress;
    private int _serverInfoRefreshInProgress;
    private int _healthAlertRefreshInProgress;
    private int _routerTrafficRefreshInProgress;
    private ElementReference _adapterListElement;
    private IJSObjectReference? _animatedUiModule;
    private bool _adapterListAnimationEnabled;

    private bool _initialLoadComplete = false;
    private bool _isProcessingAction = false;
    private bool _serverInfoLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        
        _autoRefreshTimer = new Timer(async _ => await InvokeAsync(LoadAdaptersAndSettingsAsync), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        _serverInfoRefreshTimer = new Timer(async _ => await InvokeAsync(LoadServerInfoAsync), null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
        _healthAlertRefreshTimer = new Timer(_ => _ = InvokeAsync(() => LoadHealthAlertsAsync(true)), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(15));

        await LoadAdaptersAndSettingsAsync();
        await LoadServerInfoAsync();

        await StreamSpeedifyDataAsync();
    }

    private async Task LoadHealthAlertsAsync(bool background)
    {
        if (Interlocked.Exchange(ref _healthAlertRefreshInProgress, 1) == 1)
        {
            return;
        }

        try
        {
            _autoSwitchStatus = AutoServerSwitchService.GetStatus();
            _cudyApStatus = CudyApControlService.GetStatus();
            try
            {
                _speedifySettings = await SpeedifyService.GetSettingsAsync(_statsCts?.Token ?? CancellationToken.None);
                _speedifySettingsError = null;
            }
            catch (Exception ex)
            {
                _speedifySettingsError = ex.Message;
            }

            if (XRouterService.IsConfigured)
            {
                try
                {
                    await XRouterService.GetClientsAsync(_statsCts?.Token ?? CancellationToken.None);
                    _cudyClientHealthError = null;
                }
                catch (Exception ex)
                {
                    _cudyClientHealthError = ex.Message;
                }

                try
                {
                    _localProcessTrafficHealth = await LocalProcessTrafficService.GetSnapshotAsync(_statsCts?.Token ?? CancellationToken.None);
                }
                catch (Exception ex)
                {
                    _localProcessTrafficHealth = LocalProcessTrafficSnapshot.Unsupported(ex.Message);
                }
            }
        }
        finally
        {
            Interlocked.Exchange(ref _healthAlertRefreshInProgress, 0);
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animatedUiModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/animatedUi.js");
        }

        if (_animatedUiModule is not null && !_adapterListAnimationEnabled && _adapters?.Any() == true)
        {
            await _animatedUiModule.InvokeVoidAsync("enableAutoAnimate", _adapterListElement);
            _adapterListAnimationEnabled = true;
        }
    }

    private string GetAdapterDisplayName(string adapterId)
    {
        var adapter = _adapters?.FirstOrDefault(a => a.AdapterId == adapterId);
        return adapter != null ? !string.IsNullOrWhiteSpace(adapter.Isp) ? $"{adapter.Isp} ({adapter.Name})" : adapter.Name : adapterId;
    }

    private async Task LoadAdaptersAndSettingsAsync()
    {
        if (Interlocked.Exchange(ref _adapterRefreshInProgress, 1) == 1)
        {
            return;
        }

        try
        {
            _adapters = await SpeedifyService.GetAdaptersAsync();

            // Load gateway IPs for all adapters (Linux only)
            if (OperatingSystem.IsLinux() && _adapters != null)
            {
                foreach (var adapter in _adapters)
                {
                    if (!_gatewayCache.ContainsKey(adapter.AdapterId))
                    {
                        try
                        {
                            var gateway = await NetworkMonitorService.GetGatewayAsync(adapter.AdapterId);
                            _gatewayCache[adapter.AdapterId] = gateway;
                        }
                        catch (Exception)
                        {
                            _gatewayCache[adapter.AdapterId] = null;
                        }
                    }
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            Interlocked.Exchange(ref _adapterRefreshInProgress, 0);
        }
    }
    
    private async Task LoadServerInfoAsync()
    {
        if (Interlocked.Exchange(ref _serverInfoRefreshInProgress, 1) == 1)
        {
            return;
        }

        try
        {
            var serverInfoTask = SpeedifyService.GetCurrentServerAsync();
            var transportSettingsTask = SpeedifyService.GetTransportSettingsAsync();

            await Task.WhenAll(serverInfoTask, transportSettingsTask);

            _serverInfo = await serverInfoTask;
            _transportSettings = await transportSettingsTask;
            _serverInfoLoading = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception)
        {
            _serverInfoLoading = false;
        }
        finally
        {
            Interlocked.Exchange(ref _serverInfoRefreshInProgress, 0);
        }
    }

    private async Task ShowTrafficBreakdownAsync()
    {
        if (!XRouterService.IsConfigured)
        {
            return;
        }

        _showTrafficBreakdown = true;
        _routerTrafficRefreshTimer ??= new Timer(async _ => await InvokeAsync(() => LoadRouterTrafficAsync(true)), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        await LoadRouterTrafficAsync(false);
    }

    private async Task CloseTrafficBreakdownAsync()
    {
        _showTrafficBreakdown = false;
        if (_routerTrafficRefreshTimer != null)
        {
            await _routerTrafficRefreshTimer.DisposeAsync();
            _routerTrafficRefreshTimer = null;
        }
    }

    private async Task LoadRouterTrafficAsync(bool background)
    {
        if (!XRouterService.IsConfigured || !_showTrafficBreakdown)
        {
            return;
        }

        if (Interlocked.Exchange(ref _routerTrafficRefreshInProgress, 1) == 1)
        {
            return;
        }

        if (!background)
        {
            _routerTrafficLoading = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            _routerTrafficSummary = await XRouterService.GetTrafficSummaryAsync(GetTotalDownload(), GetTotalUpload(), _statsCts?.Token ?? CancellationToken.None);
            _routerTrafficError = null;
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _routerTrafficError = ex.Message;
        }
        finally
        {
            _routerTrafficLoading = false;
            Interlocked.Exchange(ref _routerTrafficRefreshInProgress, 0);
            await InvokeAsync(StateHasChanged);
        }
    }
    
    private async Task StreamSpeedifyDataAsync()
    {
        if (_isProcessingAction && _initialLoadComplete) return;

        _statsCts = new CancellationTokenSource();
        try
        {
            await foreach (var statEntry in SpeedifyService.GetStatsWithAggregateAsync(_statsCts.Token))
            {
                if (IsSpeedifyAggregate(statEntry))
                {
                    _aggregateStats = statEntry;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                var existingStatIndex = _stats.FindIndex(s => s.AdapterId == statEntry.AdapterId);
                if (existingStatIndex != -1) _stats[existingStatIndex] = statEntry;
                else _stats.Add(statEntry);
                
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (SpeedifyException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            if (!_initialLoadComplete) _initialLoadComplete = true;
        }
    }

    private ConnectionItem? GetStatsForAdapter(string adapterId)
    {
        return _stats.FirstOrDefault(x => x.AdapterId == adapterId);
    }

    private static bool IsSpeedifyAggregate(ConnectionItem statEntry)
    {
        return statEntry.AdapterId.Equals("speedify", StringComparison.OrdinalIgnoreCase) &&
               statEntry.ConnectionId.Equals("speedify", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ChangePriority(string adapterId, string? newPriority)
    {
        if (string.IsNullOrEmpty(newPriority) || _isProcessingAction) return;
        _isProcessingAction = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await SpeedifyService.SetPriorityAsync(adapterId, newPriority);
            await LoadAdaptersAndSettingsAsync();
        }
        catch (SpeedifyException ex) { _error = ex.Message; }
        finally
        {
            _isProcessingAction = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetProviderName(Adapter adapter)
    {
        // Extract provider name from ISP field or use adapter name
        if (!string.IsNullOrWhiteSpace(adapter.Isp))
        {
            return adapter.Isp;
