@page "/"
@using Microsoft.JSInterop
@using XNetwork.Components.Custom
@using XNetwork.Models
@using XNetwork.Services
@using XNetwork.Utils
@implements IAsyncDisposable
@inject XBondSnapshotCache XBondSnapshotCache
@inject IStarlinkTelemetryService StarlinkTelemetryService
@inject StarlinkTelemetrySettings StarlinkTelemetrySettings
@inject AdapterIdentityService AdapterIdentityService
@inject AdapterIdentitySettings AdapterIdentitySettings
@inject AdapterTelemetryHistoryService AdapterTelemetryHistoryService
@inject LocalDeviceProxyService LocalDeviceProxyService
@inject IConnectionHealthService ConnectionHealthService
@inject UiDisplayPreferences UiDisplayPreferences
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard - uLink</PageTitle>

<div class="p-4 md:p-6">
    <div class="hidden md:block">
        <h2 class="mb-1 text-3xl font-bold text-white">Dashboard</h2>
        <p class="mb-6 text-slate-400">Manage and monitor network adapters in real-time.</p>
    </div>

    @if (_snapshot is null)
    {
        <div class="space-y-6" aria-label="Loading dashboard">
            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-4 shadow-lg">
                <div class="flex items-center gap-3">
                    <SkeletonBlock CssClass="w-10 h-10 rounded-full flex-shrink-0" />
                    <div class="flex-grow space-y-2">
                        <SkeletonBlock CssClass="h-5 w-2/5" />
                        <SkeletonBlock CssClass="h-4 w-3/5" />
                    </div>
                </div>
            </div>

            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-5 shadow-lg">
                <SkeletonBlock CssClass="h-5 w-1/3 mb-5" />
                <div class="grid grid-cols-3 gap-4">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="space-y-3 rounded-lg bg-slate-900/50 p-4">
                            <SkeletonBlock CssClass="h-4 w-3/5" />
                            <SkeletonBlock CssClass="h-8 w-2/3" />
                        </div>
                    }
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex items-center gap-3 px-1">
                    <SkeletonBlock CssClass="h-6 w-28" />
                    <SkeletonBlock CssClass="h-7 w-20 rounded-full" />
                </div>
                @for (var i = 0; i < 3; i++)
                {
                    <div class="rounded-xl border border-slate-700 bg-slate-800/50 px-3 py-3 shadow-lg">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex min-w-0 flex-grow items-center gap-3">
                                <SkeletonBlock CssClass="w-10 h-6" />
                                <div class="flex-grow space-y-2">
                                    <SkeletonBlock CssClass="h-5 w-2/5" />
                                    <SkeletonBlock CssClass="h-4 w-3/5" />
                                </div>
                            </div>
                            <SkeletonBlock CssClass="h-7 w-7 rounded-full" />
                        </div>
                        <div class="mt-3 flex items-center gap-4">
                            <SkeletonBlock CssClass="h-4 w-20" />
                            <SkeletonBlock CssClass="h-4 w-20" />
                            <SkeletonBlock CssClass="h-4 w-16" />
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        @if (_snapshot.HasError && !string.IsNullOrWhiteSpace(_snapshot.Error))
        {
            <div class="mb-6 rounded-xl border border-red-500/35 bg-red-500/10 p-4 text-red-100" role="alert">
                <div class="flex items-start gap-3">
                    <i class="fas fa-terminal mt-0.5 text-red-300"></i>
                    <div class="min-w-0">
                        <p class="font-semibold text-white">uLink status</p>
                        <p class="mt-1 text-sm text-red-100">@_snapshot.Error</p>
                    </div>
                </div>
            </div>
        }

        <ConnectionSummary
            ConnectionStatus="@ConnectionTitle"
            Latency="@GetLatencyValue()"
            InternetLatency="@GetInternetLatencyValue()"
            Download="@_snapshot.DownloadMbps"
            Upload="@_snapshot.UploadMbps"
            AnchorDownload="@GetAnchorDownloadMbps()"
            BackupDownload="@GetBackupDownloadMbps()"
            IsStable="@IsConnectionStable()"
            Mode="@FormatMode(_snapshot.RedundancyPolicy)"
            ShowMode="@UiDisplayPreferences.ShowConnectionMode"
            IsProtectingFromLoss="@_snapshot.IsProtectingFromLoss"
            ProtectionReason="@_snapshot.ProtectionReason"
            IsRecoveryActive="@_snapshot.IsRecoveryActive"
            RecoveryHoldMs="@_snapshot.RecoveryHoldMs"
            RecoveryReason="@_snapshot.RecoveryReason"
            ServerHealthStatus="@_snapshot.EffectiveServerHealthStatus"
            ServerHealthLabel="@_snapshot.ServerHealthLabel"
            ServerHealthDetails="@_snapshot.ServerHealthDetails"
            ShowTrafficDetailsHint="false" />

        <section class="space-y-3">
            @if (_snapshot?.DashboardPaths.Any() != true)
            {
                <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-5 text-slate-400 shadow-lg">
                    No uLink adapters found.
                </div>
            }
            else
            {
                <div class="adapter-flip-list" @ref="_adapterListElement">
                    @if (_snapshot.ActivePaths.Count > 0)
                    {
                        <div class="active-redundant-group-surface"
                             style="@GetActiveGroupGridStyle()"
                             aria-hidden="true"></div>
                        <div class="active-redundant-header" style="grid-row: 1;">
                            <span class="inline-flex h-6 w-6 items-center justify-center rounded-lg bg-slate-500/10 text-slate-300">
                                <i class="fas fa-shield-halved text-xs"></i>
                            </span>
                            <h4 class="text-base font-semibold text-white">Actively Redundant</h4>
                            <span class="inline-flex min-w-6 items-center justify-center rounded-full border border-slate-400/30 bg-slate-400/10 px-2 py-0.5 text-xs font-semibold text-slate-100">
                                @_snapshot.ActivePaths.Count
                            </span>
                        </div>
                    }

                    @foreach (var path in GetOrderedDashboardPaths())
                    {
                        @PathCard(path)
                    }
                </div>
            }
        </section>
    }
</div>

<AdapterDetailsSheet IsOpen="_showAdapterDetails"
                     Path="_selectedPath"
                     Identity="@(_selectedPath is null ? null : AdapterIdentityService.Get(_selectedPath.InterfaceName))"
                     Samples="@(_selectedPath is null ? Array.Empty<AdapterTelemetrySample>() : AdapterTelemetryHistoryService.GetSamples(_selectedPath.InterfaceName))"
                     AdminUrl="@(_selectedPath is null ? null : GetAdapterAdminUrl(_selectedPath))"
                     IdentityLookupEnabled="AdapterIdentitySettings.Enabled"
                     IsRefreshingIdentity="_identityRefreshInProgress"
                     ShowTechnicalDetails="UiDisplayPreferences.AdapterTechnicalDetails"
                     OnClose="CloseAdapterDetailsAsync"
                     OnRefreshIdentity="RefreshSelectedIdentityAsync">
    @if (_selectedPath is not null && IsStarlinkPath(_selectedPath))
    {
        <StarlinkDetailsSection Snapshot="StarlinkTelemetryService.GetSnapshot()"
                                History="StarlinkTelemetryService.GetHistory()"
                                Capabilities="StarlinkTelemetryService.GetCapabilities()"
                                ManagementHost="@StarlinkTelemetrySettings.Host"
                                LastCommandResult="_lastStarlinkCommandResult"
                                CommandInProgress="_starlinkCommandInProgress"
                                PendingCommand="_pendingStarlinkCommand"
                                OnExecuteCommand="ExecuteStarlinkCommandAsync" />
    }
</AdapterDetailsSheet>

@code {
    private const ulong StaleAckWarningMs = 5_000;

    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(1));
    private readonly CancellationTokenSource _refreshCts = new();
    private XBondStatsSnapshot? _snapshot;
    private StarlinkTelemetrySnapshot _starlink = StarlinkTelemetrySnapshot.Unavailable();
    private bool _showAdapterDetails;
    private bool _identityRefreshInProgress;
    private XBondPathStatsSnapshot? _selectedPath;
    private StarlinkCapability? _pendingStarlinkCommand;
    private StarlinkCommandResult? _lastStarlinkCommandResult;
    private bool _starlinkCommandInProgress;
    private IJSObjectReference? _animatedUiModule;
    private ElementReference _adapterListElement;
    private bool _adapterFlipAnimationEnabled;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _adapterFlipAnimationEnabled || _snapshot?.DashboardPaths.Any() != true)
        {
            return;
        }

        try
        {
            _animatedUiModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/animatedUi.js");
            await _animatedUiModule.InvokeVoidAsync("enableFlipList", _adapterListElement);
            _adapterFlipAnimationEnabled = true;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        if (_disposed)
        {
            return;
        }

        _snapshot = await XBondSnapshotCache.GetSnapshotAsync(_refreshCts.Token);
        _starlink = StarlinkTelemetryService.GetSnapshot();

        if (_selectedPath is not null)
        {
            _selectedPath = _snapshot.Paths.FirstOrDefault(path => path.PathId == _selectedPath.PathId) ?? _selectedPath;
        }

        StateHasChanged();
    }

    private string ConnectionTitle => _snapshot switch
    {
        null => "Initializing Connection",
        _ => _snapshot.ConnectionTitle
    };

    private void OnPathCardClick(XBondPathStatsSnapshot path)
    {
        _selectedPath = path;
        _showAdapterDetails = true;
    }

    private Task CloseAdapterDetailsAsync()
    {
        _showAdapterDetails = false;
        _pendingStarlinkCommand = null;
        return Task.CompletedTask;
    }

    private async Task RefreshSelectedIdentityAsync()
    {
        if (_selectedPath is null || _identityRefreshInProgress)
        {
            return;
        }

        _identityRefreshInProgress = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            AdapterIdentityService.Invalidate(_selectedPath.InterfaceName);
            await AdapterIdentityService.RefreshAsync(_selectedPath.InterfaceName, _selectedPath.Gateway, _refreshCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _identityRefreshInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ExecuteStarlinkCommandAsync(StarlinkCapability capability)
    {
        if (!capability.IsActionable || string.IsNullOrWhiteSpace(capability.DirectCommand) || _starlinkCommandInProgress)
        {
            return;
        }

        _pendingStarlinkCommand = capability;
        _starlinkCommandInProgress = true;
        _lastStarlinkCommandResult = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            _lastStarlinkCommandResult = await StarlinkTelemetryService.ExecuteCommandAsync(
                capability.DirectCommand,
                _refreshCts.Token);
        }
        catch (OperationCanceledException)
        {
            _lastStarlinkCommandResult = new StarlinkCommandResult
            {
                Command = capability.DirectCommand,
                Success = false,
                Message = $"{capability.Label} command was canceled"
            };
        }
        finally
        {
            _starlinkCommandInProgress = false;
            _pendingStarlinkCommand = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsStarlinkPath(XBondPathStatsSnapshot path)
    {
        return StarlinkAdapterDetector.HasStarlinkMetadata(path, StarlinkTelemetrySettings.AdapterNameHints) ||
               StarlinkAdapterDetector.MatchesManagementGateway(path.Gateway, StarlinkTelemetrySettings.Host);
    }

    private RenderFragment StarlinkTelemetryInline(XBondPathStatsSnapshot path) => @<div class="mt-3 border-t border-slate-700/60 pt-3">
        @if (_starlink.IsAvailable)
        {
            var alertPreview = _starlink.ActiveAlerts.Take(2).ToList();
            var hiddenAlertCount = Math.Max(0, _starlink.ActiveAlerts.Count - alertPreview.Count);

            <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-slate-300">
                <span class="inline-flex items-center gap-1.5" title="Direct Starlink dish latency">
                    <i class="fas fa-satellite-dish text-cyan-300"></i>
                    <span>Dish @TelemetryFormatter.FormatNullableMs(_starlink.PopPingLatencyMs)</span>
                </span>
                <span class="inline-flex items-center gap-1.5" title="Direct Starlink dish downlink throughput">
                    <i class="fas fa-arrow-down text-cyan-300"></i>
                    <span>@TelemetryFormatter.FormatNullableSpeed(_starlink.DownlinkMbps)</span>
                </span>
                <span class="inline-flex items-center gap-1.5" title="Direct Starlink dish uplink throughput">
                    <i class="fas fa-arrow-up text-pink-300"></i>
                    <span>@TelemetryFormatter.FormatNullableSpeed(_starlink.UplinkMbps)</span>
                </span>
                <span class="inline-flex items-center gap-1.5" title="Direct Starlink obstruction estimate">
                    <i class="fas fa-ban text-amber-300"></i>
                    <span>Obs @TelemetryFormatter.FormatNullablePercent(_starlink.ObstructionPercent)</span>
                </span>
                <span class="inline-flex items-center gap-1.5" title="Direct Starlink alignment error">
                    <i class="fas fa-crosshairs text-emerald-300"></i>
                    <span>Align @TelemetryFormatter.FormatNullableDegrees(_starlink.AlignmentErrorDegrees)</span>
                </span>
                <span class="inline-flex items-center gap-1.5" title="Direct Starlink dish uptime">
                    <i class="far fa-hourglass-half text-slate-400"></i>
                    <span>Up @TelemetryFormatter.FormatDuration(_starlink.UptimeSeconds)</span>
                </span>
                @if (_starlink.GpsSatellites is not null)
                {
                    <span class="inline-flex items-center gap-1.5" title="Direct Starlink GPS satellites">
                        <i class="fas fa-location-crosshairs text-slate-400"></i>
                        <span>GPS @_starlink.GpsSatellites</span>
                    </span>
                }
            </div>

            @if (alertPreview.Count > 0)
            {
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    @foreach (var alert in alertPreview)
                    {
                        <span class="rounded-full border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 text-[11px] text-amber-200" title="@StarlinkAlertPresenter.GetDescription(alert)">
                            @StarlinkAlertPresenter.GetLabel(alert)
                        </span>
                    }
                    @if (hiddenAlertCount > 0)
                    {
                        <span class="rounded-full border border-slate-600/40 bg-slate-700/50 px-2 py-0.5 text-[11px] text-slate-300">
                            +@hiddenAlertCount
                        </span>
                    }
                </div>
            }
        }
        else
        {
            <div class="inline-flex items-center gap-2 text-xs text-amber-200" title="@_starlink.Error">
                <i class="fas fa-satellite-dish"></i>
                <span>Starlink stats unavailable</span>
            </div>
        }
    </div>;

    private RenderFragment<XBondPathStatsSnapshot> PathCard => path => @<article @key="path.PathId"
        data-flip-key="@path.PathId"
        data-active="@path.IsActive.ToString().ToLowerInvariant()"
        class="@GetPathCardClass(path)"
        style="@GetPathGridStyle(path)"
        @onclick="() => OnPathCardClick(path)">
        <div class="flex items-center justify-between gap-3 text-sm">
            <div class="flex min-w-0 flex-grow items-center gap-3">
                @if (path.InterfaceUp)
                {
                    <div class="flex h-6 w-10 flex-shrink-0 items-end gap-0.5" aria-hidden="true">
                        @for (var i = 0; i < 4; i++)
                        {
                            <span class="ulink-signal-bar-slot">
                                <span class="@GetSignalBarClass(path, i)" style="@GetSignalBarStyle(path, i)"></span>
                            </span>
                        }
                    </div>
                }
                else
                {
                    <i class="fas fa-signal-slash w-8 flex-shrink-0 text-center text-lg text-red-400"></i>
                }
                <div class="flex min-w-0 flex-col">
                    <span class="truncate text-base font-medium text-white">@path.Name</span>
                    <span class="truncate text-sm text-slate-400">@path.InterfaceName</span>
                    @if (path.HasCellularTelemetry)
                    {
                        <span class="mt-1 inline-flex items-center gap-1.5 text-xs font-medium text-slate-300" title="F50 modem signal">
                            @if (!string.IsNullOrWhiteSpace(path.CellularGeneration))
                            {
                                <span class="rounded-full border border-cyan-400/25 bg-cyan-400/10 px-1.5 py-0.5 text-cyan-100">@path.CellularGeneration</span>
                            }
                            @if (path.CellularSignalBars.HasValue)
                            {
                                <span class="inline-flex h-3 items-end gap-0.5" aria-label="@($"{path.CellularSignalBars.Value} signal bars")">
                                    @for (var i = 0; i < 5; i++)
                                    {
                                        <span class="ulink-cellular-signal-bar-slot">
                                            <span class="@GetF50SignalBarClass(path, i)" style="@GetF50SignalBarStyle(path, i)"></span>
                                        </span>
                                    }
                                </span>
                            }
                        </span>
                    }
                </div>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2">
                @if (GetAdapterAdminUrl(path) is { Length: > 0 } adminUrl)
                {
                    <a href="@adminUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="flex h-8 w-8 items-center justify-center rounded-lg border border-slate-600/50 bg-slate-700/50 text-slate-300 transition-colors hover:border-slate-500 hover:bg-slate-600/50 hover:text-white"
                       title="@($"Open {path.Name} admin page")"
                       @onclick:stopPropagation="true">
                        <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                    </a>
                }
                <button type="button"
                        class="@GetStatusDotButtonClass(path)"
                        title="@GetPathStatusTooltip(path)"
                        aria-label="@GetPathStatusTooltip(path)"
                        @onclick:stopPropagation="true">
                    <span class="@GetStatusDotClass(path)" aria-hidden="true"></span>
                    <span class="adapter-status-popover" role="tooltip">@GetPathStatusTooltip(path)</span>
                </button>
            </div>
        </div>

        @if (path.InterfaceUp || path.IsActive)
        {
            var downloadMbps = path.DownloadMbps;
            var uploadMbps = path.UploadMbps;

            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                <div class="flex items-center gap-1.5" title="@DownloadTitle(path)">
                    <i class="fas fa-arrow-down text-sm text-cyan-400"></i>
                    <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(downloadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(downloadMbps)" CssClass="font-semibold text-white" AriaLabel="@SpeedFormatter.FormatSpeed(downloadMbps)" />
                    <span class="text-xs text-slate-400">@SpeedFormatter.GetSpeedUnit(downloadMbps)</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <i class="fas fa-arrow-up text-sm text-pink-400"></i>
                    <AnimatedNumber Value="@SpeedFormatter.GetDisplayValue(uploadMbps)" Decimals="@SpeedFormatter.GetDisplayDecimals(uploadMbps)" CssClass="font-semibold text-white" AriaLabel="@SpeedFormatter.FormatSpeed(uploadMbps)" />
                    <span class="text-xs text-slate-400">@SpeedFormatter.GetSpeedUnit(uploadMbps)</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <i class="far fa-clock text-sm text-slate-400"></i>
                    @if (path.RttMs.HasValue)
                    {
                        <AnimatedNumber Value="@Math.Round(path.RttMs.Value)" Decimals="0" CssClass="font-semibold text-white" AriaLabel="@TelemetryFormatter.FormatLatency(path.RttMs)" />
                        <span class="text-xs text-slate-400">ms</span>
                    }
                    else
                    {
                        <span class="font-semibold text-slate-400" aria-label="Latency unavailable">--</span>
                    }
                </div>
                <div class="flex items-center gap-1.5">
                    <i class="fas fa-triangle-exclamation text-xs text-slate-500"></i>
                    @if (path.DisplayLossPercent.HasValue)
                    {
                        <AnimatedNumber Value="@Math.Round(path.DisplayLossPercent.Value, 1)" Decimals="@TelemetryFormatter.GetPercentDecimals(path.DisplayLossPercent.Value)" CssClass="@GetLossTextClass(path)" AriaLabel="@TelemetryFormatter.FormatPercent(path.DisplayLossPercent)" />
                        <span class="text-xs text-slate-400">loss</span>
                    }
                    else
                    {
                        <span class="font-semibold text-slate-400" aria-label="Heartbeat quality warming up">--</span>
                        <span class="text-xs text-slate-400">warming</span>
                    }
                </div>
            </div>

            @if (UiDisplayPreferences.AdapterTechnicalDetails)
            {
                <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-400">
                    <span>@RoleLabel(path)</span>
                    <span>Score @Math.Round(path.Score)</span>
                    <span>Late @TelemetryFormatter.FormatPercent(path.LatePercent)</span>
                    <span>Queue @path.QueueDepth</span>
                </div>
            }

            @if (IsStarlinkPath(path))
            {
                @StarlinkTelemetryInline(path)
            }
        }
        else
        {
            @if (UiDisplayPreferences.AdapterTechnicalDetails)
            {
                <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-400">
                    <span>@path.StateText</span>
                    <span>Score @Math.Round(path.Score)</span>
                </div>
            }
        }
    </article>;

    private int GetLatencyValue()
    {
        if (_snapshot is null || _snapshot.EffectiveRttMs <= 0)
        {
            return 0;
        }

        return (int)Math.Round(_snapshot.EffectiveRttMs);
    }

    private int? GetInternetLatencyValue()
    {
        if (!ConnectionHealthService.IsInitialized())
        {
            return null;
        }

        var (_, latency, _, _, _, _, successRate, samples, lastUpdated) =
            ConnectionHealthService.GetOverallHealth().GetSnapshot();

        if (samples <= 0 ||
            successRate <= 0 ||
            latency <= 0 ||
            latency >= 9_999 ||
            DateTime.UtcNow - lastUpdated > TimeSpan.FromSeconds(10))
        {
            return null;
        }

        return (int)Math.Round(latency);
    }

    private double? GetAnchorDownloadMbps()
    {
        var anchor = _snapshot?.ActivePaths.FirstOrDefault(path => path.IsAnchor);
        return anchor?.DownloadMbps;
    }

    private double? GetBackupDownloadMbps()
    {
        var backup = _snapshot?.ActivePaths.FirstOrDefault(path => !path.IsAnchor);
        return backup?.DownloadMbps;
    }

    private bool IsConnectionStable()
    {
        return _snapshot?.IsStable == true;
    }

    private IEnumerable<XBondPathStatsSnapshot> GetOrderedDashboardPaths()
    {
        return _snapshot is null
            ? Enumerable.Empty<XBondPathStatsSnapshot>()
            : _snapshot.ActivePaths.Concat(_snapshot.StandbyPaths);
    }

    private string GetActiveGroupGridStyle() =>
        $"grid-row: 1 / span {Math.Max(1, (_snapshot?.ActivePaths.Count ?? 0) + 1)};";

    private string GetPathGridStyle(XBondPathStatsSnapshot path)
    {
        var paths = GetOrderedDashboardPaths().ToList();
        var index = paths.FindIndex(candidate => candidate.PathId == path.PathId);
        var firstPathRow = (_snapshot?.ActivePaths.Count ?? 0) > 0 ? 2 : 1;
        return $"grid-row: {Math.Max(0, index) + firstPathRow};";
    }

    private string GetPathCardClass(XBondPathStatsSnapshot path)
    {
        var groupClass = path.IsActive ? " active-redundant-member" : "";
        var separationClass = !path.IsActive &&
                              (_snapshot?.ActivePaths.Count ?? 0) > 0 &&
                              _snapshot?.StandbyPaths.FirstOrDefault()?.PathId == path.PathId
            ? " first-nonredundant-adapter"
            : "";
        const string baseClass = "xbond-path-card rounded-xl border px-3 py-3 shadow-lg relative";
        const string interactionClass = " cursor-pointer hover:bg-slate-700/30 focus-within:ring-2 focus-within:ring-slate-400/40";

        if (!path.InterfaceUp)
        {
            return $"{baseClass}{groupClass}{separationClass} border-slate-700 bg-slate-800/45 opacity-80{interactionClass}";
        }

        if (path.InCooldown)
        {
            return $"{baseClass}{groupClass}{separationClass} border-amber-500/25 bg-amber-500/10{interactionClass}";
        }

        if (path.DisplayLossPercent is >= 10 || path.RttMs >= 180)
        {
            return $"{baseClass}{groupClass}{separationClass} border-yellow-500/25 bg-yellow-500/5{interactionClass}";
        }

        return $"{baseClass}{groupClass}{separationClass} border-slate-700 bg-slate-800/50{interactionClass}";
    }

    private static string GetStatusDotButtonClass(XBondPathStatsSnapshot path)
    {
        var statusClass = GetPathStatusKind(path) switch
        {
            "connected" => "",
            "connecting" => "adapter-status-dot-connecting",
            "disconnecting" => "",
            "disconnected" => "",
            _ => ""
        };

        return $"adapter-status-dot-button {statusClass}".Trim();
    }

    private static string GetStatusDotClass(XBondPathStatsSnapshot path)
    {
        return GetPathStatusKind(path) switch
        {
            "connected" => "adapter-status-dot adapter-status-dot-connected",
            "connecting" => "adapter-status-dot adapter-status-dot-connecting-inner",
            "disconnecting" => "adapter-status-dot adapter-status-dot-disconnecting",
            "disconnected" => "adapter-status-dot adapter-status-dot-disconnected",
            _ => "adapter-status-dot adapter-status-dot-unknown"
        };
    }

    private static string GetPathStatusKind(XBondPathStatsSnapshot path)
    {
        if (!path.InterfaceUp || path.HeartbeatFailed)
        {
            return "disconnected";
        }

        if (path.HeartbeatWarmingUp && !path.HeartbeatFailed)
        {
            return "connecting";
        }

        if (path.InCooldown || path.DisplayLossPercent is >= 10 || path.StaleAckMs is >= StaleAckWarningMs)
        {
            return "disconnecting";
        }

        if (path.IsConfigured && path.RttMs is null && !path.IsActive)
        {
            return "connecting";
        }

        return path.IsConfigured ? "connected" : "unknown";
    }

    private static string GetPathStatusTooltip(XBondPathStatsSnapshot path)
    {
        if (!path.InterfaceUp)
        {
            return "No carrier";
        }

        if (path.HeartbeatFailed)
        {
            return string.IsNullOrWhiteSpace(path.DemotionReason) ? "Path heartbeat failed after consecutive misses" : path.DemotionReason;
        }

        if (path.InCooldown)
        {
            return string.IsNullOrWhiteSpace(path.DemotionReason) ? "Cooldown" : path.DemotionReason;
        }

        if (path.HeartbeatWarmingUp)
        {
            return path.HeartbeatSampleCount > 0
                ? $"Heartbeat quality warming up ({path.HeartbeatSampleCount} samples)"
                : "Heartbeat quality warming up";
        }

        if (path.DisplayLossPercent is >= 10)
        {
            return string.IsNullOrWhiteSpace(path.DemotionReason)
                ? $"High heartbeat loss ({TelemetryFormatter.FormatPercent(path.DisplayLossPercent)})"
                : path.DemotionReason;
        }

        if (path.StaleAckMs is >= StaleAckWarningMs)
        {
            return "Heartbeat ACK is stale";
        }

        if (!path.IsConfigured)
        {
            return "Available, not in uLink";
        }

        return path.IsActive ? $"Active {RoleLabel(path)} path" : "Standby path";
    }

    private static string GetSignalBarClass(XBondPathStatsSnapshot path, int index)
    {
        var isActive = index < GetSignalStrength(path);
        var colorClass = isActive ? GetSignalColorClass(path) : "bg-slate-700";
        var animationClass = GetPathStatusKind(path) == "connecting" && isActive ? "animate-pulse" : "";

        return $"ulink-signal-bar {colorClass} {(isActive ? "ulink-signal-bar-active" : "ulink-signal-bar-inactive")} {animationClass}";
    }

    private static string GetSignalBarStyle(XBondPathStatsSnapshot path, int index)
    {
        var maximumHeight = index switch
        {
            0 => 0.5,
            1 => 0.75,
            2 => 1.0,
            3 => 1.5,
            _ => 0.5
        };
        var currentHeight = index < GetSignalStrength(path) ? maximumHeight : Math.Min(0.25, maximumHeight);

        return FormattableString.Invariant($"--signal-bar-height:{currentHeight:0.##}rem;--signal-bar-max-height:{maximumHeight:0.##}rem");
    }

    private static int GetSignalStrength(XBondPathStatsSnapshot path)
    {
        if (!path.InterfaceUp)
        {
            return 0;
        }

        if (path.InCooldown || path.HeartbeatFailed || path.DisplayLossPercent is >= 25 || path.RttMs >= 300)
        {
            return 1;
        }

        if (path.DisplayLossPercent is >= 10 || path.RttMs >= 180)
        {
            return 2;
        }

        if (path.DisplayLossPercent is >= 2 || path.RttMs >= 120)
        {
            return 3;
        }

        return 4;
    }

    private static string GetSignalColorClass(XBondPathStatsSnapshot path)
    {
        if (path.InCooldown || path.HeartbeatFailed || path.DisplayLossPercent is >= 25 || path.RttMs >= 300)
        {
            return "bg-red-400";
        }

        if (path.DisplayLossPercent is >= 10 || path.RttMs >= 180)
        {
            return "bg-yellow-400";
        }

        if (path.DisplayLossPercent is >= 2 || path.RttMs >= 120)
        {
            return "bg-yellow-300";
        }

        return path.IsActive ? "bg-emerald-300" : "bg-slate-400";
    }

    private static string GetF50SignalBarClass(XBondPathStatsSnapshot path, int index)
    {
        var isActive = index < path.CellularSignalBars.GetValueOrDefault();
        return $"ulink-cellular-signal-bar {(isActive ? "ulink-signal-bar-active bg-emerald-300" : "ulink-signal-bar-inactive bg-slate-700")}";
    }

    private static string GetF50SignalBarStyle(XBondPathStatsSnapshot path, int index)
    {
        var maximumHeight = index switch
        {
            0 => 0.375,
            1 => 0.5,
            2 => 0.625,
            3 => 0.75,
            _ => 0.875
        };
        var currentHeight = index < path.CellularSignalBars.GetValueOrDefault()
            ? maximumHeight
            : Math.Min(0.2, maximumHeight);

        return FormattableString.Invariant($"--signal-bar-height:{currentHeight:0.###}rem;--signal-bar-max-height:{maximumHeight:0.###}rem");
    }

    private static string RoleLabel(XBondPathStatsSnapshot path)
    {
        if (!path.IsConfigured)
        {
            return "not in uLink";
        }

        if (path.IsActive && !path.IsAnchor && string.Equals(path.Role, "probe", StringComparison.OrdinalIgnoreCase))
        {
            return "backup";
        }

        return path.Role;
    }

    private string? GetAdapterAdminUrl(XBondPathStatsSnapshot path)
    {
        if (IsStarlinkPath(path))
        {
            return null;
        }

        var proxy = LocalDeviceProxyService.FindAdminProxyForAdapter(path.InterfaceName, path.Name, path.Gateway);
        return proxy is null
            ? null
            : LocalDeviceProxyService.BuildLocalProxyUrl(proxy, NavigationManager.ToAbsoluteUri(NavigationManager.Uri));
    }

    private static string GetLossTextClass(XBondPathStatsSnapshot path)
    {
        if (path.DisplayLossPercent is not { } lossPercent)
        {
            return "font-semibold text-slate-400";
        }

        return lossPercent switch
        {
            >= 10 => "font-semibold text-red-300",
            >= 2 => "font-semibold text-yellow-300",
            _ => "font-semibold text-white"
        };
    }

    private static string FormatMode(string? mode)
    {
        if (string.IsNullOrWhiteSpace(mode))
        {
            return "uLink";
        }

        return mode.Replace('-', ' ');
    }

    private static string DownloadTitle(XBondPathStatsSnapshot path)
    {
        return path.DuplicateDownloadMbps > 0
            ? $"Raw adapter receive: {SpeedFormatter.FormatSpeed(path.DownloadMbps)}. Useful tunnel receive: {SpeedFormatter.FormatSpeed(path.UsefulDownloadMbps)}. Duplicate receive: {SpeedFormatter.FormatSpeed(path.DuplicateDownloadMbps)}."
            : $"Useful tunnel receive: {SpeedFormatter.FormatSpeed(path.UsefulDownloadMbps)}.";
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _refreshCts.CancelAsync();
        _timer.Dispose();

        if (_animatedUiModule != null)
        {
            try
            {
                await _animatedUiModule.InvokeVoidAsync("disableFlipList", _adapterListElement);
                await _animatedUiModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _refreshCts.Dispose();
    }
}
