            SpeedifyUploadMbps = GetTotalUpload(),
            CudyClientDownloadMbps = cached.CudyClientDownloadMbps,
            CudyClientUploadMbps = cached.CudyClientUploadMbps,
            CudyClientCount = cached.CudyClientCount,
            LocalProcessTraffic = cached.LocalProcessTraffic
        };
    }

