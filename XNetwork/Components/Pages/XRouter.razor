@page "/xrouter"
@page "/wifi"
@using System.Globalization
@using XNetwork.Models
@using XNetwork.Services
@using XNetwork.Components.Custom
@inject XRouterService XRouterService
@implements IAsyncDisposable

<PageTitle>Wifi - Ulink</PageTitle>

<div class="p-4 md:p-6">
    <div class="hidden md:block mb-6">
        <h2 class="text-3xl font-bold text-white mb-1">Wifi</h2>
        <p class="text-slate-400">Monitor Cudy clients, block internet access, and apply per-device rate limits.</p>
    </div>

    @if (!XRouterService.IsConfigured)
    {
        <div class="bg-yellow-500/10 border border-yellow-500/50 text-yellow-200 px-4 py-3 rounded-xl mb-6">
            Configure the Cudy management URL and admin password in Settings before using Wifi controls.
            @if (!string.IsNullOrWhiteSpace(XRouterService.ManagementBaseUrl))
            {
                <span class="block mt-1 text-xs text-yellow-100/80">Current URL: @XRouterService.ManagementBaseUrl</span>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
            <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-4">
                <p class="text-xs text-slate-400">Connected</p>
                <p class="text-2xl font-bold text-white"><AnimatedNumber Value="@_clients.Count" Decimals="0" AriaLabel="@($"{_clients.Count} connected clients")" /></p>
            </div>
            <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-4">
                <p class="text-xs text-slate-400">Blocked</p>
                <p class="text-2xl font-bold text-red-300"><AnimatedNumber Value="@GetBlockedClientCount()" Decimals="0" AriaLabel="@($"{GetBlockedClientCount()} blocked clients")" /></p>
            </div>
            <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-4">
                <p class="text-xs text-slate-400">Download</p>
                <p class="text-2xl font-bold text-cyan-300"><AnimatedNumber Value="@GetTotalDownloadMbps()" Decimals="@GetMbpsDecimals(GetTotalDownloadMbps())" AriaLabel="@FormatMbps(GetTotalDownloadMbps())" /> <span class="text-sm font-semibold text-cyan-200/80">Mbps</span></p>
            </div>
            <div class="bg-slate-800/50 border border-slate-700 rounded-xl p-4">
                <p class="text-xs text-slate-400">Upload</p>
                <p class="text-2xl font-bold text-pink-300"><AnimatedNumber Value="@GetTotalUploadMbps()" Decimals="@GetMbpsDecimals(GetTotalUploadMbps())" AriaLabel="@FormatMbps(GetTotalUploadMbps())" /> <span class="text-sm font-semibold text-pink-200/80">Mbps</span></p>
            </div>
        </div>

        <section class="mb-5 rounded-xl border border-slate-700 bg-slate-800/50 p-4">
            <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h3 class="text-lg font-semibold text-white">Cudy Wi-Fi Radios</h3>
                    <p class="text-xs text-slate-400">@(_wirelessStatus?.Message ?? "Reading current radio state from Cudy.")</p>
                </div>
                <button class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500/60 hover:text-white disabled:opacity-60"
                        @onclick="() => RefreshWirelessStatusAsync(false)"
                        disabled="@IsWirelessBusy">
                    @(_isWirelessRefreshing ? "Refreshing" : "Refresh radios")
                </button>
            </div>

            @if (_wirelessStatus is null)
            {
                <div class="grid gap-3 sm:grid-cols-2">
                    <div class="h-24 rounded-xl bg-slate-900/60 animate-pulse"></div>
                    <div class="h-24 rounded-xl bg-slate-900/60 animate-pulse"></div>
                </div>
            }
            else if (_wirelessStatus.IsSmartConnect)
            {
                <div class="grid gap-3 sm:grid-cols-2">
                    @RadioCard("Smart Connect", "2.4 & 5 GHz together", _wirelessStatus.TwoGEnabled, CudyWirelessBand.TwoG)
                </div>
            }
            else
            {
                <div class="grid gap-3 sm:grid-cols-2">
                    @RadioCard("2.4 GHz", "Longer range", _wirelessStatus.TwoGEnabled, CudyWirelessBand.TwoG)
                    @RadioCard("5 GHz", "Higher throughput", _wirelessStatus.FiveGEnabled, CudyWirelessBand.FiveG)
                </div>
            }
        </section>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="@_messageClass px-4 py-3 rounded-xl mb-5 text-sm">
                @_message
            </div>
        }

        <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.05fr)_minmax(22rem,0.95fr)] gap-5">
            <section class="bg-slate-800/50 border border-slate-700 rounded-xl overflow-hidden">
                <div class="flex items-center justify-between gap-3 p-4 border-b border-slate-700">
                    <div>
                        <h3 class="text-lg font-semibold text-white">Cudy Devices</h3>
                        <p class="text-xs text-slate-400">Refreshes every second from the Cudy client table.</p>
                    </div>
                    <button class="px-3 py-2 rounded-lg bg-slate-700 text-white text-sm disabled:opacity-60" @onclick="() => RefreshClientsAsync(false)" disabled="@_isRefreshing">
                        @(_isRefreshing ? "Refreshing" : "Refresh")
                    </button>
                </div>

                @if (_isLoading && !_clients.Any())
                {
                    <div class="p-4 space-y-3">
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="h-24 rounded-xl bg-slate-900/60 animate-pulse"></div>
                        }
                    </div>
                }
                else if (!_clients.Any())
                {
                    <div class="p-6 text-slate-400">No connected Cudy clients were reported.</div>
                }
                else
                {
                    <div class="divide-y divide-slate-700">
                        @foreach (var client in _clients)
                        {
                            var selected = string.Equals(_selectedMac, client.MacAddress, StringComparison.OrdinalIgnoreCase);
                            <button class="w-full text-left p-4 transition-colors @(selected ? "bg-cyan-500/10" : "hover:bg-slate-900/40")" @onclick="() => SelectClient(client.MacAddress)">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2">
                                            <span class="font-semibold text-white truncate">@client.Hostname</span>
                                            <span class="px-2 py-0.5 rounded-full text-xs @(client.InternetAllowed ? "bg-green-500/10 text-green-300" : "bg-red-500/10 text-red-300")">
                                                @(client.InternetAllowed ? "online" : "blocked")
                                            </span>
                                        </div>
                                        <p class="text-xs text-slate-400 mt-1">@client.IpAddress · @client.MacAddress</p>
                                        <p class="text-xs text-slate-500 mt-1">@client.ConnectionType @FormatSignal(client.SignalDbm) · @client.OnlineDuration</p>
                                    </div>
                                    <div class="text-right flex-shrink-0">
                                        <p class="text-sm text-cyan-300">↓ <AnimatedNumber Value="@client.DownloadMbps" Decimals="@GetMbpsDecimals(client.DownloadMbps)" AriaLabel="@FormatMbps(client.DownloadMbps)" /> <span class="text-xs text-cyan-200/70">Mbps</span></p>
                                        <p class="text-sm text-pink-300">↑ <AnimatedNumber Value="@client.UploadMbps" Decimals="@GetMbpsDecimals(client.UploadMbps)" AriaLabel="@FormatMbps(client.UploadMbps)" /> <span class="text-xs text-pink-200/70">Mbps</span></p>
                                    </div>
                                </div>
                            </button>
                        }
                    </div>
                }
            </section>

            <section class="hidden xl:block bg-slate-800/50 border border-slate-700 rounded-xl p-4 min-h-[28rem]">
                @if (SelectedClient is null)
                {
                    <div class="h-full flex items-center justify-center text-center text-slate-400">
                        Select a device to view throughput history and controls.
                    </div>
                }
                else
                {
                    var client = SelectedClient;
                    <WifiClientDetails Client="client"
                                       HistorySampleCount="@GetHistory(client.MacAddress).Count"
                                       DownloadPolyline="@BuildPolyline(client.MacAddress, true)"
                                       UploadPolyline="@BuildPolyline(client.MacAddress, false)"
                                       DownloadLimit="@GetLimitDraft(client.MacAddress).DownloadMbps"
                                       UploadLimit="@GetLimitDraft(client.MacAddress).UploadMbps"
                                       IsBusy="@IsBusy(client.MacAddress)"
                                       OnToggleInternet="() => ToggleInternetAsync(client)"
                                       OnApplyRateLimit="() => ApplyRateLimitAsync(client)"
                                       OnClearRateLimit="() => ClearRateLimitAsync(client)"
                                       OnDownloadLimitChanged="value => SetDownloadDraft(client.MacAddress, value)"
                                       OnUploadLimitChanged="value => SetUploadDraft(client.MacAddress, value)" />
                }
            </section>
        </div>
    }
</div>

@if (SelectedClient is not null)
{
    var sheetClient = SelectedClient;
    <ActionSheet IsOpen="_showClientDetailsSheet"
                 Title="@sheetClient.Hostname"
                 Description="@($"{sheetClient.IpAddress} · {sheetClient.ConnectionType}")"
                 CloseLabel="Close Wifi device details"
                 BackdropClass="xl:hidden"
                 OnClose="CloseClientDetailsSheet">
        <WifiClientDetails Client="sheetClient"
                           HistorySampleCount="@GetHistory(sheetClient.MacAddress).Count"
                           DownloadPolyline="@BuildPolyline(sheetClient.MacAddress, true)"
                           UploadPolyline="@BuildPolyline(sheetClient.MacAddress, false)"
                           DownloadLimit="@GetLimitDraft(sheetClient.MacAddress).DownloadMbps"
                           UploadLimit="@GetLimitDraft(sheetClient.MacAddress).UploadMbps"
                           IsBusy="@IsBusy(sheetClient.MacAddress)"
                           OnToggleInternet="() => ToggleInternetAsync(sheetClient)"
                           OnApplyRateLimit="() => ApplyRateLimitAsync(sheetClient)"
                           OnClearRateLimit="() => ClearRateLimitAsync(sheetClient)"
                           OnDownloadLimitChanged="value => SetDownloadDraft(sheetClient.MacAddress, value)"
                           OnUploadLimitChanged="value => SetUploadDraft(sheetClient.MacAddress, value)" />
    </ActionSheet>
}

@code {
    private const int MaxHistoryPoints = 60;
    private static readonly TimeSpan ClientRefreshTimeout = TimeSpan.FromSeconds(8);
    private readonly Dictionary<string, List<ThroughputPoint>> _history = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, LimitDraft> _limitDrafts = new(StringComparer.OrdinalIgnoreCase);
    private List<XRouterClient> _clients = new();
    private CancellationTokenSource? _cts;
    private Timer? _refreshTimer;
    private string? _selectedMac;
    private string? _busyMac;
    private string? _message;
    private string _messageClass = "bg-slate-700 text-slate-100";
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _isWirelessRefreshing;
    private bool _showClientDetailsSheet;
    private int _refreshInProgress;
    private CudyWirelessStatus? _wirelessStatus;
    private CudyWirelessBand? _wirelessBusyBand;
    private DateTime _lastWirelessRefreshUtc = DateTime.MinValue;

    private XRouterClient? SelectedClient => _clients.FirstOrDefault(client => string.Equals(client.MacAddress, _selectedMac, StringComparison.OrdinalIgnoreCase));
    private bool IsWirelessBusy => _isWirelessRefreshing || _wirelessBusyBand is not null;

    protected override Task OnInitializedAsync()
    {
        _cts = new CancellationTokenSource();
        _refreshTimer = new Timer(_ => _ = InvokeAsync(() => RefreshClientsAsync(true)), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        _ = InvokeAsync(() => RefreshClientsAsync(false));
        _ = InvokeAsync(() => RefreshWirelessStatusAsync(false));
        return Task.CompletedTask;
    }

    private async Task RefreshClientsAsync(bool background)
    {
        if (!XRouterService.IsConfigured || (_cts?.IsCancellationRequested ?? true))
        {
            _isLoading = false;
            return;
        }

        if (Interlocked.Exchange(ref _refreshInProgress, 1) == 1)
        {
            return;
        }

        _isRefreshing = true;
        if (!background)
        {
            _isLoading = true;
        }

        try
        {
            using var refreshCts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
            refreshCts.CancelAfter(ClientRefreshTimeout);

            var clients = await XRouterService.GetClientsAsync(refreshCts.Token);
            _clients = clients.ToList();
            foreach (var client in _clients)
            {
                AddHistoryPoint(client);
                _ = GetLimitDraft(client.MacAddress);
            }

            if (_selectedMac is null || _clients.All(client => !string.Equals(client.MacAddress, _selectedMac, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedMac = _clients.FirstOrDefault()?.MacAddress;
                _showClientDetailsSheet = false;
            }

            _message = null;
            await RefreshWirelessStatusIfDueAsync();
        }
        catch (OperationCanceledException) when (_cts?.IsCancellationRequested ?? true)
        {
        }
        catch (OperationCanceledException)
        {
            var url = XRouterService.ManagementBaseUrl ?? "the configured Cudy URL";
            ShowMessage($"Could not refresh Wifi clients: Cudy management at {url} did not respond within 8 seconds.", isError: true);
        }
        catch (Exception ex)
        {
            ShowMessage($"Could not refresh Wifi clients: {ex.Message}", isError: true);
        }
        finally
        {
            _isRefreshing = false;
            _isLoading = false;
            Interlocked.Exchange(ref _refreshInProgress, 0);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectClient(string macAddress)
    {
        _selectedMac = macAddress;
        _showClientDetailsSheet = true;
    }

    private void CloseClientDetailsSheet()
    {
        _showClientDetailsSheet = false;
    }

    private async Task ToggleInternetAsync(XRouterClient client)
    {
        await RunClientActionAsync(client, async () =>
        {
            var allowed = !client.InternetAllowed;
            await XRouterService.SetInternetAccessAsync(client, allowed, _cts?.Token ?? CancellationToken.None);
            ShowMessage($"{client.Hostname} internet access {(allowed ? "enabled" : "blocked")}.", isError: false);
        });
    }

    private async Task ApplyRateLimitAsync(XRouterClient client)
    {
        var draft = GetLimitDraft(client.MacAddress);
        if (!int.TryParse(draft.DownloadMbps, NumberStyles.Integer, CultureInfo.InvariantCulture, out var download) || download <= 0 ||
            !int.TryParse(draft.UploadMbps, NumberStyles.Integer, CultureInfo.InvariantCulture, out var upload) || upload <= 0)
        {
            ShowMessage("Enter positive whole-number Mbps values for both download and upload.", isError: true);
            return;
        }

        await RunClientActionAsync(client, async () =>
        {
            await XRouterService.SetRateLimitAsync(client, enabled: true, download, upload, _cts?.Token ?? CancellationToken.None);
            ShowMessage($"Applied {download}/{upload} Mbps limit to {client.Hostname}.", isError: false);
        });
    }

    private async Task ClearRateLimitAsync(XRouterClient client)
    {
        await RunClientActionAsync(client, async () =>
        {
            await XRouterService.SetRateLimitAsync(client, enabled: false, null, null, _cts?.Token ?? CancellationToken.None);
            ShowMessage($"Removed rate limit for {client.Hostname}.", isError: false);
        });
    }

    private async Task RunClientActionAsync(XRouterClient client, Func<Task> action)
    {
        _busyMac = client.MacAddress;
        try
        {
            await action();
            await RefreshClientsAsync(false);
        }
        catch (Exception ex)
        {
            ShowMessage($"Wifi action failed: {ex.Message}", isError: true);
        }
        finally
        {
            _busyMac = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RefreshWirelessStatusIfDueAsync()
    {
        if (DateTime.UtcNow - _lastWirelessRefreshUtc < TimeSpan.FromSeconds(15))
        {
            return;
        }

        await RefreshWirelessStatusAsync(background: true);
    }

    private async Task RefreshWirelessStatusAsync(bool background)
    {
        if (!XRouterService.IsConfigured || (_cts?.IsCancellationRequested ?? true))
        {
            return;
        }

        if (!background)
        {
            _isWirelessRefreshing = true;
            await InvokeAsync(StateHasChanged);
        }

        try
        {
            using var refreshCts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
            refreshCts.CancelAfter(ClientRefreshTimeout);
            _wirelessStatus = await XRouterService.GetWirelessStatusAsync(refreshCts.Token);
            _lastWirelessRefreshUtc = DateTime.UtcNow;
        }
        catch (Exception ex) when (ex is not OperationCanceledException || !(_cts?.IsCancellationRequested ?? false))
        {
            _wirelessStatus = new CudyWirelessStatus
            {
                IsConfigured = XRouterService.IsConfigured,
                Message = $"Could not read Cudy radio state: {ex.Message}",
                UpdatedUtc = DateTime.UtcNow
            };
        }
        finally
        {
            if (!background)
            {
                _isWirelessRefreshing = false;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ToggleWirelessBandAsync(CudyWirelessBand band, bool? currentEnabled)
    {
        _wirelessBusyBand = band;
        try
        {
            var enabled = currentEnabled != true;
            await XRouterService.SetWirelessBandEnabledAsync(band, enabled, _cts?.Token ?? CancellationToken.None);
            ShowMessage($"{FormatBandLabel(band)} radio turned {(enabled ? "on" : "off")}.", isError: false);
            await RefreshWirelessStatusAsync(background: false);
        }
        catch (Exception ex)
        {
            ShowMessage($"Cudy radio action failed: {ex.Message}", isError: true);
        }
        finally
        {
            _wirelessBusyBand = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsBusy(string macAddress)
    {
        return string.Equals(_busyMac, macAddress, StringComparison.OrdinalIgnoreCase);
    }

    private void AddHistoryPoint(XRouterClient client)
    {
        var points = GetHistory(client.MacAddress);
        points.Add(new ThroughputPoint(DateTime.UtcNow, client.DownloadMbps, client.UploadMbps));
        while (points.Count > MaxHistoryPoints)
        {
            points.RemoveAt(0);
        }
    }

    private List<ThroughputPoint> GetHistory(string macAddress)
    {
        if (!_history.TryGetValue(macAddress, out var points))
        {
            points = new List<ThroughputPoint>();
            _history[macAddress] = points;
        }

        return points;
    }

    private string BuildPolyline(string macAddress, bool download)
    {
        var points = GetHistory(macAddress);
        if (points.Count < 2)
        {
            return "";
        }

        var max = Math.Max(0.1, points.Max(point => Math.Max(point.DownloadMbps, point.UploadMbps)));
        const double left = 8;
        const double top = 12;
        const double width = 304;
        const double height = 112;
        var coords = points.Select((point, index) =>
        {
            var value = download ? point.DownloadMbps : point.UploadMbps;
            var x = left + width * index / (points.Count - 1);
            var y = top + height - value / max * height;
            return FormattableString.Invariant($"{x:F1},{y:F1}");
        });

        return string.Join(" ", coords);
    }

    private LimitDraft GetLimitDraft(string macAddress)
    {
        if (!_limitDrafts.TryGetValue(macAddress, out var draft))
        {
            draft = new LimitDraft();
            _limitDrafts[macAddress] = draft;
        }

        return draft;
    }

    private void SetDownloadDraft(string macAddress, string? value)
    {
        GetLimitDraft(macAddress).DownloadMbps = value?.Trim() ?? "";
    }

    private void SetUploadDraft(string macAddress, string? value)
    {
        GetLimitDraft(macAddress).UploadMbps = value?.Trim() ?? "";
    }

    private void ShowMessage(string message, bool isError)
    {
        _message = message;
        _messageClass = isError
            ? "bg-red-500/10 border border-red-500/40 text-red-200"
            : "bg-green-500/10 border border-green-500/40 text-green-200";
    }

    private static string FormatMbps(double value)
    {
        return value >= 10 ? $"{value:F1} Mbps" : $"{value:F2} Mbps";
    }

    private RenderFragment RadioCard(string title, string subtitle, bool? enabled, CudyWirelessBand band) => @<article class="rounded-xl border border-slate-800 bg-slate-950/50 p-4">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="flex items-center gap-2">
                    <span class="@GetRadioDotClass(enabled, band)" aria-hidden="true"></span>
                    <h4 class="font-semibold text-white">@title</h4>
                </div>
                <p class="mt-1 text-xs text-slate-400">@subtitle</p>
                <p class="mt-2 text-sm font-semibold @GetRadioTextClass(enabled, band)">@FormatRadioState(enabled, band)</p>
            </div>
            <button class="@GetRadioButtonClass(enabled)"
                    disabled="@IsWirelessBusy"
                    @onclick="() => ToggleWirelessBandAsync(band, enabled)">
                @(enabled == true ? "Turn off" : "Turn on")
            </button>
        </div>
    </article>;

    private string FormatRadioState(bool? enabled, CudyWirelessBand band)
    {
        if (_wirelessBusyBand == band)
        {
            return "Applying";
        }

        return enabled switch
        {
            true => "On",
            false => "Off",
            _ => "Unknown"
        };
    }

    private static string FormatBandLabel(CudyWirelessBand band) => band == CudyWirelessBand.TwoG ? "2.4 GHz" : "5 GHz";

    private string GetRadioDotClass(bool? enabled, CudyWirelessBand band)
    {
        var color = _wirelessBusyBand == band
            ? "bg-amber-300"
            : enabled switch
            {
                true => "bg-emerald-400",
                false => "bg-slate-500",
                _ => "bg-amber-300"
            };

        return $"inline-block h-2.5 w-2.5 rounded-full {color}";
    }

    private string GetRadioTextClass(bool? enabled, CudyWirelessBand band)
    {
        if (_wirelessBusyBand == band)
        {
            return "text-amber-200";
        }

        return enabled switch
        {
            true => "text-emerald-200",
            false => "text-slate-300",
            _ => "text-amber-200"
        };
    }

    private static string GetRadioButtonClass(bool? enabled) => enabled == true
        ? "rounded-lg border border-rose-500/35 bg-rose-500/10 px-3 py-2 text-sm font-semibold text-rose-100 hover:bg-rose-500/20 disabled:opacity-60"
        : "rounded-lg border border-emerald-500/35 bg-emerald-500/10 px-3 py-2 text-sm font-semibold text-emerald-100 hover:bg-emerald-500/20 disabled:opacity-60";

    private int GetBlockedClientCount()
    {
        return _clients.Count(client => !client.InternetAllowed);
    }

    private double GetTotalDownloadMbps()
    {
        return _clients.Sum(client => client.DownloadMbps);
    }

    private double GetTotalUploadMbps()
    {
        return _clients.Sum(client => client.UploadMbps);
    }

    private static int GetMbpsDecimals(double value)
    {
        return value >= 10 ? 1 : 2;
    }

    private static string FormatSignal(int? signalDbm)
    {
        return signalDbm.HasValue ? $"· {signalDbm.Value} dBm" : "";
    }

    public async ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        if (_cts != null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
        }
    }

    private sealed record ThroughputPoint(DateTime Timestamp, double DownloadMbps, double UploadMbps);

    private sealed class LimitDraft
    {
        public string DownloadMbps { get; set; } = "";
        public string UploadMbps { get; set; } = "";
    }
}
