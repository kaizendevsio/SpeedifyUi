@page "/settings"
@using XNetwork.Components.Custom
@using XNetwork.Models
@using XNetwork.Services
@using XNetwork.Utils
@implements IAsyncDisposable
@inject XBondTrafficEngineService XBondTrafficEngineService
@inject XBondStatusService XBondStatusService
@inject XBondClientConfigService XBondClientConfigService
@inject XBondMssClampService MssClampService
@inject NetworkMonitorService NetworkMonitorService
@inject NetworkMonitorSettingsStore NetworkMonitorSettingsStore
@inject WifiService WifiService
@inject CudyApControlService CudyApControlService
@inject CudyAdminPasswordStore CudyAdminPasswordStore
@inject CudyLuciClient CudyLuciClient
@inject LocalDeviceProxyService LocalDeviceProxyService
@inject F50ModemRecoveryService F50ModemRecoveryService
@inject XBondClientWatchdogService XBondClientWatchdogService
@inject TrafficBypassService TrafficBypassService
@inject UiDisplayPreferences UiDisplayPreferences
@inject UiDisplayPreferencesStore UiDisplayPreferencesStore
@inject AdapterIdentitySettings AdapterIdentitySettings
@inject AdapterIdentitySettingsStore AdapterIdentitySettingsStore
@inject AdapterIdentityService AdapterIdentityService
@inject WifiControlService WifiControlService
@inject NavigationManager NavigationManager

<PageTitle>Settings - uLink</PageTitle>

<div class="settings-page pb-28 md:pb-10">
    <section class="settings-hero">
        <div>
            <p class="settings-eyebrow">Control Center</p>
            <h1 class="settings-title">Settings</h1>
            <p class="settings-subtitle">Tune uLink, adapter membership, Wi-Fi, Cudy management, and router safeguards.</p>
        </div>
        <div class="settings-hero-badges">
            <span class="settings-pill settings-pill-green">@ServiceStateLabel</span>
            <span class="settings-pill settings-pill-blue">@FormatPolicy(_policy)</span>
            <span class="settings-pill settings-pill-muted">@ConfiguredAdapterCount in uLink</span>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="rounded-lg border border-cyan-500/25 bg-cyan-500/10 p-3 text-sm text-cyan-100">@_message</div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="rounded-lg border border-rose-500/25 bg-rose-500/10 p-3 text-sm text-rose-100">@_error</div>
    }

    <div class="settings-layout">
        <div class="settings-accordion-stack">
    <Accordion Title="Appearance" IsExpanded="_appearanceExpanded" OnToggle="(expanded) => _appearanceExpanded = expanded" BadgeText="@AppearanceBadge">
        <div class="space-y-4 pt-2">
            <div>
                <h2 class="text-lg font-semibold text-white">Appearance</h2>
                <p class="mt-1 text-sm text-slate-400">Choose how much operational detail appears on the dashboard.</p>
            </div>
            <label class="settings-toggle-row">
                <span class="min-w-0">
                    <span class="block text-sm font-semibold text-white">Adapter technical details</span>
                    <span class="mt-1 block text-xs leading-relaxed text-slate-400">Show role, scheduler score, late packets, and queue depth on adapter cards.</span>
                </span>
                <input type="checkbox"
                       class="settings-toggle-input"
                       checked="@UiDisplayPreferences.AdapterTechnicalDetails"
                       disabled="@_appearanceBusy"
                       @onchange="ToggleAdapterTechnicalDetailsAsync" />
            </label>
            <label class="settings-toggle-row">
                <span class="min-w-0">
                    <span class="block text-sm font-semibold text-white">Connection mode</span>
                    <span class="mt-1 block text-xs leading-relaxed text-slate-400">Show the current reliable, balanced, or fast mode on the dashboard connection card.</span>
                </span>
                <input type="checkbox"
                       class="settings-toggle-input"
                       checked="@UiDisplayPreferences.ShowConnectionMode"
                       disabled="@_appearanceBusy"
                       @onchange="ToggleConnectionModeAsync" />
            </label>
        </div>
    </Accordion>

    <Accordion Title="uLink Tunnel" IsExpanded="_tunnelExpanded" OnToggle="(expanded) => _tunnelExpanded = expanded" BadgeText="@ServiceStateLabel">
        <div class="space-y-4 pt-2">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">uLink Tunnel</h2>
                <p class="mt-1 text-sm text-slate-400">@(_trafficStatus?.Message ?? "Loading service status")</p>
            </div>
            <span class="@ServicePillClass">@ServiceStateLabel</span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            @Info("Service", ServiceStateLabel)
            @Info("Boot", _trafficStatus?.ClientServiceEnableState ?? "unknown")
            @Info("Tunnel", _xbondStatus?.Running == true ? "Available" : "Unavailable")
            @Info("IPv6", "Unsupported")
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
            <button type="button" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStart ?? false) || _busy)" @onclick="StartTunnelAsync">
                Start
            </button>
            <button type="button" class="rounded-lg bg-rose-500 px-4 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStop ?? false) || _busy)" @onclick="StopTunnelAsync">
                Stop
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanEnableAtBoot ?? false) || _busy)" @onclick="EnableBootAsync">
                Enable boot
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanDisableAtBoot ?? false) || _busy)" @onclick="DisableBootAsync">
                Disable boot
            </button>
            <button type="button" class="rounded-lg border border-cyan-500/35 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-100 hover:bg-cyan-500/20" @onclick="OpenXBondDiagnostics">
                uLink diagnostics
            </button>
        </div>
        </div>
    </Accordion>

    <Accordion Title="uLink Policy" IsExpanded="_policyExpanded" OnToggle="(expanded) => _policyExpanded = expanded" BadgeText="@FormatPolicy(_policy)">
        <div class="space-y-4 pt-2">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">uLink Policy</h2>
                <p class="mt-1 text-sm text-slate-400">Choose how aggressively uLink duplicates packets across backup paths.</p>
            </div>
            <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-100">
                @FormatPolicy(_policy)
            </span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Policy</span>
                <select class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_policy">
                    <option value="balanced">Balanced</option>
                    <option value="reliable">Reliable</option>
                    <option value="fast">Fast</option>
                </select>
                <span class="mt-2 block text-xs leading-relaxed text-slate-400">@PolicyShortDescription(_policy)</span>
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Small packet</span>
                <input type="number" min="64" max="1500" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_interactivePacketThresholdBytes" />
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Anchor loss %</span>
                <input type="number" min="0" max="100" step="0.1" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_duplicateLossThresholdPercent" />
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Backup max loss %</span>
                <input type="number" min="0" max="100" step="0.1" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_backupLossDisableThresholdPercent" />
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Reorder hold</span>
                <input type="number" min="0" max="250" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_reorderHoldMs" />
            </label>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            <button type="button" class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_busy" @onclick="SaveXBondPolicyAsync">
                Save policy
            </button>
            <p class="text-xs text-slate-500">@PolicySaveHint(_policy)</p>
        </div>
        </div>
    </Accordion>

    <Accordion Title="uLink Adapters" IsExpanded="_adaptersExpanded" OnToggle="(expanded) => _adaptersExpanded = expanded" BadgeText="@ConfiguredAdapterBadge">
        <div class="space-y-4 pt-2">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">uLink Adapters</h2>
                <p class="mt-1 text-sm text-slate-400">Add or remove connected WAN and Wi-Fi adapters from the uLink tunnel without editing client.toml.</p>
            </div>
            <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-100">
                @ConfiguredAdapterCount in uLink
            </span>
        </div>

        @if (_xbondAdapterStatus?.HasError == true)
        {
            <div class="mt-4 rounded-lg border border-rose-500/25 bg-rose-500/10 p-3 text-sm text-rose-100">@_xbondAdapterStatus.Error</div>
        }
        else if (_xbondAdapterStatus?.Adapters.Count > 0)
        {
            <div class="mt-4 grid gap-3">
                @foreach (var adapter in _xbondAdapterStatus.Adapters)
                {
                    <article class="@AdapterConfigCardClass(adapter)">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="truncate font-semibold text-white">@adapter.Name</h3>
                                    <span class="@AdapterConfigPillClass(adapter)">@AdapterConfigLabel(adapter)</span>
                                </div>
                                <p class="mt-1 break-all text-sm text-slate-400">@adapter.InterfaceName</p>
                                <p class="mt-2 text-xs text-slate-500">@AdapterConfigDetail(adapter)</p>
                            </div>
                            <button type="button"
                                    class="@AdapterConfigButtonClass(adapter)"
                                    disabled="@(!CanToggleXBondAdapter(adapter))"
                                    @onclick="() => ToggleXBondAdapterAsync(adapter)">
                                @AdapterConfigButtonText(adapter)
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-400">
                No connected ethernet or Wi-Fi adapters were discovered.
            </div>
        }
        </div>
    </Accordion>

    @if (OperatingSystem.IsLinux())
    {
        <Accordion Title="Router Wi-Fi" IsExpanded="_wifiExpanded" OnToggle="(expanded) => _wifiExpanded = expanded" BadgeText="@GetWifiBadge()">
            <div class="space-y-4 pt-2">
                <div class="rounded-xl border border-slate-700 bg-slate-900/60 p-4">
                    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                        <div>
                            <div class="flex items-center gap-2 font-semibold text-white">
                                <i class="fas fa-wifi text-cyan-300"></i>
                                <span>@FormatWifiStatusTitle()</span>
                            </div>
                            <p class="mt-1 text-sm text-slate-400">@FormatWifiStatusDetail()</p>
                        </div>
                        <button type="button"
                                class="inline-flex items-center justify-center gap-2 rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500/60 hover:text-white disabled:opacity-50"
                                disabled="@_isWifiBusy"
                                @onclick="RefreshWifiStatusAsync">
                            <i class="fas fa-sync @(_isWifiRefreshing ? "fa-spin" : "")"></i>
                            Refresh
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_wifiMessage))
                {
                    <div class="rounded-lg border border-cyan-500/25 bg-cyan-500/10 p-3 text-sm text-cyan-100">@_wifiMessage</div>
                }

                <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950/50">
                    <div class="border-b border-slate-800 px-4 py-3">
                        <h4 class="text-sm font-semibold text-white">Adapter Wi-Fi access</h4>
                        <p class="text-xs text-slate-500">
                            Turn an adapter off to stop the router joining any Wi-Fi network with it. Useful when a wired
                            uplink already reaches the same network.
                        </p>
                    </div>
                    @if (_wifiInterfaces.Count == 0)
                    {
                        <div class="p-4 text-sm text-slate-400">No Wi-Fi adapters were detected.</div>
                    }
                    else
                    {
                        @foreach (var adapter in _wifiInterfaces)
                        {
                            var control = GetWifiControlFor(adapter.InterfaceName);
                            <div class="flex items-start justify-between gap-4 border-b border-slate-800/70 px-4 py-3 last:border-b-0">
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-white">@adapter.DisplayName</p>
                                    <p class="mt-1 text-xs @(string.IsNullOrWhiteSpace(control?.LastError) ? "text-slate-500" : "text-rose-200")">
                                        @WifiControlStateText(adapter.InterfaceName)
                                    </p>
                                </div>
                                <label class="flex flex-shrink-0 items-center gap-2 text-xs text-slate-400">
                                    <span>Allow</span>
                                    <input type="checkbox"
                                           class="h-5 w-5 accent-cyan-400"
                                           disabled="@_wifiControlBusy"
                                           checked="@(!WifiControlService.IsDisabled(adapter.InterfaceName))"
                                           @onchange="args => ToggleWifiAdapterAsync(adapter.InterfaceName, args.Value is true)" />
                                </label>
                            </div>
                        }
                    }
                </div>

                <div class="grid gap-4 md:grid-cols-2">
                    <label class="block">
                        <span class="text-sm font-medium text-white">Wi-Fi Adapter</span>
                        @if (_wifiInterfaces.Count == 0)
                        {
                            <input type="text"
                                   class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                                   @bind="_wifiInterface" />
                        }
                        else
                        {
                            <select class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                                    @bind="_wifiInterface"
                                    @bind:after="OnWifiInterfaceChangedAsync">
                                @foreach (var adapter in _wifiInterfaces)
                                {
                                    <option value="@adapter.InterfaceName">@adapter.DisplayName</option>
                                }
                            </select>
                        }
                        <span class="mt-1 block text-xs text-slate-500">Built-in and USB Wi-Fi adapters discovered by NetworkManager.</span>
                    </label>

                    <label class="block">
                        <span class="text-sm font-medium text-white">Selected Network</span>
                        <input type="text"
                               class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                               placeholder="Choose from scan or type SSID"
                               @bind="_wifiSsid" />
                    </label>
                </div>

                <div class="overflow-hidden rounded-lg border border-slate-800 bg-slate-950/50">
                    <div class="flex items-center justify-between gap-3 border-b border-slate-800 px-4 py-3">
                        <div>
                            <h4 class="text-sm font-semibold text-white">Nearby Wi-Fi</h4>
                            <p class="text-xs text-slate-500">Choose the network for the selected Raspberry Pi Wi-Fi adapter.</p>
                        </div>
                        <button type="button"
                                class="inline-flex items-center justify-center gap-2 rounded-lg bg-slate-800 px-3 py-2 text-sm font-semibold text-slate-200 hover:bg-slate-700 disabled:opacity-50"
                                disabled="@(_isWifiBusy || WifiControlService.IsDisabled(_wifiInterface))"
                                @onclick="ScanWifiNetworksAsync">
                            <i class="fas fa-radar @(_isWifiScanning ? "fa-spin" : "")"></i>
                            Scan
                        </button>
                    </div>

                    @if (_isWifiScanning)
                    {
                        <div class="p-4 text-sm text-slate-400">Scanning nearby networks...</div>
                    }
                    else if (_wifiNetworks.Count == 0)
                    {
                        <div class="p-4 text-sm text-slate-400">No visible Wi-Fi networks loaded yet. Tap Scan to refresh nearby networks.</div>
                    }
                    else
                    {
                        <div class="max-h-80 divide-y divide-slate-800 overflow-y-auto">
                            @foreach (var network in _wifiNetworks)
                            {
                                var selected = string.Equals(_wifiSsid, network.Ssid, StringComparison.Ordinal);
                                <button type="button"
                                        class="w-full px-4 py-3 text-left transition-colors @(selected ? "bg-cyan-500/10" : "hover:bg-slate-800/70")"
                                        @onclick="() => SelectWifiNetwork(network)">
                                    <div class="flex items-center justify-between gap-3">
                                        <div class="flex min-w-0 items-center gap-3">
                                            <i class="fas fa-wifi @GetWifiSignalClass(network.Signal)"></i>
                                            <div class="min-w-0">
                                                <div class="truncate font-semibold text-white">@network.Ssid</div>
                                                <div class="text-xs text-slate-500">@FormatWifiNetworkDetail(network)</div>
                                            </div>
                                        </div>
                                        <span class="shrink-0 text-xs font-semibold @(selected ? "text-cyan-300" : "text-slate-500")">
                                            @(selected ? "Selected" : "Choose")
                                        </span>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="grid items-end gap-4 md:grid-cols-[1fr_auto]">
                    <label class="block">
                        <span class="text-sm font-medium text-white">Password @FormatSelectedWifiPasswordHint()</span>
                        <input type="password"
                               class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                               placeholder="Wi-Fi password"
                               autocomplete="new-password"
                               @bind="_wifiPassword" />
                    </label>
                    <button type="button"
                            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-cyan-400 px-4 py-2.5 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40 sm:w-auto"
                            disabled="@(_isWifiBusy || string.IsNullOrWhiteSpace(_wifiSsid) || WifiControlService.IsDisabled(_wifiInterface))"
                            @onclick="ConnectOnboardWifiAsync">
                        @if (_isWifiConnecting)
                        {
                            <i class="fas fa-spinner fa-spin"></i>
                            <span>Connecting...</span>
                        }
                        else
                        {
                            <i class="fas fa-wifi"></i>
                            <span>Connect</span>
                        }
                    </button>
                </div>
            </div>
        </Accordion>
    }

    <Accordion Title="Cudy Management" IsExpanded="_cudyExpanded" OnToggle="(expanded) => _cudyExpanded = expanded" BadgeText="@CudyStatusLabel">
        <div class="space-y-4 pt-2">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">Cudy Management</h2>
                <p class="mt-1 text-sm text-slate-400">Configure the Cudy admin endpoint used by the Wifi page and AP automation.</p>
            </div>
            <span class="@CudyStatusPillClass">@CudyStatusLabel</span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            @Info("Management URL", string.IsNullOrWhiteSpace(_cudySettings.ManagementBaseUrl) ? "Not configured" : _cudySettings.ManagementBaseUrl)
            @Info("Admin password", CudyPasswordStatus)
            @Info("Home Wi-Fi", FormatCudyHomeWifi())
            @Info("Last status", _cudyStatus.Message)
        </div>

        @if (!string.IsNullOrWhiteSpace(_cudyLocalMessage))
        {
            <div class="@_cudyLocalMessageClass mt-4 rounded-lg border p-3 text-sm">@_cudyLocalMessage</div>
        }

        <div class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="block">
                <span class="text-sm font-medium text-white">Cudy Management URL</span>
                <input type="text"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="https://192.168.145.231/"
                       @bind="_cudySettings.ManagementBaseUrl" />
                <span class="mt-1 block text-xs text-slate-500">Use the Cudy admin host reachable from this router. Do not include credentials in the URL.</span>
            </label>

            <label class="block">
                <span class="text-sm font-medium text-white">Cudy Admin Password</span>
                <input type="password"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="@CudyPasswordPlaceholder"
                       autocomplete="new-password"
                       @bind="_cudyAdminPasswordInput" />
                <span class="mt-1 block text-xs text-slate-500">Leave blank to keep the current local runtime password.</span>
            </label>

            <label class="block">
                <span class="text-sm font-medium text-white">Wi-Fi Scan Interface</span>
                @if (_wifiInterfaces.Count == 0)
                {
                    <input type="text"
                           class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                           placeholder="wlan0"
                           @bind="_cudySettings.WifiInterface" />
                }
                else
                {
                    <select class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                            @bind="_cudySettings.WifiInterface">
                        @foreach (var adapter in _wifiInterfaces)
                        {
                            <option value="@adapter.InterfaceName">@adapter.DisplayName</option>
                        }
                    </select>
                }
                <span class="mt-1 block text-xs text-slate-500">Used for trusted-home Wi-Fi detection.</span>
            </label>

            <label class="block">
                <span class="text-sm font-medium text-white">Request Timeout</span>
                <input type="number"
                       min="3"
                       max="60"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       @bind="_cudySettings.RequestTimeoutSeconds" />
                <span class="mt-1 block text-xs text-slate-500">Wifi page refreshes still use a visible 8 second timeout.</span>
            </label>
        </div>

        <div class="mt-5 grid gap-4 md:grid-cols-2">
            <label class="block">
                <span class="text-sm font-medium text-white">Trusted Home SSID</span>
                <input type="text"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="Trusted home Wi-Fi"
                       @bind="_cudySettings.HomeSsid" />
            </label>

            <label class="block">
                <span class="text-sm font-medium text-white">Trusted Home BSSID</span>
                <input type="text"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="Optional MAC address"
                       @bind="_cudySettings.HomeBssid" />
            </label>
        </div>

        <div class="mt-5 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
            <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                <span>Enable AP automation</span>
                <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_cudySettings.Enabled" />
            </label>
            <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                <span>Control 2.4 GHz</span>
                <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_cudySettings.Disable2G" />
            </label>
            <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                <span>Control 5 GHz</span>
                <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_cudySettings.Disable5G" />
            </label>
            <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                <span>Re-enable when missing</span>
                <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_cudySettings.ReEnableWhenHomeMissing" />
            </label>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
            <button type="button" class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_cudyBusy" @onclick="SaveCudySettingsAsync">
                Save Cudy settings
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_cudyBusy" @onclick="TestCudyManagementAsync">
                Test Cudy login
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_cudyBusy" @onclick="ScanCudyWifiAsync">
                Scan home Wi-Fi
            </button>
        </div>

        @if (_cudyWifiNetworks.Count > 0)
        {
            <div class="mt-5 overflow-hidden rounded-lg border border-slate-800 bg-slate-950/50">
                <div class="border-b border-slate-800 px-4 py-3 text-sm font-semibold text-white">Nearby Wi-Fi</div>
                <div class="max-h-72 divide-y divide-slate-800 overflow-y-auto">
                    @foreach (var network in _cudyWifiNetworks)
                    {
                        var selected = IsCudyHomeNetworkSelected(network);
                        <button type="button"
                                class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left transition-colors @(selected ? "bg-cyan-500/10" : "hover:bg-slate-900")"
                                @onclick="() => SelectCudyHomeNetwork(network)">
                            <span class="min-w-0">
                                <span class="block truncate font-semibold text-white">@network.Ssid</span>
                                <span class="block truncate text-xs text-slate-500">@FormatCudyNetworkDetail(network)</span>
                            </span>
                            <span class="shrink-0 text-xs font-semibold @(selected ? "text-cyan-300" : "text-slate-500")">@(selected ? "Selected" : "Choose")</span>
                        </button>
                    }
                </div>
            </div>
        }
        </div>
    </Accordion>

    <Accordion Title="Local Device Proxies" IsExpanded="_proxyExpanded" OnToggle="(expanded) => _proxyExpanded = expanded" BadgeText="@LocalProxyBadge">
        <div class="space-y-4 pt-2">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-white">Local Device Proxies</h2>
                    <p class="mt-1 text-sm text-slate-400">Expose local modem or router admin pages through dedicated local ports.</p>
                </div>
                <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-100">@LocalProxyBadge</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_proxyMessage))
            {
                <div class="@_proxyMessageClass rounded-lg border p-3 text-sm">@_proxyMessage</div>
            }

            <div class="flex flex-wrap gap-2">
                <button type="button"
                        class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40"
                        disabled="@_proxyBusy"
                        @onclick="OpenAddProxy">
                    Add proxy
                </button>
            </div>

            @if (_proxyEntries.Count == 0)
            {
                <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-400">
                    No local device proxies are configured yet.
                </div>
            }
            else
            {
                <div class="grid gap-3">
                    @foreach (var proxy in _proxyEntries)
                    {
                        <article class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="font-semibold text-white">@proxy.DisplayName</h3>
                                        <span class="@GetProxyPillClass(proxy)">@(proxy.Enabled ? "Enabled" : "Disabled")</span>
                                        <span class="@GetProxyModePillClass(proxy)">@FormatProxyMode(proxy)</span>
                                        @if (proxy.TelemetryEnabled)
                                        {
                                            <span class="rounded-full border border-emerald-500/25 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200">Telemetry</span>
                                        }
                                    </div>
                                    <p class="mt-1 break-all text-sm text-slate-400">@FormatProxyEndpoint(proxy)</p>
                                    @if (LocalDeviceProxyService.IsRouteMode(proxy))
                                    {
                                        <p class="mt-1 text-xs text-amber-200">Legacy path proxy may break modem web apps.</p>
                                    }
                                </div>
                                <div class="flex shrink-0 gap-2">
                                    <a class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500/60 hover:text-white"
                                       href="@GetProxyOpenHref(proxy)"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        Open
                                    </a>
                                    <button type="button"
                                            class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500/60 hover:text-white"
                                            disabled="@_proxyBusy"
                                            @onclick="() => EditProxy(proxy)">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="rounded-lg border border-rose-500/35 bg-rose-500/10 px-3 py-2 text-sm font-semibold text-rose-100 hover:bg-rose-500/20"
                                            disabled="@_proxyBusy"
                                            @onclick="() => DeleteProxyAsync(proxy)">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </Accordion>

    <Accordion Title="uLink Client Watchdog" IsExpanded="_clientWatchdogExpanded" OnToggle="(expanded) => _clientWatchdogExpanded = expanded" BadgeText="@ClientWatchdogBadge">
        <div class="space-y-4 pt-2">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-white">uLink Client Watchdog</h2>
                    <p class="mt-1 text-sm text-slate-400">Restarts the uLink client only when the tunnel stays unhealthy while independent interface-bound probes prove physical uplinks can still reach the server.</p>
                </div>
                <span class="@ClientWatchdogPillClass">@ClientWatchdogBadge</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_clientWatchdogMessage))
            {
                <div class="@_clientWatchdogMessageClass rounded-lg border p-3 text-sm">@_clientWatchdogMessage</div>
            }

            @if (_clientWatchdogStatus?.AutomaticRestartsBlocked == true)
            {
                <div class="rounded-lg border border-rose-500/35 bg-rose-500/10 p-3 text-sm text-rose-100">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <p class="font-semibold">
                                <i class="fas fa-triangle-exclamation mr-1.5"></i>
                                Automatic restarts blocked
                            </p>
                            <p class="mt-1 break-words text-xs text-rose-100/80">
                                @(_clientWatchdogStatus.AutomaticRestartBlockReason ?? "Watchdog safety state is unavailable or uncertain.")
                            </p>
                        </div>
                        <button type="button"
                                class="rounded-lg border border-rose-400/40 bg-rose-500/15 px-3 py-2 text-sm font-semibold text-rose-50 hover:bg-rose-500/25 disabled:cursor-not-allowed disabled:opacity-40"
                                disabled="@_clientWatchdogBusy"
                                @onclick="ShowClientWatchdogRecoveryConfirmation">
                            Reinitialize safety state
                        </button>
                    </div>
                </div>
            }

            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                <label class="flex items-center justify-between gap-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 md:col-span-2 xl:col-span-3">
                    <span>
                        <span class="block text-sm font-semibold text-slate-200">Automatic clean restart</span>
                        <span class="mt-1 block text-xs text-slate-500">Disabled automatically means monitor-only; manual checks still work.</span>
                    </span>
                    <input type="checkbox" class="h-5 w-5 accent-emerald-300" @bind="_clientWatchdogDraft.Enabled" />
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Check interval</span>
                    <input type="number" min="5" max="300" class="settings-number-input" @bind="_clientWatchdogDraft.CheckIntervalSeconds" />
                    <span class="mt-1 block text-xs text-slate-500">Seconds between checks.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Sustained checks</span>
                    <input type="number" min="1" max="12" class="settings-number-input" @bind="_clientWatchdogDraft.ConsecutiveUnhealthyChecks" />
                    <span class="mt-1 block text-xs text-slate-500">Required mismatch rounds before restart.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Tunnel RTT limit</span>
                    <input type="number" min="100" max="5000" class="settings-number-input" @bind="_clientWatchdogDraft.TunnelRttThresholdMs" />
                    <span class="mt-1 block text-xs text-slate-500">Milliseconds.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Tunnel loss limit</span>
                    <input type="number" min="1" max="100" class="settings-number-input" @bind="_clientWatchdogDraft.TunnelLossThresholdPercent" />
                    <span class="mt-1 block text-xs text-slate-500">Percent logical heartbeat loss.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Status stale</span>
                    <input type="number" min="3" max="120" class="settings-number-input" @bind="_clientWatchdogDraft.TunnelStaleAfterSeconds" />
                    <span class="mt-1 block text-xs text-slate-500">Seconds without a fresh runtime status or tunnel success.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Direct probe target</span>
                    <input class="settings-number-input" placeholder="Auto: uLink server" @bind="_clientWatchdogDraft.PhysicalProbeTarget" />
                    <span class="mt-1 block text-xs text-slate-500">Blank uses the configured Vultr endpoint.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Physical RTT limit</span>
                    <input type="number" min="20" max="5000" class="settings-number-input" @bind="_clientWatchdogDraft.PhysicalMaxRttMs" />
                    <span class="mt-1 block text-xs text-slate-500">Maximum healthy direct RTT in ms.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Physical loss limit</span>
                    <input type="number" min="0" max="99" class="settings-number-input" @bind="_clientWatchdogDraft.PhysicalMaxLossPercent" />
                    <span class="mt-1 block text-xs text-slate-500">Maximum healthy direct loss percent.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Healthy paths required</span>
                    <input type="number" min="1" max="8" class="settings-number-input" @bind="_clientWatchdogDraft.MinimumHealthyPhysicalPaths" />
                    <span class="mt-1 block text-xs text-slate-500">Minimum proof before restart.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Restart cooldown</span>
                    <input type="number" min="1" max="120" class="settings-number-input" @bind="_clientWatchdogDraft.RestartCooldownMinutes" />
                    <span class="mt-1 block text-xs text-slate-500">Minutes between automatic restarts.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Startup/restart grace</span>
                    <input type="number" min="10" max="300" class="settings-number-input" @bind="_clientWatchdogDraft.PostRestartGraceSeconds" />
                    <span class="mt-1 block text-xs text-slate-500">Seconds before evaluating after app startup or a client restart.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Restart limit</span>
                    <input type="number" min="1" max="12" class="settings-number-input" @bind="_clientWatchdogDraft.MaxRestartsPerHour" />
                    <span class="mt-1 block text-xs text-slate-500">Maximum automatic restarts per hour.</span>
                </label>
            </div>

            <div class="flex flex-wrap gap-2">
                <button type="button" class="settings-primary-button" disabled="@_clientWatchdogBusy" @onclick="SaveClientWatchdogSettingsAsync">Save watchdog settings</button>
                <button type="button" class="settings-secondary-button" disabled="@(_clientWatchdogBusy || _clientWatchdogStatus?.IsRunning == true)" @onclick="RunClientWatchdogNowAsync">Run check now</button>
            </div>

            <div class="@ClientWatchdogStatusPanelClass">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <span>@(_clientWatchdogStatus?.Message ?? "Watchdog status is unavailable.")</span>
                    <span class="text-xs text-slate-500">@FormatClientWatchdogUpdated()</span>
                </div>
                @if (_clientWatchdogStatus is not null)
                {
                    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
                        <span>Tunnel @FormatOptionalMs(_clientWatchdogStatus.TunnelRttMs)</span>
                        <span>@FormatOptionalPercent(_clientWatchdogStatus.TunnelLossPercent) loss</span>
                        <span>@_clientWatchdogStatus.HealthyPhysicalPathCount healthy direct</span>
                        <span>Mismatch @_clientWatchdogStatus.ConsecutiveMismatchChecks/@_clientWatchdogDraft.ConsecutiveUnhealthyChecks</span>
                        <span>@_clientWatchdogStatus.RestartsLastHour restart(s)/hour</span>
                    </div>
                }
            </div>

            @if (_clientWatchdogStatus?.PathProbes.Count > 0)
            {
                <div class="grid gap-2 md:grid-cols-2">
                    @foreach (var probe in _clientWatchdogStatus.PathProbes)
                    {
                        <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-semibold text-slate-200">@probe.InterfaceName</span>
                                <span class="@(probe.Healthy ? "text-emerald-200" : "text-rose-200")">@(probe.Healthy ? "Healthy" : "Unavailable")</span>
                            </div>
                            <p class="mt-1 text-xs text-slate-500">@FormatOptionalMs(probe.AverageRttMs) · @probe.LossPercent.ToString("0.#")% loss · @probe.Target</p>
                        </div>
                    }
                </div>
            }
        </div>
    </Accordion>

    <Accordion Title="F50 Modem Recovery" IsExpanded="_f50RecoveryExpanded" OnToggle="(expanded) => _f50RecoveryExpanded = expanded" BadgeText="@F50RecoveryBadge">
        <div class="space-y-4 pt-2">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-white">F50 Modem Recovery</h2>
                    <p class="mt-1 text-sm text-slate-400">Automatically hot-rebinds stale uLink modem sockets and can USB-reset a modem when its data link does not recover.</p>
                </div>
                <span class="@F50RecoveryPillClass">@F50RecoveryBadge</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_f50RecoveryMessage))
            {
                <div class="@_f50RecoveryMessageClass rounded-lg border p-3 text-sm">@_f50RecoveryMessage</div>
            }

            <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                    <span>Background checks</span>
                    <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_f50RecoveryDraft.Enabled" />
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Check interval</span>
                    <input type="number" min="1" max="60" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_f50RecoveryDraft.CheckIntervalMinutes" />
                    <span class="mt-1 block text-xs text-slate-500">Minutes between checks.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Failed cooldown</span>
                    <input type="number" min="0" max="10" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_f50RecoveryDraft.FailedRecoveryCooldownRounds" />
                    <span class="mt-1 block text-xs text-slate-500">Skipped rounds after failed recovery.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Settle timeout</span>
                    <input type="number" min="15" max="300" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_f50RecoveryDraft.SettleTimeoutSeconds" />
                    <span class="mt-1 block text-xs text-slate-500">Seconds to wait after USB reset.</span>
                </label>
                <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                    <span>Allow USB reset</span>
                    <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_f50RecoveryDraft.UsbResetEnabled" />
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Ping target</span>
                    <input class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_f50RecoveryDraft.PingTarget" />
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">Severe loss</span>
                    <input type="number" min="50" max="100" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_f50RecoveryDraft.SevereLossPercent" />
                    <span class="mt-1 block text-xs text-slate-500">Percent path loss before recovery.</span>
                </label>
                <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <span class="text-xs uppercase tracking-wide text-slate-500">USB reset command</span>
                    <input class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_f50RecoveryDraft.UsbResetCommandPath" />
                </label>
            </div>

            <div class="flex flex-wrap gap-2">
                <button type="button"
                        class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40"
                        disabled="@_f50RecoveryBusy"
                        @onclick="SaveF50RecoverySettingsAsync">
                    Save recovery settings
                </button>
                <button type="button"
                        class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40"
                        disabled="@_f50RecoveryBusy"
                        @onclick="RunF50RecoveryNowAsync">
                    Run check now
                </button>
            </div>

            <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <span>@(_f50RecoveryStatus?.Message ?? "F50 recovery status is unavailable.")</span>
                    <span class="text-xs text-slate-500">@FormatF50RecoveryUpdated()</span>
                </div>
            </div>

            @if (_f50RecoveryStatus?.Modems.Count > 0)
            {
                <div class="grid gap-3">
                    @foreach (var modem in _f50RecoveryStatus.Modems)
                    {
                        <article class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="font-semibold text-white">@modem.DisplayName</h3>
                                        <span class="@GetF50ModemStatePillClass(modem)">@FormatF50ModemState(modem)</span>
                                        @if (modem.CooldownRoundsRemaining > 0)
                                        {
                                            <span class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-100">Cooldown @modem.CooldownRoundsRemaining</span>
                                        }
                                    </div>
                                    <p class="mt-1 break-all text-sm text-slate-400">@(modem.InterfaceName ?? "no interface") · @modem.TargetHost</p>
                                    <p class="mt-2 text-xs text-slate-500">@FormatF50ModemDetail(modem)</p>
                                    @if (!string.IsNullOrWhiteSpace(modem.LastError))
                                    {
                                        <p class="mt-1 break-all text-xs text-rose-200">@modem.LastError</p>
                                    }
                                </div>
                                <span class="text-xs text-slate-500">@FormatAgo(modem.UpdatedAtUtc)</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </Accordion>

    <Accordion Title="Traffic Bypass Rules" IsExpanded="_bypassExpanded" OnToggle="(expanded) => _bypassExpanded = expanded" BadgeText="@TrafficBypassBadge">
        <div class="space-y-4 pt-2">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-white">Traffic Bypass Rules</h2>
                    <p class="mt-1 text-sm text-slate-400">Send selected destinations or ports outside uLink through a physical adapter.</p>
                </div>
                <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-100">@TrafficBypassBadge</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_bypassMessage))
            {
                <div class="@_bypassMessageClass rounded-lg border p-3 text-sm">@_bypassMessage</div>
            }

            @if (_bypassStatus is not null)
            {
                <div class="@GetBypassStatusClass(_bypassStatus) rounded-lg border p-3 text-sm">
                    <span>@_bypassStatus.Message</span>
                    @if (!string.IsNullOrWhiteSpace(_bypassStatus.Error))
                    {
                        <span class="block break-all text-xs opacity-80">@_bypassStatus.Error</span>
                    }
                </div>
            }

            <div class="flex flex-wrap gap-2">
                <button type="button"
                        class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40"
                        disabled="@_bypassBusy"
                        @onclick="OpenAddBypass">
                    Add bypass rule
                </button>
            </div>

            @if (_bypassEntries.Count == 0)
            {
                <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-400">
                    No traffic bypass rules are configured yet.
                </div>
            }
            else
            {
                <div class="grid gap-3">
                    @foreach (var rule in _bypassEntries)
                    {
                        <article class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="font-semibold text-white">@rule.DisplayName</h3>
                                        <span class="@GetBypassPillClass(rule)">@(rule.Enabled ? "Enabled" : "Disabled")</span>
                                        <span class="rounded-full border border-slate-600 bg-slate-700/40 px-2 py-0.5 text-xs font-semibold text-slate-300">@FormatBypassProtocol(rule.Protocol)</span>
                                    </div>
                                    <p class="mt-1 break-all text-sm text-slate-400">@FormatBypassMatch(rule)</p>
                                    <p class="mt-1 text-xs text-slate-500">Egress: @FormatBypassEgress(rule)</p>
                                </div>
                                <div class="flex shrink-0 gap-2">
                                    <button type="button"
                                            class="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500/60 hover:text-white"
                                            disabled="@_bypassBusy"
                                            @onclick="() => EditBypass(rule)">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="rounded-lg border border-rose-500/35 bg-rose-500/10 px-3 py-2 text-sm font-semibold text-rose-100 hover:bg-rose-500/20"
                                            disabled="@_bypassBusy"
                                            @onclick="() => DeleteBypassAsync(rule)">
                                        Delete
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </Accordion>

    <Accordion Title="TCP MSS Clamp" IsExpanded="_mssExpanded" OnToggle="(expanded) => _mssExpanded = expanded" BadgeText="@MssClampStateLabel">
        <div class="space-y-4 pt-2">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">TCP MSS Clamp</h2>
                <p class="mt-1 text-sm text-slate-400">@(_mssClampStatus?.Message ?? "Loading MSS clamp status")</p>
            </div>
            <span class="@MssClampPillClass">@MssClampStateLabel</span>
        </div>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
            @Info("Tunnel", _xbondStatus?.Running == true ? "Available" : "Unavailable")
            @Info("MSS", (_mssClampStatus?.MssValue ?? 1360).ToString())
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(_busy || _mssClampStatus?.IsEnabled == true)" @onclick="EnableMssClampAsync">
                Enable clamp
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(_busy || _mssClampStatus?.IsEnabled != true)" @onclick="DisableMssClampAsync">
                Disable clamp
            </button>
        </div>
        </div>
    </Accordion>

    <Accordion Title="Link Watchdog" IsExpanded="_monitorExpanded" OnToggle="(expanded) => _monitorExpanded = expanded" BadgeText="@NetworkMonitorBadge">
        <div class="space-y-4 pt-2">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">Link Watchdog</h2>
                <p class="mt-1 text-sm text-slate-400">Monitors configured Linux interfaces and restarts links that lose carrier.</p>
            </div>
            <span class="rounded-full border border-slate-600 bg-slate-700/40 px-2.5 py-1 text-xs font-semibold text-slate-200">
                @(_networkMonitorStatus?.IsEnabled == true ? "Enabled" : "Disabled")
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(_networkMonitorMessage))
        {
            <div class="@_networkMonitorMessageClass rounded-lg border p-3 text-sm">@_networkMonitorMessage</div>
        }

        <label class="flex items-center justify-between gap-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3">
            <span>
                <span class="block text-sm font-semibold text-slate-200">Automatic link recovery</span>
                <span class="mt-1 block text-xs text-slate-500">Monitor the selected interfaces and restart one after carrier remains down.</span>
            </span>
            <input type="checkbox" class="h-5 w-5 accent-emerald-300" @bind="_networkMonitorDraft.Enabled" />
        </label>

        <section class="rounded-xl border border-slate-800 bg-slate-950/40 p-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h3 class="font-semibold text-slate-100">Adapters</h3>
                    <p class="mt-1 text-xs text-slate-500">Choose links to recover. Display names are aliases only; Linux interface names do not change.</p>
                </div>
                <span class="rounded-full border border-slate-700 bg-slate-800 px-2.5 py-1 text-xs font-semibold text-slate-300">@_networkMonitorDraft.WhitelistedLinks.Count selected</span>
            </div>

            <div class="mt-4 grid gap-3">
            @foreach (var adapter in LinkWatchdogAdapterRows())
            {
                var link = FindNetworkMonitorLink(adapter.InterfaceName);
                <article class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-semibold text-white">@LinkWatchdogDisplayName(adapter)</span>
                                <span class="rounded-full border border-slate-700 bg-slate-800 px-2 py-0.5 text-xs text-slate-400">@(IsLinkWatchdogSelected(adapter.InterfaceName) ? "Monitored" : "Available")</span>
                                <span class="text-xs text-slate-500">@(link?.State ?? adapter.State ?? "unknown")</span>
                            </div>
                            <p class="mt-1 break-all text-xs text-slate-500">@adapter.InterfaceName</p>
                        </div>
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                            <input class="settings-number-input sm:w-56"
                                   maxlength="48"
                                   placeholder="Display name"
                                   value="@LinkWatchdogAliasValue(adapter.InterfaceName)"
                                   @onchange="args => SetLinkWatchdogAlias(adapter.InterfaceName, args.Value?.ToString())" />
                            @if (IsLinkWatchdogSelected(adapter.InterfaceName))
                            {
                                <button type="button" class="settings-danger-button" disabled="@_networkMonitorBusy" @onclick="() => ShowLinkWatchdogRemoveConfirmation(adapter)">Remove</button>
                            }
                            else
                            {
                                <button type="button" class="settings-secondary-button" disabled="@_networkMonitorBusy" @onclick="() => AddLinkWatchdogAdapter(adapter.InterfaceName)">Add</button>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(link?.LastRestartError))
                    {
                        <p class="mt-2 text-sm text-rose-200">@link.LastRestartError</p>
                    }
                </article>
            }
            </div>
        </section>

        <div class="grid gap-3 md:grid-cols-3">
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Down timeout</span>
                <input type="number" min="5" max="300" class="settings-number-input" @bind="_networkMonitorDraft.DownTimeoutSeconds" />
                <span class="mt-1 block text-xs text-slate-500">Seconds before a restart.</span>
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Restart attempts</span>
                <input type="number" min="0" class="settings-number-input" @bind="_networkMonitorDraft.MaxRestartAttemptsPerHour" />
                <span class="mt-1 block text-xs text-slate-500">Per hour; 0 means unlimited.</span>
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Cooldown</span>
                <input type="number" min="1" class="settings-number-input" @bind="_networkMonitorDraft.RestartCooldownMinutes" />
                <span class="mt-1 block text-xs text-slate-500">Minutes after the attempt limit.</span>
            </label>
        </div>

        <div class="flex flex-wrap items-start justify-between gap-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3">
            <div class="min-w-0">
                <p class="text-sm font-semibold text-white">Name adapters from their ISP</p>
                <p class="mt-1 text-xs text-slate-500">
                    Asks a free lookup service through each adapter's own connection so cards show the live provider.
                    Display names above always win when set.
                </p>
            </div>
            <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_adapterIdentityEnabled" />
        </div>

        <button type="button" class="settings-primary-button" disabled="@_networkMonitorBusy" @onclick="SaveLinkWatchdogSettingsAsync">Save Link Watchdog</button>
        </div>
    </Accordion>
        </div>
    </div>
</div>

<ActionSheet IsOpen="_showProxyEditor"
             Title="@(_editingProxyId is null ? "Add proxy" : "Edit proxy")"
             Description="Expose a local modem or router admin page through uLink."
             CloseLabel="Close proxy editor"
             MaxWidthClass="md:max-w-2xl"
             OnClose="CloseProxyEditorAsync">
    <div class="space-y-4">
        <div class="grid gap-4 md:grid-cols-2">
            <label class="block">
                <span class="text-sm font-medium text-white">Name</span>
                <input type="text"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="GOMO F50"
                       @bind="_proxyDraft.DisplayName" />
            </label>
            <label class="block">
                <span class="text-sm font-medium text-white">Mode</span>
                <select class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                        @bind="_proxyDraft.ProxyMode">
                    <option value="@LocalDeviceProxyModes.Port">Port proxy</option>
                    <option value="@LocalDeviceProxyModes.Route">Legacy path proxy</option>
                </select>
            </label>
            @if (LocalDeviceProxyService.IsPortMode(_proxyDraft))
            {
                <label class="block">
                    <span class="text-sm font-medium text-white">Local port</span>
                    <input type="number"
                           min="@LocalDeviceProxyService.DefaultMinimumListenPort"
                           max="@LocalDeviceProxyService.DefaultMaximumListenPort"
                           class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                           placeholder="18081"
                           @bind="_proxyDraft.ListenPort" />
                    <span class="mt-1 block text-xs text-slate-500">Safe range: @LocalDeviceProxyService.DefaultMinimumListenPort-@LocalDeviceProxyService.DefaultMaximumListenPort.</span>
                </label>
            }
            else
            {
                <label class="block">
                    <span class="text-sm font-medium text-white">Exposed route</span>
                    <input type="text"
                           class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                           placeholder="/gomo"
                           @bind="_proxyDraft.ExposedRoute" />
                    <span class="mt-1 block text-xs text-amber-200">Legacy path proxy may break modem web apps.</span>
                </label>
            }
            <label class="block md:col-span-2">
                <span class="text-sm font-medium text-white">Target URL</span>
                <input type="text"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="http://192.168.5.1"
                       @bind="_proxyDraft.TargetUrl" />
            </label>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
            <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                <span>Proxy enabled</span>
                <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_proxyDraft.Enabled" />
            </label>
            <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
                <span>Use for F50 telemetry</span>
                <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_proxyDraft.TelemetryEnabled" />
            </label>
        </div>

        <div class="flex flex-wrap gap-2">
            <button type="button"
                    class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40"
                    disabled="@_proxyBusy"
                    @onclick="SaveProxyAsync">
                @(_editingProxyId is null ? "Add proxy" : "Save proxy")
            </button>
            <button type="button"
                    class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40"
                    disabled="@_proxyBusy"
                    @onclick="CloseProxyEditorAsync">
                Cancel
            </button>
        </div>
    </div>
</ActionSheet>

<ActionSheet IsOpen="_showBypassEditor"
             Title="@(_editingBypassId is null ? "Add bypass rule" : "Edit bypass rule")"
             Description="Match selected traffic and send it outside uLink through a physical adapter."
             CloseLabel="Close bypass rule editor"
             MaxWidthClass="md:max-w-2xl"
             OnClose="CloseBypassEditorAsync">
    <div class="space-y-4">
        @if (_editingBypassId is null)
        {
            <div class="flex flex-wrap items-center gap-2 rounded-lg border border-slate-700 bg-slate-950/60 px-3 py-2">
                <span class="text-xs text-slate-400">Quick start:</span>
                <button type="button"
                        class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 text-xs font-semibold text-cyan-200 transition-colors hover:bg-cyan-500/20"
                        @onclick="ApplyTikTokPreset">
                    TikTok
                </button>
                <span class="text-xs text-slate-500">Fills in the domains that decide TikTok's region and currency.</span>
            </div>
        }
        <div class="grid gap-4 md:grid-cols-2">
            <label class="block">
                <span class="text-sm font-medium text-white">Name</span>
                <input type="text"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="Bypass work VPN"
                       @bind="_bypassDraft.DisplayName" />
            </label>
            <label class="block">
                <span class="text-sm font-medium text-white">Protocol</span>
                <select class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                        @bind="_bypassDraft.Protocol">
                    <option value="@TrafficBypassProtocols.Any">Any</option>
                    <option value="@TrafficBypassProtocols.Tcp">TCP</option>
                    <option value="@TrafficBypassProtocols.Udp">UDP</option>
                </select>
            </label>
            <label class="block md:col-span-2">
                <span class="text-sm font-medium text-white">Destinations</span>
                <textarea class="mt-2 min-h-24 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                          placeholder="8.8.8.8, 203.0.113.0/24"
                          @bind="_bypassDestinationText"></textarea>
                <span class="mt-1 block text-xs text-slate-500">IPv4 addresses or CIDR ranges. Leave empty only when matching by port or domain.</span>
            </label>
            <label class="block md:col-span-2">
                <span class="text-sm font-medium text-white">Domains</span>
                <textarea class="mt-2 min-h-24 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                          placeholder="tiktok.com, tiktokcdn.com"
                          @bind="_bypassDomainText"></textarea>
                <span class="mt-1 block text-xs text-slate-500">
                    For services whose addresses change or sit in shared CDN ranges. Matches subdomains too,
                    and requires the router to be handling DNS for your devices.
                </span>
            </label>
            <label class="block md:col-span-2">
                <span class="text-sm font-medium text-white">Destination ports</span>
                <input type="text"
                       class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                       placeholder="443, 5000-5010"
                       @bind="_bypassPortsText" />
                <span class="mt-1 block text-xs text-slate-500">Optional. If protocol is Any, port rules apply to both TCP and UDP.</span>
            </label>
            <label class="block">
                <span class="text-sm font-medium text-white">Egress adapter</span>
                <select class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                        @bind="_bypassDraft.EgressMode">
                    <option value="@TrafficBypassEgressModes.AutoPhysical">Auto physical</option>
                    <option value="@TrafficBypassEgressModes.Interface">Choose adapter</option>
                    <option value="@TrafficBypassEgressModes.Block">Block (drop traffic)</option>
                </select>
                <span class="mt-1 block text-xs text-slate-500">Auto physical uses the current best non-uLink default route. Block drops matches; used to disable apps' built-in DNS.</span>
            </label>
            @if (_bypassDraft.EgressMode == TrafficBypassEgressModes.Interface)
            {
                <label class="block">
                    <span class="text-sm font-medium text-white">Adapter</span>
                    <select class="mt-2 w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-white outline-none focus:border-cyan-500"
                            @bind="_bypassDraft.InterfaceName">
                        <option value="">Select adapter</option>
                        @foreach (var adapter in _bypassAdapters)
                        {
                            <option value="@adapter.InterfaceName">@adapter.DisplayName (@adapter.InterfaceName)</option>
                        }
                    </select>
                </label>
            }
        </div>

        <label class="flex items-center justify-between gap-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-200">
            <span>Rule enabled</span>
            <input type="checkbox" class="h-5 w-5 accent-cyan-400" @bind="_bypassDraft.Enabled" />
        </label>

        <div class="flex flex-wrap gap-2">
            <button type="button"
                    class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40"
                    disabled="@_bypassBusy"
                    @onclick="SaveBypassAsync">
                @(_editingBypassId is null ? "Add rule" : "Save rule")
            </button>
            <button type="button"
                    class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40"
                    disabled="@_bypassBusy"
                    @onclick="CloseBypassEditorAsync">
                Cancel
            </button>
        </div>
    </div>
</ActionSheet>

<ConfirmationModal IsVisible="@_showClientWatchdogRecoveryConfirmation"
                   Title="Reinitialize watchdog safety state?"
                   Message="This clears the persisted watchdog restart quota and cooldown. Automatic restarts are unblocked only after the clean state is written successfully."
                   ConfirmText="Reinitialize state"
                   ConfirmButtonClass="btn-orange"
                   RequiredConfirmationText="RESET WATCHDOG"
                   OnConfirm="HandleClientWatchdogRecoveryConfirmationAsync" />

<ConfirmationModal IsVisible="@_showLinkWatchdogRemoveConfirmation"
                   Title="Remove adapter from Link Watchdog?"
                   Message="@LinkWatchdogRemoveMessage"
                   ConfirmText="Remove adapter"
                   ConfirmButtonClass="btn-danger"
                   OnConfirm="HandleLinkWatchdogRemoveConfirmationAsync" />

@code {
    // 5s rather than 2s: every tick refreshes privileged status (iptables, systemctl, nmcli).
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(5));
    private readonly CancellationTokenSource _refreshCts = new();
    private XBondTrafficEngineStatus? _trafficStatus;
    private XBondStatus? _xbondStatus;
    private XBondAdapterConfigStatus? _xbondAdapterStatus;
    private XBondMssClampStatus? _mssClampStatus;
    private NetworkMonitorStatus? _networkMonitorStatus;
    private NetworkMonitorSettings _networkMonitorDraft = new();
    private bool _adapterIdentityEnabled = true;
    private XBondAdapterConfigRow? _pendingLinkWatchdogRemoval;
    private CudyApAutomationSettings _cudySettings = new();
    private CudyApControlStatus _cudyStatus = new();
    private WifiConnectionStatus? _wifiStatus;
    private WifiControlStatus? _wifiControlStatus;
    private bool _wifiControlBusy;
    private List<WifiInterfaceInfo> _wifiInterfaces = new();
    private List<WifiNetwork> _wifiNetworks = new();
    private List<WifiNetwork> _cudyWifiNetworks = new();
    private List<LocalDeviceProxyEntry> _proxyEntries = new();
    private LocalDeviceProxyEntry _proxyDraft = NewProxyDraft();
    private F50ModemRecoverySettings _f50RecoveryDraft = new();
    private F50ModemRecoveryStatus? _f50RecoveryStatus;
    private XBondClientWatchdogSettings _clientWatchdogDraft = new();
    private XBondClientWatchdogStatus? _clientWatchdogStatus;
    private List<TrafficBypassRule> _bypassEntries = new();
    private List<TrafficBypassEgressAdapter> _bypassAdapters = new();
    private TrafficBypassRule _bypassDraft = NewBypassDraft();
    private TrafficBypassApplyStatus? _bypassStatus;
    private string? _message;
    private string? _error;
    private string? _wifiMessage;
    private string? _cudyLocalMessage;
    private string _cudyLocalMessageClass = "border-slate-700 bg-slate-950/60 text-slate-200";
    private string? _proxyMessage;
    private string _proxyMessageClass = "border-slate-700 bg-slate-950/60 text-slate-200";
    private string? _f50RecoveryMessage;
    private string _f50RecoveryMessageClass = "border-slate-700 bg-slate-950/60 text-slate-200";
    private string? _clientWatchdogMessage;
    private string _clientWatchdogMessageClass = "border-slate-700 bg-slate-950/60 text-slate-200";
    private string? _networkMonitorMessage;
    private string _networkMonitorMessageClass = "border-slate-700 bg-slate-950/60 text-slate-200";
    private string? _bypassMessage;
    private string _bypassMessageClass = "border-slate-700 bg-slate-950/60 text-slate-200";
    private string _bypassDestinationText = "";
    private string _bypassDomainText = "";
