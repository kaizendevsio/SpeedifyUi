    private static string FormatAgo(DateTimeOffset value)
    {
        var delta = DateTimeOffset.UtcNow - value;
        var future = delta < TimeSpan.Zero;
        if (future)
        {
            delta = -delta;
        }

        var text = "now";
        if (delta.TotalSeconds >= 3600)
        {
            text = $"{(int)delta.TotalHours}h";
        }
        else if (delta.TotalSeconds >= 60)
        {
            text = $"{(int)delta.TotalMinutes}m";
        }
        else if (delta.TotalSeconds >= 5)
        {
            text = $"{(int)delta.TotalSeconds}s";
        }

        if (text == "now")
        {
            return "now";
        }

        return future ? $"in {text}" : $"{text} ago";
    }

