    {
        _pendingLinkWatchdogRemoval = adapter;
        _showLinkWatchdogRemoveConfirmation = true;
    }

    private Task HandleLinkWatchdogRemoveConfirmationAsync(bool confirmed)
    {
        _showLinkWatchdogRemoveConfirmation = false;
        if (confirmed && _pendingLinkWatchdogRemoval is not null)
        {
            _networkMonitorDraft.WhitelistedLinks.RemoveAll(interfaceName =>
                string.Equals(interfaceName, _pendingLinkWatchdogRemoval.InterfaceName, StringComparison.OrdinalIgnoreCase));
        }

        _pendingLinkWatchdogRemoval = null;
        return Task.CompletedTask;
    }

    private string LinkWatchdogRemoveMessage => _pendingLinkWatchdogRemoval is null
        ? "This adapter will no longer be monitored."
        : $"{LinkWatchdogDisplayName(_pendingLinkWatchdogRemoval)} ({_pendingLinkWatchdogRemoval.InterfaceName}) will no longer be restarted after you save. Its display name is retained if you add it again.";

