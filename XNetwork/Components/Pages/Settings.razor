    {
        _networkMonitorBusy = true;
        _networkMonitorMessage = null;
        try
        {
            NetworkMonitorSettingsStore.Validate(_networkMonitorDraft);
            var normalized = NetworkMonitorSettingsStore.Normalize(_networkMonitorDraft);
            await NetworkMonitorSettingsStore.SaveAsync(normalized, _refreshCts.Token);
            NetworkMonitorService.UpdateSettings(normalized);
            _networkMonitorDraft = CopyNetworkMonitorSettings(NetworkMonitorService.GetSettings());
            _networkMonitorStatus = NetworkMonitorService.GetStatus();

            if (AdapterIdentitySettings.Enabled != _adapterIdentityEnabled)
            {
                AdapterIdentitySettings.Enabled = _adapterIdentityEnabled;
                await AdapterIdentitySettingsStore.SaveAsync(AdapterIdentitySettings, _refreshCts.Token);
                if (!_adapterIdentityEnabled)
                {
                    AdapterIdentityService.ClearCache();
                }
            }

            _networkMonitorMessage = "Link Watchdog settings saved and applied.";
            _networkMonitorMessageClass = "border-emerald-500/25 bg-emerald-500/10 text-emerald-100";
        }
        catch (Exception ex)
        {
            _networkMonitorMessage = $"Could not save Link Watchdog settings: {ex.Message}";
            _networkMonitorMessageClass = "border-rose-500/30 bg-rose-500/10 text-rose-100";
        }
        finally
        {
            _networkMonitorBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

