        return $"{network.Signal}% signal - {security} - {bssid}";
    }

    private static async Task<string?> TryApplyCudyBypassRoutesAsync(CancellationToken cancellationToken)
    {
        if (!OperatingSystem.IsLinux())
        {
            return null;
        }

        const string helperPath = "/usr/local/sbin/xbond-client-route-apply";
        if (!File.Exists(helperPath))
        {
            return "Local route helper is not installed; restart XBond if the URL is outside a directly connected subnet.";
        }

        try
        {
            using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
            timeoutCts.CancelAfter(TimeSpan.FromSeconds(8));

            var startInfo = new System.Diagnostics.ProcessStartInfo
            {
                FileName = File.Exists("/usr/bin/sudo") ? "/usr/bin/sudo" : helperPath,
                RedirectStandardOutput = true,
                RedirectStandardError = true
            };

            if (startInfo.FileName.EndsWith("sudo", StringComparison.Ordinal))
            {
                startInfo.ArgumentList.Add("-n");
                startInfo.ArgumentList.Add(helperPath);
            }

            using var process = System.Diagnostics.Process.Start(startInfo);
            if (process == null)
            {
                return "Local route helper could not be started; restart XBond if Cudy is still unreachable.";
            }

            var outputTask = process.StandardOutput.ReadToEndAsync(timeoutCts.Token);
            var errorTask = process.StandardError.ReadToEndAsync(timeoutCts.Token);
            await process.WaitForExitAsync(timeoutCts.Token);
            var output = (await outputTask).Trim();
            var error = (await errorTask).Trim();

            if (process.ExitCode == 0)
            {
                return "Local Cudy bypass route was refreshed.";
            }

            var detail = string.IsNullOrWhiteSpace(error) ? output : error;
            return string.IsNullOrWhiteSpace(detail)
                ? "Local route helper failed; restart XBond if Cudy is still unreachable."
                : $"Local route helper failed: {detail}";
        }
        catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)
        {
            return "Local route helper timed out; restart XBond if Cudy is still unreachable.";
        }
        catch (Exception ex)
        {
            return $"Local route helper could not run: {ex.Message}";
        }
    }

    private bool IsCudyHomeNetworkSelected(WifiNetwork network)
    {
        if (!string.IsNullOrWhiteSpace(_cudySettings.HomeBssid) && !string.IsNullOrWhiteSpace(network.Bssid))
        {
            return string.Equals(NormalizeBssid(_cudySettings.HomeBssid), NormalizeBssid(network.Bssid), StringComparison.Ordinal);
        }

        return string.Equals(_cudySettings.HomeSsid, network.Ssid, StringComparison.Ordinal);
    }

    private static string NormalizeBssid(string value) =>
        value.Trim().Replace("-", ":", StringComparison.Ordinal).ToLowerInvariant();

    private static CudyApAutomationSettings CopyCudySettings(CudyApAutomationSettings source)
    {
        var target = new CudyApAutomationSettings();
        CopyCudySettings(source, target);
        return target;
    }

    private static void CopyCudySettings(CudyApAutomationSettings source, CudyApAutomationSettings target)
    {
        target.Enabled = source.Enabled;
        target.ManagementBaseUrl = source.ManagementBaseUrl;
        target.AdminPassword = source.AdminPassword;
        target.AdminPasswordFilePath = source.AdminPasswordFilePath;
        target.AdminPasswordEnvironmentVariable = source.AdminPasswordEnvironmentVariable;
        target.WifiInterface = source.WifiInterface;
        target.HomeSsid = source.HomeSsid;
        target.HomeBssid = source.HomeBssid;
        target.DisableWhenSignalAtLeast = source.DisableWhenSignalAtLeast;
        target.EnableWhenSignalBelow = source.EnableWhenSignalBelow;
        target.CheckIntervalSeconds = source.CheckIntervalSeconds;
        target.DisableAfterSeenSeconds = source.DisableAfterSeenSeconds;
        target.EnableAfterMissingSeconds = source.EnableAfterMissingSeconds;
        target.ReEnableWhenHomeMissing = source.ReEnableWhenHomeMissing;
        target.Disable2G = source.Disable2G;
        target.Disable5G = source.Disable5G;
        target.RequestTimeoutSeconds = source.RequestTimeoutSeconds;
    }

    private static void NormalizeCudySettings(CudyApAutomationSettings settings)
    {
        settings.ManagementBaseUrl = settings.ManagementBaseUrl.Trim();
        settings.AdminPasswordFilePath = settings.AdminPasswordFilePath.Trim();
        settings.AdminPasswordEnvironmentVariable = settings.AdminPasswordEnvironmentVariable.Trim();
        settings.WifiInterface = string.IsNullOrWhiteSpace(settings.WifiInterface) ? "wlan0" : settings.WifiInterface.Trim();
        settings.HomeSsid = settings.HomeSsid.Trim();
        settings.HomeBssid = settings.HomeBssid.Trim();
        settings.DisableWhenSignalAtLeast = Math.Clamp(settings.DisableWhenSignalAtLeast, 0, 100);
        settings.EnableWhenSignalBelow = Math.Clamp(settings.EnableWhenSignalBelow, 0, settings.DisableWhenSignalAtLeast);
        settings.CheckIntervalSeconds = Math.Clamp(settings.CheckIntervalSeconds, 5, 300);
        settings.DisableAfterSeenSeconds = Math.Clamp(settings.DisableAfterSeenSeconds, 0, 600);
        settings.EnableAfterMissingSeconds = Math.Clamp(settings.EnableAfterMissingSeconds, 0, 1800);
        settings.RequestTimeoutSeconds = Math.Clamp(settings.RequestTimeoutSeconds, 3, 60);
    }

