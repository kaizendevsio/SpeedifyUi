    private string GetProxyOpenHref(LocalDeviceProxyEntry proxy)
    {
        if (LocalDeviceProxyService.IsPortMode(proxy))
        {
            var uri = LocalDeviceProxyService.BuildLocalProxyUrl(proxy, NavigationManager.ToAbsoluteUri(NavigationManager.Uri));
            if (!string.IsNullOrWhiteSpace(uri))
            {
                return uri;
            }
        }

        return string.IsNullOrWhiteSpace(proxy.ExposedRoute) ? "#" : proxy.ExposedRoute;
    }

    private int GetNextProxyPort()
    {
        var usedPorts = _proxyEntries
            .Where(LocalDeviceProxyService.IsPortMode)
            .Select(proxy => proxy.ListenPort)
            .Where(port => port.HasValue)
            .Select(port => port!.Value)
            .ToHashSet();

        for (var port = 18081; port <= LocalDeviceProxyService.DefaultMaximumListenPort; port++)
        {
            if (!usedPorts.Contains(port))
            {
                return port;
            }
        }

        return LocalDeviceProxyService.DefaultMinimumListenPort;
    }

