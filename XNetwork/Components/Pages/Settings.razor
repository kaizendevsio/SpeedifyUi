    private string? GetWifiBadge()
    {
        if (_wifiStatus is null)
        {
            return null;
        }

        if (!_wifiStatus.IsSupported)
        {
            return "Unavailable";
        }

        return string.Equals(_wifiStatus.State, "connected", StringComparison.OrdinalIgnoreCase)
            ? "Connected"
            : _wifiStatus.State;
    }

    private string FormatWifiStatusTitle()
    {
        if (_wifiStatus is null)
        {
            return "Wi-Fi status not loaded";
        }

        if (!_wifiStatus.IsSupported)
        {
            return "On-board Wi-Fi unavailable";
        }

        return string.IsNullOrWhiteSpace(_wifiStatus.Ssid)
            ? $"{_wifiStatus.InterfaceName} is {_wifiStatus.State}"
            : $"{_wifiStatus.InterfaceName} on {_wifiStatus.Ssid}";
    }

    private string FormatWifiStatusDetail()
    {
        if (_wifiStatus is null)
        {
            return "Refresh to read NetworkManager Wi-Fi state.";
        }

        if (!_wifiStatus.IsSupported)
        {
            return _wifiStatus.Message ?? "No Linux Wi-Fi interface was found.";
        }

        var parts = new List<string> { _wifiStatus.State };
        if (!string.IsNullOrWhiteSpace(_wifiStatus.ConnectionName))
        {
            parts.Add(_wifiStatus.ConnectionName);
        }

        if (_wifiStatus.Signal is not null)
        {
            parts.Add($"{_wifiStatus.Signal}% signal");
        }

        if (!string.IsNullOrWhiteSpace(_wifiStatus.Security))
        {
            parts.Add(_wifiStatus.Security);
        }

        return string.Join(" - ", parts);
    }

