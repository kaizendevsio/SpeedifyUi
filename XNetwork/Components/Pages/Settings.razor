    private void InitializePolicyFields()
    {
        if (_policyFieldsInitialized || _xbondAdapterStatus is null)
        {
            return;
        }

        _policy = string.IsNullOrWhiteSpace(_xbondAdapterStatus.RedundancyPolicy)
            ? "balanced"
            : _xbondAdapterStatus.RedundancyPolicy;
        _interactivePacketThresholdBytes = _xbondAdapterStatus.InteractivePacketThresholdBytes;
        _duplicateLossThresholdPercent = Math.Round(_xbondAdapterStatus.DuplicateLossThreshold * 100, 1);
        _backupLossDisableThresholdPercent = Math.Round(_xbondAdapterStatus.BackupLossDisableThreshold * 100, 1);
        _reorderHoldMs = _xbondAdapterStatus.ReorderHoldMs;
        _policyFieldsInitialized = true;
    }

    private static string FormatPolicy(string? policy) => string.IsNullOrWhiteSpace(policy)
        ? "Balanced"
        : char.ToUpperInvariant(policy[0]) + policy[1..].Replace('-', ' ');

    private static string PolicyShortDescription(string? policy) => NormalizePolicyName(policy) switch
    {
        "reliable" => "Most protective. Duplicates real-time and bulk traffic over the anchor plus the best healthy backup.",
        "fast" => "Lowest overhead. Uses the anchor first and only adds extra protection when the anchor degrades.",
        _ => "Recommended default. Duplicates small real-time packets, but keeps bulk traffic anchor-first unless loss rises."
    };

    private static string PolicyOverviewDetail(string? policy) => NormalizePolicyName(policy) switch
    {
        "reliable" => "Packet survival first",
        "fast" => "Lowest overhead",
        _ => "Recommended default"
    };

    private static string PolicySaveHint(string? policy) => NormalizePolicyName(policy) switch
    {
        "reliable" => "Reliable favors packet survival and can use more bandwidth or add latency on rough links.",
        "fast" => "Fast favors throughput and lower overhead, with less protection until recovery is needed.",
        _ => "Balanced protects calls/Moonlight-style traffic while avoiding unnecessary duplicate bulk traffic."
    };

    private static string NormalizePolicyName(string? policy) => string.IsNullOrWhiteSpace(policy)
        ? "balanced"
        : policy.Trim().ToLowerInvariant();

    private static RenderFragment Info(string label, string value) => @<div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-500">@label</p>
        <p class="mt-1 truncate font-semibold text-white">@value</p>
    </div>;

    public async ValueTask DisposeAsync()
    {
        await _refreshCts.CancelAsync();
        _timer.Dispose();
        _refreshCts.Dispose();
    }
