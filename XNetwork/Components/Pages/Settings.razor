@page "/settings"
@using XNetwork.Models
@using XNetwork.Services
@implements IAsyncDisposable
@inject XBondTrafficEngineService XBondTrafficEngineService
@inject XBondStatusService XBondStatusService
@inject XBondClientConfigService XBondClientConfigService
@inject XBondScopedRouteService ScopedRouteService
@inject NetworkMonitorService NetworkMonitorService

<PageTitle>Settings</PageTitle>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-5 px-4 pb-28 pt-4 md:px-6 md:pb-10">
    <section>
        <h1 class="text-2xl font-bold text-white">Settings</h1>
        <p class="mt-1 text-sm text-slate-400">XBond runtime controls and router diagnostics.</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="rounded-lg border border-cyan-500/25 bg-cyan-500/10 p-3 text-sm text-cyan-100">@_message</div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="rounded-lg border border-rose-500/25 bg-rose-500/10 p-3 text-sm text-rose-100">@_error</div>
    }

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">XBond Tunnel</h2>
                <p class="mt-1 text-sm text-slate-400">@(_trafficStatus?.Message ?? "Loading service status")</p>
            </div>
            <span class="@ServicePillClass">@ServiceStateLabel</span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            @Info("Service", _trafficStatus?.ClientServiceName ?? "xbond-client.service")
            @Info("Boot", _trafficStatus?.ClientServiceEnableState ?? "unknown")
            @Info("Tunnel", _xbondStatus?.Tunnel.DeviceName ?? "xbond0")
            @Info("IPv6", "Unsupported")
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
            <button type="button" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStart ?? false) || _busy)" @onclick="StartTunnelAsync">
                Start
            </button>
            <button type="button" class="rounded-lg bg-rose-500 px-4 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStop ?? false) || _busy)" @onclick="StopTunnelAsync">
                Stop
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanEnableAtBoot ?? false) || _busy)" @onclick="EnableBootAsync">
                Enable boot
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanDisableAtBoot ?? false) || _busy)" @onclick="DisableBootAsync">
                Disable boot
            </button>
        </div>
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">XBond Policy</h2>
                <p class="mt-1 text-sm text-slate-400">Choose how aggressively XBond duplicates packets across backup paths.</p>
            </div>
            <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-100">
                @FormatPolicy(_policy)
            </span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Policy</span>
                <select class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_policy">
                    <option value="balanced">Balanced</option>
                    <option value="reliable">Reliable</option>
                    <option value="fast">Fast</option>
                    <option value="diagnostic">Diagnostic</option>
                </select>
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Small packet</span>
                <input type="number" min="64" max="1500" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_interactivePacketThresholdBytes" />
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Anchor loss %</span>
                <input type="number" min="0" max="100" step="0.1" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_duplicateLossThresholdPercent" />
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Backup max loss %</span>
                <input type="number" min="0" max="100" step="0.1" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_backupLossDisableThresholdPercent" />
            </label>
            <label class="block rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <span class="text-xs uppercase tracking-wide text-slate-500">Reorder hold</span>
                <input type="number" min="0" max="250" class="mt-2 w-full rounded-md border border-slate-700 bg-slate-950 px-2 py-2 text-sm text-white outline-none focus:border-cyan-500" @bind="_reorderHoldMs" />
            </label>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-3">
            <button type="button" class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_busy" @onclick="SaveXBondPolicyAsync">
                Save policy
            </button>
            <p class="text-xs text-slate-500">Balanced duplicates small packets and only duplicates bulk traffic when anchor loss rises.</p>
        </div>
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">XBond Adapters</h2>
                <p class="mt-1 text-sm text-slate-400">Add or remove connected WAN and Wi-Fi adapters from the XBond tunnel without editing client.toml.</p>
            </div>
            <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-100">
                @ConfiguredAdapterCount in XBond
            </span>
        </div>

        @if (_xbondAdapterStatus?.HasError == true)
        {
            <div class="mt-4 rounded-lg border border-rose-500/25 bg-rose-500/10 p-3 text-sm text-rose-100">@_xbondAdapterStatus.Error</div>
        }
        else if (_xbondAdapterStatus?.Adapters.Count > 0)
        {
            <div class="mt-4 grid gap-3">
                @foreach (var adapter in _xbondAdapterStatus.Adapters)
                {
                    <article class="@AdapterConfigCardClass(adapter)">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="truncate font-semibold text-white">@adapter.Name</h3>
                                    <span class="@AdapterConfigPillClass(adapter)">@AdapterConfigLabel(adapter)</span>
                                </div>
                                <p class="mt-1 break-all text-sm text-slate-400">@adapter.InterfaceName</p>
                                <p class="mt-2 text-xs text-slate-500">@AdapterConfigDetail(adapter)</p>
                            </div>
                            <button type="button"
                                    class="@AdapterConfigButtonClass(adapter)"
                                    disabled="@(!CanToggleXBondAdapter(adapter))"
                                    @onclick="() => ToggleXBondAdapterAsync(adapter)">
                                @AdapterConfigButtonText(adapter)
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-400">
                No connected ethernet or Wi-Fi adapters were discovered.
            </div>
        }
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div>
            <h2 class="text-lg font-semibold text-white">Scoped IPv4 Diagnostics</h2>
            <p class="mt-1 text-sm text-slate-400">Temporarily route one IPv4 host through XBond for testing. IPv6 is not supported in this branch.</p>
        </div>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <input class="rounded-lg border border-slate-700 bg-slate-950/60 px-3 py-2 text-slate-100 outline-none focus:border-cyan-500 sm:w-64" @bind="_routeTarget" />
            <button type="button" class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_busy" @onclick="TestScopedRouteAsync">
                Run test
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_busy" @onclick="ClearScopedRouteAsync">
                Clear route
            </button>
        </div>
        @if (_routeTest is not null)
        {
            <div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
                <p class="font-semibold text-white">@_routeTest.Message</p>
                <p class="mt-1">Packets: @_routeTest.Received/@_routeTest.Sent, loss @Math.Round(_routeTest.LossRate * 100, 1)%</p>
                @if (!string.IsNullOrWhiteSpace(_routeTest.Error))
                {
                    <p class="mt-1 text-rose-200">@_routeTest.Error</p>
                }
            </div>
        }
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">Link Watchdog</h2>
                <p class="mt-1 text-sm text-slate-400">Monitors configured Linux interfaces and restarts links that lose carrier.</p>
            </div>
            <span class="rounded-full border border-slate-600 bg-slate-700/40 px-2.5 py-1 text-xs font-semibold text-slate-200">
                @(_networkMonitorStatus?.IsEnabled == true ? "Enabled" : "Disabled")
            </span>
        </div>
        <div class="mt-4 grid gap-3">
            @foreach (var link in _networkMonitorStatus?.Links ?? Array.Empty<NetworkLinkMonitorStatus>())
            {
                <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <div class="flex items-center justify-between gap-3">
                        <span class="font-semibold text-white">@link.Name</span>
                        <span class="text-sm text-slate-400">@(link.State ?? "unknown")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(link.LastRestartError))
                    {
                        <p class="mt-2 text-sm text-rose-200">@link.LastRestartError</p>
                    }
                </div>
            }
        </div>
    </section>
</div>

@code {
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(2));
    private readonly CancellationTokenSource _refreshCts = new();
    private XBondTrafficEngineStatus? _trafficStatus;
    private XBondStatus? _xbondStatus;
    private XBondAdapterConfigStatus? _xbondAdapterStatus;
    private NetworkMonitorStatus? _networkMonitorStatus;
    private XBondScopedRouteTestResult? _routeTest;
    private string _routeTarget = "1.1.1.1";
    private string? _message;
    private string? _error;
    private string? _busyAdapter;
    private string _policy = "balanced";
    private int _interactivePacketThresholdBytes = 768;
    private double _duplicateLossThresholdPercent = 2;
    private double _backupLossDisableThresholdPercent = 35;
    private int _reorderHoldMs = 25;
    private bool _policyFieldsInitialized;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _routeTarget = ScopedRouteService.Settings.ScopedRouteDefaultTarget;
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        _trafficStatus = await XBondTrafficEngineService.GetStatusAsync(_refreshCts.Token);
        _xbondStatus = await XBondStatusService.GetStatusAsync(_refreshCts.Token);
        _xbondAdapterStatus = await XBondClientConfigService.GetStatusAsync(_refreshCts.Token);
        _networkMonitorStatus = NetworkMonitorService.GetStatus();
        InitializePolicyFields();
        StateHasChanged();
    }

    private async Task StartTunnelAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.StartAsync(), "XBond start requested.");

    private async Task StopTunnelAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.StopAsync(), "XBond stop requested.");

    private async Task EnableBootAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.EnableAtBootAsync(), "XBond enabled at boot.");

    private async Task DisableBootAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.DisableAtBootAsync(), "XBond disabled at boot.");

    private async Task RunServiceActionAsync(Func<Task<XBondTrafficEngineStatus>> action, string successMessage)
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            _trafficStatus = await action();
            if (_trafficStatus.HasError)
            {
                _error = _trafficStatus.Error;
            }
            else
            {
                _message = successMessage;
            }
        }
        finally
        {
            _busy = false;
            await RefreshAsync();
        }
    }

    private async Task ToggleXBondAdapterAsync(XBondAdapterConfigRow adapter)
    {
        _busy = true;
        _busyAdapter = adapter.InterfaceName;
        _message = null;
        _error = null;
        try
        {
            _xbondAdapterStatus = await XBondClientConfigService.SetInterfaceEnabledAsync(
                adapter.InterfaceName,
                !adapter.IsConfigured);
            if (_xbondAdapterStatus.HasError)
            {
                _error = _xbondAdapterStatus.Error;
            }
            else
            {
                _message = _xbondAdapterStatus.Message;
            }
        }
        finally
        {
            _busy = false;
            _busyAdapter = null;
            await RefreshAsync();
        }
    }

    private async Task SaveXBondPolicyAsync()
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            _xbondAdapterStatus = await XBondClientConfigService.SetPolicyAsync(
                _policy,
                _interactivePacketThresholdBytes,
                _duplicateLossThresholdPercent / 100d,
                _backupLossDisableThresholdPercent / 100d,
                _reorderHoldMs);
            if (_xbondAdapterStatus.HasError)
            {
                _error = _xbondAdapterStatus.Error;
            }
            else
            {
                _message = _xbondAdapterStatus.Message;
                _policyFieldsInitialized = false;
            }
        }
        finally
        {
            _busy = false;
            await RefreshAsync();
        }
    }

    private async Task TestScopedRouteAsync()
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            _routeTest = await ScopedRouteService.RunScopedRouteTestAsync(_routeTarget);
            if (_routeTest.HasError)
            {
                _error = _routeTest.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearScopedRouteAsync()
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            var status = await ScopedRouteService.ClearScopedRouteAsync(_routeTarget);
            _message = status.Message;
            _error = status.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private string ServiceStateLabel => _trafficStatus switch
    {
        null => "Loading",
        { ClientServiceRunning: true } => "Running",
        _ => "Stopped"
    };

    private string ServicePillClass => _trafficStatus?.ClientServiceRunning == true
        ? "rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200"
        : "rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-200";

    private int ConfiguredAdapterCount => _xbondAdapterStatus?.Adapters.Count(adapter => adapter.IsConfigured) ?? 0;

    private bool CanToggleXBondAdapter(XBondAdapterConfigRow adapter) =>
        _xbondAdapterStatus?.CanEdit == true &&
        !_busy &&
        string.IsNullOrWhiteSpace(_busyAdapter) &&
        adapter.CanToggle;

    private static string AdapterConfigCardClass(XBondAdapterConfigRow adapter) =>
        adapter.IsConfigured
            ? "rounded-lg border border-cyan-500/25 bg-cyan-500/10 p-4"
            : "rounded-lg border border-slate-800 bg-slate-950/50 p-4";

    private static string AdapterConfigPillClass(XBondAdapterConfigRow adapter)
    {
        if (adapter.IsConfigured)
        {
            return "rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200";
        }

        return adapter.IsEligible
            ? "rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 text-xs font-semibold text-cyan-100"
            : "rounded-full border border-slate-600 bg-slate-700/40 px-2 py-0.5 text-xs font-semibold text-slate-300";
    }

    private static string AdapterConfigLabel(XBondAdapterConfigRow adapter)
    {
        if (adapter.IsConfigured)
        {
            return "In XBond";
        }

        return adapter.IsEligible ? "Available" : "Unavailable";
    }

    private static string AdapterConfigDetail(XBondAdapterConfigRow adapter)
    {
        var type = string.IsNullOrWhiteSpace(adapter.Type) ? "adapter" : adapter.Type;
        var state = string.IsNullOrWhiteSpace(adapter.State) ? "unknown" : adapter.State;
        return $"{type}, {state}. {adapter.Detail}";
    }

    private static string AdapterConfigButtonClass(XBondAdapterConfigRow adapter) =>
        adapter.IsConfigured
            ? "rounded-lg border border-rose-500/40 bg-rose-500/10 px-4 py-2 text-sm font-semibold text-rose-100 disabled:cursor-not-allowed disabled:opacity-40"
            : "rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40";

    private static string AdapterConfigButtonText(XBondAdapterConfigRow adapter) =>
        adapter.IsConfigured ? "Remove" : "Add";

    private void InitializePolicyFields()
    {
        if (_policyFieldsInitialized || _xbondAdapterStatus is null)
        {
            return;
        }

        _policy = string.IsNullOrWhiteSpace(_xbondAdapterStatus.RedundancyPolicy)
            ? "balanced"
            : _xbondAdapterStatus.RedundancyPolicy;
        _interactivePacketThresholdBytes = _xbondAdapterStatus.InteractivePacketThresholdBytes;
        _duplicateLossThresholdPercent = Math.Round(_xbondAdapterStatus.DuplicateLossThreshold * 100, 1);
        _backupLossDisableThresholdPercent = Math.Round(_xbondAdapterStatus.BackupLossDisableThreshold * 100, 1);
        _reorderHoldMs = _xbondAdapterStatus.ReorderHoldMs;
        _policyFieldsInitialized = true;
    }

    private static string FormatPolicy(string? policy) => string.IsNullOrWhiteSpace(policy)
        ? "Balanced"
        : char.ToUpperInvariant(policy[0]) + policy[1..].Replace('-', ' ');

    private static RenderFragment Info(string label, string value) => @<div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-500">@label</p>
        <p class="mt-1 truncate font-semibold text-white">@value</p>
    </div>;

    public async ValueTask DisposeAsync()
    {
        await _refreshCts.CancelAsync();
        _timer.Dispose();
        _refreshCts.Dispose();
    }
}
