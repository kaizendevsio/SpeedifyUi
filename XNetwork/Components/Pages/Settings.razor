    private IReadOnlyList<XBondAdapterConfigRow> LinkWatchdogAdapterRows()
    {
        var rows = (_xbondAdapterStatus?.Adapters ?? [])
            .ToDictionary(adapter => adapter.InterfaceName, StringComparer.OrdinalIgnoreCase);
        foreach (var interfaceName in _networkMonitorDraft.WhitelistedLinks)
        {
            rows.TryAdd(interfaceName, new XBondAdapterConfigRow
            {
                Name = interfaceName,
                InterfaceName = interfaceName,
                State = FindNetworkMonitorLink(interfaceName)?.State ?? "unknown"
            });
        }

        return rows.Values
            .OrderByDescending(adapter => IsLinkWatchdogSelected(adapter.InterfaceName))
            .ThenBy(adapter => LinkWatchdogDisplayName(adapter), StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private NetworkLinkMonitorStatus? FindNetworkMonitorLink(string interfaceName) =>
        _networkMonitorStatus?.Links.FirstOrDefault(link =>
            string.Equals(link.Name, interfaceName, StringComparison.OrdinalIgnoreCase));

    private bool IsLinkWatchdogSelected(string interfaceName) =>
        _networkMonitorDraft.WhitelistedLinks.Contains(interfaceName, StringComparer.OrdinalIgnoreCase);

    private void AddLinkWatchdogAdapter(string interfaceName)
    {
        if (!IsLinkWatchdogSelected(interfaceName))
        {
            _networkMonitorDraft.WhitelistedLinks.Add(interfaceName);
        }
    }

    private string LinkWatchdogAliasValue(string interfaceName) =>
        NetworkMonitorSettingsStore.GetAdapterAlias(_networkMonitorDraft, interfaceName) ?? "";

    private void SetLinkWatchdogAlias(string interfaceName, string? value)
    {
        var alias = value?.Trim() ?? "";
        if (string.IsNullOrEmpty(alias))
        {
            _networkMonitorDraft.AdapterAliases.Remove(interfaceName);
        }
        else
        {
            _networkMonitorDraft.AdapterAliases[interfaceName] = alias;
        }
    }

    private string LinkWatchdogDisplayName(XBondAdapterConfigRow adapter) =>
        NetworkMonitorSettingsStore.GetAdapterAlias(_networkMonitorDraft, adapter.InterfaceName) ?? adapter.Name;

