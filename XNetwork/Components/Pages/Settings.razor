@page "/settings"
@using XNetwork.Models
@using XNetwork.Services
@implements IAsyncDisposable
@inject XBondTrafficEngineService XBondTrafficEngineService
@inject XBondStatusService XBondStatusService
@inject XBondScopedRouteService ScopedRouteService
@inject NetworkMonitorService NetworkMonitorService

<PageTitle>Settings</PageTitle>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-5 px-4 pb-28 pt-4 md:px-6 md:pb-10">
    <section>
        <h1 class="text-2xl font-bold text-white">Settings</h1>
        <p class="mt-1 text-sm text-slate-400">XBond runtime controls and router diagnostics.</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="rounded-lg border border-cyan-500/25 bg-cyan-500/10 p-3 text-sm text-cyan-100">@_message</div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="rounded-lg border border-rose-500/25 bg-rose-500/10 p-3 text-sm text-rose-100">@_error</div>
    }

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">XBond Tunnel</h2>
                <p class="mt-1 text-sm text-slate-400">@(_trafficStatus?.Message ?? "Loading service status")</p>
            </div>
            <span class="@ServicePillClass">@ServiceStateLabel</span>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            @Info("Service", _trafficStatus?.ClientServiceName ?? "xbond-client.service")
            @Info("Boot", _trafficStatus?.ClientServiceEnableState ?? "unknown")
            @Info("Tunnel", _xbondStatus?.Tunnel.DeviceName ?? "xbond0")
            @Info("IPv6", "Unsupported")
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
            <button type="button" class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStart ?? false) || _busy)" @onclick="StartTunnelAsync">
                Start
            </button>
            <button type="button" class="rounded-lg bg-rose-500 px-4 py-2 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStop ?? false) || _busy)" @onclick="StopTunnelAsync">
                Stop
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanEnableAtBoot ?? false) || _busy)" @onclick="EnableBootAsync">
                Enable boot
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@(!(_trafficStatus?.CanDisableAtBoot ?? false) || _busy)" @onclick="DisableBootAsync">
                Disable boot
            </button>
        </div>
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div>
            <h2 class="text-lg font-semibold text-white">Scoped IPv4 Diagnostics</h2>
            <p class="mt-1 text-sm text-slate-400">Temporarily route one IPv4 host through XBond for testing. IPv6 is not supported in this branch.</p>
        </div>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <input class="rounded-lg border border-slate-700 bg-slate-950/60 px-3 py-2 text-slate-100 outline-none focus:border-cyan-500 sm:w-64" @bind="_routeTarget" />
            <button type="button" class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_busy" @onclick="TestScopedRouteAsync">
                Run test
            </button>
            <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:cursor-not-allowed disabled:opacity-40" disabled="@_busy" @onclick="ClearScopedRouteAsync">
                Clear route
            </button>
        </div>
        @if (_routeTest is not null)
        {
            <div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
                <p class="font-semibold text-white">@_routeTest.Message</p>
                <p class="mt-1">Packets: @_routeTest.Received/@_routeTest.Sent, loss @Math.Round(_routeTest.LossRate * 100, 1)%</p>
                @if (!string.IsNullOrWhiteSpace(_routeTest.Error))
                {
                    <p class="mt-1 text-rose-200">@_routeTest.Error</p>
                }
            </div>
        }
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h2 class="text-lg font-semibold text-white">Link Watchdog</h2>
                <p class="mt-1 text-sm text-slate-400">Monitors configured Linux interfaces and restarts links that lose carrier.</p>
            </div>
            <span class="rounded-full border border-slate-600 bg-slate-700/40 px-2.5 py-1 text-xs font-semibold text-slate-200">
                @(_networkMonitorStatus?.IsEnabled == true ? "Enabled" : "Disabled")
            </span>
        </div>
        <div class="mt-4 grid gap-3">
            @foreach (var link in _networkMonitorStatus?.Links ?? Array.Empty<NetworkLinkMonitorStatus>())
            {
                <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <div class="flex items-center justify-between gap-3">
                        <span class="font-semibold text-white">@link.Name</span>
                        <span class="text-sm text-slate-400">@(link.State ?? "unknown")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(link.LastRestartError))
                    {
                        <p class="mt-2 text-sm text-rose-200">@link.LastRestartError</p>
                    }
                </div>
            }
        </div>
    </section>
</div>

@code {
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(2));
    private readonly CancellationTokenSource _refreshCts = new();
    private XBondTrafficEngineStatus? _trafficStatus;
    private XBondStatus? _xbondStatus;
    private NetworkMonitorStatus? _networkMonitorStatus;
    private XBondScopedRouteTestResult? _routeTest;
    private string _routeTarget = "1.1.1.1";
    private string? _message;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _routeTarget = ScopedRouteService.Settings.ScopedRouteDefaultTarget;
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        _trafficStatus = await XBondTrafficEngineService.GetStatusAsync(_refreshCts.Token);
        _xbondStatus = await XBondStatusService.GetStatusAsync(_refreshCts.Token);
        _networkMonitorStatus = NetworkMonitorService.GetStatus();
        StateHasChanged();
    }

    private async Task StartTunnelAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.StartAsync(), "XBond start requested.");

    private async Task StopTunnelAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.StopAsync(), "XBond stop requested.");

    private async Task EnableBootAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.EnableAtBootAsync(), "XBond enabled at boot.");

    private async Task DisableBootAsync() => await RunServiceActionAsync(() => XBondTrafficEngineService.DisableAtBootAsync(), "XBond disabled at boot.");

    private async Task RunServiceActionAsync(Func<Task<XBondTrafficEngineStatus>> action, string successMessage)
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            _trafficStatus = await action();
            if (_trafficStatus.HasError)
            {
                _error = _trafficStatus.Error;
            }
            else
            {
                _message = successMessage;
            }
        }
        finally
        {
            _busy = false;
            await RefreshAsync();
        }
    }

    private async Task TestScopedRouteAsync()
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            _routeTest = await ScopedRouteService.RunScopedRouteTestAsync(_routeTarget);
            if (_routeTest.HasError)
            {
                _error = _routeTest.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearScopedRouteAsync()
    {
        _busy = true;
        _message = null;
        _error = null;
        try
        {
            var status = await ScopedRouteService.ClearScopedRouteAsync(_routeTarget);
            _message = status.Message;
            _error = status.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private string ServiceStateLabel => _trafficStatus switch
    {
        null => "Loading",
        { ClientServiceRunning: true } => "Running",
        _ => "Stopped"
    };

    private string ServicePillClass => _trafficStatus?.ClientServiceRunning == true
        ? "rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200"
        : "rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-200";

    private static RenderFragment Info(string label, string value) => @<div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-500">@label</p>
        <p class="mt-1 truncate font-semibold text-white">@value</p>
    </div>;

    public async ValueTask DisposeAsync()
    {
        await _refreshCts.CancelAsync();
        _timer.Dispose();
        _refreshCts.Dispose();
    }
}
