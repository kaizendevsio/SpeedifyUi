    protected override async Task OnInitializedAsync()
    {
        CudyApControlService.RefreshStatusFromSettings();
        _cudySettings = CopyCudySettings(CudyApControlService.Settings);
        _cudyStatus = CudyApControlService.GetStatus();
        _f50RecoveryDraft = CopyF50RecoverySettings(F50ModemRecoveryService.Settings);
        _f50RecoveryStatus = F50ModemRecoveryService.GetStatus();
        _clientWatchdogDraft = CopyClientWatchdogSettings(XBondClientWatchdogService.Settings);
        _clientWatchdogStatus = XBondClientWatchdogService.GetStatus();
        _networkMonitorDraft = CopyNetworkMonitorSettings(NetworkMonitorService.GetSettings());
        _adapterIdentityEnabled = AdapterIdentitySettings.Enabled;
        LoadProxyEntries();
        await LoadTrafficBypassAsync();
        await LoadWifiInterfacesAsync();
        await LoadWifiStatusAsync();
        await LoadWifiNetworksAsync(rescan: false);
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        _trafficStatus = await XBondTrafficEngineService.GetStatusAsync(_refreshCts.Token);
        _xbondStatus = await XBondStatusService.GetStatusAsync(_refreshCts.Token);
        _xbondAdapterStatus = await XBondClientConfigService.GetStatusAsync(_refreshCts.Token);
        _mssClampStatus = await MssClampService.GetStatusAsync(_refreshCts.Token);
        _networkMonitorStatus = NetworkMonitorService.GetStatus();
        _cudyStatus = CudyApControlService.GetStatus();
        _f50RecoveryStatus = F50ModemRecoveryService.GetStatus();
        _clientWatchdogStatus = XBondClientWatchdogService.GetStatus();
        _bypassStatus = TrafficBypassService.GetLastApplyStatus();
        InitializePolicyFields();
        StateHasChanged();
    }

