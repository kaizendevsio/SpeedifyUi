@page "/details"
@using XNetwork.Models
@using XNetwork.Services
@using XNetwork.Utils
@implements IAsyncDisposable
@inject XBondSnapshotCache XBondSnapshotCache

<PageTitle>XBond Analytics</PageTitle>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-5 px-4 pb-28 pt-4 md:px-6 md:pb-10">
    <section>
        <h1 class="text-2xl font-bold text-white">XBond Analytics</h1>
        <p class="mt-1 text-sm text-slate-400">Live tunnel and path telemetry from XBond runtime status.</p>
    </section>

    <section class="grid gap-3 md:grid-cols-4">
        @MetricCard("State", _snapshot?.State ?? "Loading")
        @MetricCard("Active paths", (_snapshot?.ActivePaths.Count ?? 0).ToString())
        @MetricCard("Download", SpeedFormatter.FormatSpeed(_snapshot?.DownloadMbps ?? 0))
        @MetricCard("Upload", SpeedFormatter.FormatSpeed(_snapshot?.UploadMbps ?? 0))
    </section>

    <section class="grid gap-4 lg:grid-cols-2">
        @ChartPanel("Download", _downloadHistory, "speed", "text-cyan-300")
        @ChartPanel("Upload", _uploadHistory, "speed", "text-pink-300")
        @ChartPanel("Average RTT", _latencyHistory, "ms", "text-emerald-300")
        @ChartPanel("Path Loss", _lossHistory, "%", "text-amber-300")
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-4">
        <div class="mb-4 flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-white">Paths</h2>
            <span class="text-xs text-slate-500">Updated @FormatUpdated()</span>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-800 text-sm">
                <thead class="text-left text-xs uppercase tracking-wide text-slate-500">
                    <tr>
                        <th class="py-2 pr-4">Path</th>
                        <th class="py-2 pr-4">Role</th>
                        <th class="py-2 pr-4">State</th>
                        <th class="py-2 pr-4">RTT</th>
                        <th class="py-2 pr-4">Loss</th>
                        <th class="py-2 pr-4">Late</th>
                        <th class="py-2 pr-4">Download</th>
                        <th class="py-2 pr-4">Upload</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-800/70 text-slate-300">
                    @foreach (var path in _snapshot?.DashboardPaths ?? [])
                    {
                        <tr>
                            <td class="py-3 pr-4">
                                <div class="font-semibold text-white">@path.Name</div>
                                <div class="text-xs text-slate-500">@path.InterfaceName</div>
                            </td>
                            <td class="py-3 pr-4">@path.Role</td>
                            <td class="py-3 pr-4">@path.StateText</td>
                            <td class="py-3 pr-4">@FormatLatency(path.RttMs)</td>
                            <td class="py-3 pr-4">@FormatPercent(path.LossPercent)</td>
                            <td class="py-3 pr-4">@FormatPercent(path.LatePercent)</td>
                            <td class="py-3 pr-4">@SpeedFormatter.FormatSpeed(path.DownloadMbps)</td>
                            <td class="py-3 pr-4">@SpeedFormatter.FormatSpeed(path.UploadMbps)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@code {
    private const int MaxHistory = 60;
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(1));
    private readonly CancellationTokenSource _refreshCts = new();
    private readonly List<double> _downloadHistory = [];
    private readonly List<double> _uploadHistory = [];
    private readonly List<double> _latencyHistory = [];
    private readonly List<double> _lossHistory = [];
    private XBondStatsSnapshot? _snapshot;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        _snapshot = await XBondSnapshotCache.GetSnapshotAsync(_refreshCts.Token);
        AddHistory(_downloadHistory, _snapshot.DownloadMbps);
        AddHistory(_uploadHistory, _snapshot.UploadMbps);
        AddHistory(_latencyHistory, _snapshot.AverageRttMs);
        AddHistory(_lossHistory, _snapshot.MaxLossPercent);
        StateHasChanged();
    }

    private static void AddHistory(List<double> values, double value)
    {
        values.Add(double.IsFinite(value) ? value : 0);
        if (values.Count > MaxHistory)
        {
            values.RemoveAt(0);
        }
    }

    private static RenderFragment MetricCard(string label, string value) => @<article class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-4">
        <p class="text-sm text-slate-400">@label</p>
        <p class="mt-2 text-2xl font-bold text-white">@value</p>
    </article>;

    private static RenderFragment ChartPanel(string title, IReadOnlyList<double> values, string unit, string colorClass) => @<article class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-4">
        <div class="mb-3 flex items-center justify-between">
            <h2 class="font-semibold text-white">@title</h2>
            <span class="@($"text-sm font-semibold {colorClass}")">@FormatChartValue(values.LastOrDefault(), unit)</span>
        </div>
        <div class="h-40">
            <svg class="h-full w-full" viewBox="0 0 300 120" preserveAspectRatio="none" role="img" aria-label="@title">
                <line x1="0" y1="100" x2="300" y2="100" stroke="rgba(148,163,184,.16)" stroke-width="1" />
                <line x1="0" y1="60" x2="300" y2="60" stroke="rgba(148,163,184,.10)" stroke-width="1" />
                <polyline points="@BuildPolyline(values)" fill="none" stroke="#22d3ee" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
    </article>;

    private static string BuildPolyline(IReadOnlyList<double> values)
    {
        if (values.Count == 0)
        {
            return "";
        }

        var finiteValues = values.Where(double.IsFinite).ToArray();
        if (finiteValues.Length == 0)
        {
            return "";
        }

        var min = finiteValues.Min();
        var max = finiteValues.Max();
        var range = max - min;
        return string.Join(' ', values.Select((value, index) =>
        {
            var x = values.Count == 1 ? 300 : index * 300d / (values.Count - 1);
            var normalized = range <= 0.000001
                ? max > 0 ? 0.5 : 0
                : Math.Clamp((value - min) / range, 0, 1);
            var y = 110 - normalized * 100;
            return $"{Math.Round(x, 1)},{Math.Round(y, 1)}";
        }));
    }

    private static string FormatChartValue(double value, string unit) => unit == "speed"
        ? SpeedFormatter.FormatSpeed(value)
        : $"{Math.Round(value, 1)} {unit}";

    private string FormatUpdated() => _snapshot is null
        ? "--"
        : _snapshot.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss");

    private static string FormatLatency(double? value) => value.HasValue && value.Value > 0
        ? $"{Math.Round(value.Value)} ms"
        : "--";

    private static string FormatPercent(double? value) => value.HasValue
        ? $"{Math.Round(value.Value, 1)}%"
        : "--";

    public async ValueTask DisposeAsync()
    {
        await _refreshCts.CancelAsync();
        _timer.Dispose();
        _refreshCts.Dispose();
    }
}
