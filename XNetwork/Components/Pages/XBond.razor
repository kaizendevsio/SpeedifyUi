@page "/xbond"
@using Microsoft.AspNetCore.Components
@using XNetwork.Models
@using XNetwork.Services
@inject XBondStatusService XBondStatusService
@inject XBondLabService XBondLabService

<PageTitle>XBond - XNetwork</PageTitle>

<div class="p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-cyan-300">Reliability Tunnel Prototype</p>
            <h2 class="mt-1 text-3xl font-bold text-white">XBond</h2>
            <p class="mt-2 max-w-3xl text-sm text-slate-400">
                Rust dataplane prototype for dynamic stable-anchor routing, packet-level redundancy, and first-arrival-wins delivery.
            </p>
        </div>
        <button type="button"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-100 transition-colors hover:bg-cyan-500/20 disabled:cursor-not-allowed disabled:opacity-60"
                disabled="@_isLoading"
                @onclick="RefreshAsync">
            <i class="fas fa-rotate @(_isLoading ? "animate-spin" : "")"></i>
            Refresh
        </button>
    </div>

    @if (_status == null)
    {
        <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-5 text-slate-300">
            Loading XBond status...
        </div>
    }
    else
    {
        <section class="mb-6 rounded-xl border border-slate-700 bg-slate-800/50 p-4 shadow-lg">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="@GetStateBadgeClass()">@GetStateLabel()</span>
                        <span class="rounded-full border border-slate-700 bg-slate-950/60 px-2.5 py-1 text-xs font-semibold text-slate-300">
                            @FormatMode(_status.Mode)
                        </span>
                    </div>
                    <h3 class="mt-3 text-xl font-semibold text-white">@GetSummaryTitle()</h3>
                    <p class="mt-2 text-sm text-slate-400">@(_status.HasError ? _status.Error : _status.Message)</p>
                </div>
                <div class="grid grid-cols-2 gap-3 text-sm md:min-w-80">
                    @Metric("Server", DisplayValue(_status.ServerAddress))
                    @Metric("Anchor", GetAnchorLabel())
                    @Metric("Duplicates dropped", _status.DuplicatePacketsDropped.ToString("N0"))
                    @Metric("Late dropped", _status.LatePacketsDropped.ToString("N0"))
                    @Metric("FEC recovered", _status.FecPacketsRecovered.ToString("N0"))
                    @Metric("Updated", FormatAge(_status.UpdatedAtUtc))
                </div>
            </div>
        </section>

        <section class="mb-6 grid gap-4 lg:grid-cols-3">
            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Data paths</p>
                <p class="mt-2 text-2xl font-bold text-white">@FormatPathList(_status.Schedule.DataPathIds)</p>
                <p class="mt-1 text-sm text-slate-400">Immediate packets use only the selected anchor path.</p>
            </div>
            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Duplicate paths</p>
                <p class="mt-2 text-2xl font-bold text-white">@FormatPathList(_status.Schedule.DuplicatePathIds)</p>
                <p class="mt-1 text-sm text-slate-400">Late duplicates are discarded by sequence number.</p>
            </div>
            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">FEC paths</p>
                <p class="mt-2 text-2xl font-bold text-white">@FormatPathList(_status.Schedule.FecPathIds)</p>
                <p class="mt-1 text-sm text-slate-400">Backup links carry recovery traffic in AnchorFec mode.</p>
            </div>
        </section>

        <section class="mb-6 rounded-xl border border-cyan-500/20 bg-slate-800/50 shadow-lg">
            <div class="flex flex-col gap-4 border-b border-slate-700 px-4 py-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-white">XBond Lab</h3>
                    <p class="mt-1 text-sm text-slate-400">Public WAN heartbeat through a temporary Speedify bypass.</p>
                </div>
                <button type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-100 transition-colors hover:bg-cyan-500/20 disabled:cursor-not-allowed disabled:opacity-60"
                        disabled="@_isRunningPublicTest"
                        @onclick="RunPublicTestAsync">
                    <i class="fas fa-satellite-dish @(_isRunningPublicTest ? "animate-pulse" : "")"></i>
                    @(_isRunningPublicTest ? "Running..." : "Run Public Test")
                </button>
            </div>
            <div class="grid gap-4 p-4 lg:grid-cols-[1fr_1.2fr]">
                <div class="grid grid-cols-2 gap-3 text-sm">
                    @Metric("Server", XBondLabService.Settings.PublicTestServerAddress)
                    @Metric("Bypass", $"{XBondLabService.Settings.PublicTestBypassPort}/{XBondLabService.Settings.PublicTestBypassProtocol}")
                    @Metric("Packets", XBondLabService.Settings.PublicTestCount.ToString("N0"))
                    @Metric("Timeout", $"{XBondLabService.Settings.PublicTestPacketTimeoutMs:N0} ms")
                </div>
                <div class="rounded-xl border border-slate-700/70 bg-slate-950/40 p-4">
                    @if (_isRunningPublicTest)
                    {
                        <div class="flex items-center gap-3 text-cyan-100">
                            <i class="fas fa-circle-notch animate-spin"></i>
                            <span class="text-sm font-semibold">Running public heartbeat test...</span>
                        </div>
                    }
                    else if (_publicTestResult == null)
                    {
                        <p class="text-sm text-slate-400">No public test has been run in this dashboard session.</p>
                    }
                    else
                    {
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="@GetTestBadgeClass(_publicTestResult)">
                                @(_publicTestResult.Succeeded ? "Passed" : "Failed")
                            </span>
                            <span class="text-sm text-slate-400">@_publicTestResult.Message</span>
                        </div>

                        @if (_publicTestResult.HasError)
                        {
                            <p class="mt-3 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-100">
                                @_publicTestResult.Error
                            </p>
                        }

                        <div class="mt-4 grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
                            @Metric("Sent", _publicTestResult.Sent.ToString("N0"))
                            @Metric("Received", _publicTestResult.Received.ToString("N0"))
                            @Metric("Loss", $"{_publicTestResult.LossRate:P1}")
                            @Metric("Avg RTT", FormatNullableMs(_publicTestResult.AvgRttMs))
                            @Metric("Min RTT", FormatNullableMs(_publicTestResult.MinRttMs))
                            @Metric("Max RTT", FormatNullableMs(_publicTestResult.MaxRttMs))
                            @Metric("Client bind", DisplayValue(_publicTestResult.Bind))
                            @Metric("Cleanup", GetCleanupLabel(_publicTestResult))
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="rounded-xl border border-slate-700 bg-slate-800/50 shadow-lg">
            <div class="border-b border-slate-700 px-4 py-3">
                <h3 class="text-lg font-semibold text-white">Path health</h3>
                <p class="mt-1 text-sm text-slate-400">Roles are selected by observed health, not adapter name.</p>
            </div>
            <div class="divide-y divide-slate-700/70">
                @if (_status.Paths.Count == 0)
                {
                    <div class="p-4 text-sm text-slate-400">No XBond paths are configured yet.</div>
                }
                else
                {
                    @foreach (var path in _status.Paths)
                    {
                        <div class="grid gap-3 p-4 md:grid-cols-[1fr_auto] md:items-center">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="font-semibold text-white">@path.Name</p>
                                    <span class="@GetRoleBadgeClass(path.Role)">@FormatRole(path.Role)</span>
                                    <span class="rounded-full border border-slate-700 bg-slate-950/60 px-2 py-0.5 text-xs font-semibold text-slate-400">
                                        ID @path.PathId
                                    </span>
                                </div>
                                <p class="mt-1 text-sm text-slate-400">@DisplayValue(path.InterfaceName)</p>
                            </div>
                            <div class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4 lg:grid-cols-8">
                                @Metric("Score", path.Score.ToString("N0"))
                                @Metric("RTT", path.RttMs.HasValue ? $"{path.RttMs.Value:N0} ms" : "--")
                                @Metric("Jitter", path.JitterMs.HasValue ? $"{path.JitterMs.Value:N0} ms" : "--")
                                @Metric("Loss", $"{path.LossRate:P1}")
                                @Metric("Late", $"{path.LateRate:P1}")
                                @Metric("Queue", path.QueueDepth.ToString("N0"))
                                @Metric("Throughput", FormatBits(path.ThroughputBps))
                                @Metric("State", GetPathState(path))
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private XBondStatus? _status;
    private XBondPublicTestResult? _publicTestResult;
    private bool _isLoading;
    private bool _isRunningPublicTest;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        try
        {
            _status = await XBondStatusService.GetStatusAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunPublicTestAsync()
    {
        _isRunningPublicTest = true;
        try
        {
            _publicTestResult = await XBondLabService.RunPublicHeartbeatTestAsync();
        }
        finally
        {
            _isRunningPublicTest = false;
        }
    }

    private string GetStateLabel()
    {
        if (_status?.HasError == true)
        {
            return "Error";
        }

        if (_status?.Running == true)
        {
            return "Running";
        }

        return _status?.Enabled == true ? "Enabled" : "Disabled";
    }

    private string GetStateBadgeClass()
    {
        if (_status?.HasError == true)
        {
            return "rounded-full border border-red-500/40 bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-200";
        }

        if (_status?.Running == true)
        {
            return "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200";
        }

        return _status?.Enabled == true
            ? "rounded-full border border-cyan-500/40 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-200"
            : "rounded-full border border-slate-700 bg-slate-950/60 px-2.5 py-1 text-xs font-semibold text-slate-400";
    }

    private string GetSummaryTitle()
    {
        if (_status?.HasError == true)
        {
            return "Status command failed";
        }

        if (_status?.Running == true)
        {
            return "XBond tunnel is running";
        }

        return _status?.Enabled == true ? "XBond prototype is enabled" : "XBond prototype is parked";
    }

    private string GetAnchorLabel()
    {
        if (_status?.AnchorPathId == null)
        {
            return "--";
        }

        var path = _status.Paths.FirstOrDefault(path => path.PathId == _status.AnchorPathId.Value);
        return path == null ? $"Path {_status.AnchorPathId}" : $"{path.Name} ({path.PathId})";
    }

    private static string FormatMode(string mode)
    {
        return mode switch
        {
            "anchor-only" => "Anchor Only",
            "anchor-duplicate-1" => "Anchor + Duplicate",
            "anchor-fec" => "Anchor + FEC",
            "full-duplicate-debug" => "Full Duplicate Debug",
            _ => mode
        };
    }

    private static string FormatRole(string role)
    {
        return role switch
        {
            "anchor" => "Anchor",
            "backup" => "Backup",
            "probe" => "Probe",
            "cooldown" => "Cooling down",
            "unavailable" => "Unavailable",
            _ => role
        };
    }

    private static string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "anchor" => "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200",
            "backup" => "rounded-full border border-cyan-500/40 bg-cyan-500/10 px-2 py-0.5 text-xs font-semibold text-cyan-200",
            "cooldown" => "rounded-full border border-amber-500/40 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-200",
            "unavailable" => "rounded-full border border-red-500/40 bg-red-500/10 px-2 py-0.5 text-xs font-semibold text-red-200",
            _ => "rounded-full border border-slate-700 bg-slate-950/60 px-2 py-0.5 text-xs font-semibold text-slate-400"
        };
    }

    private static string GetTestBadgeClass(XBondPublicTestResult result)
    {
        return result.Succeeded
            ? "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200"
            : "rounded-full border border-red-500/40 bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-200";
    }

    private static string FormatPathList(IReadOnlyCollection<int> pathIds)
    {
        return pathIds.Count == 0 ? "--" : string.Join(", ", pathIds.Select(id => $"Path {id}"));
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "--" : value;
    }

    private static string FormatBits(ulong bitsPerSecond)
    {
        if (bitsPerSecond == 0)
        {
            return "0 bps";
        }

        return bitsPerSecond >= 1_000_000
            ? $"{bitsPerSecond / 1_000_000d:N1} Mbps"
            : $"{bitsPerSecond / 1_000d:N1} kbps";
    }

    private static string FormatNullableMs(double? value)
    {
        return value.HasValue ? $"{value.Value:N1} ms" : "--";
    }

    private static string GetCleanupLabel(XBondPublicTestResult result)
    {
        if (result.BypassWasAlreadyPresent)
        {
            return "Preserved";
        }

        return result.BypassRemoved ? "Removed" : "Check";
    }

    private static string GetPathState(XBondPathStatus path)
    {
        if (!path.InterfaceUp)
        {
            return "Down";
        }

        return path.InCooldown ? "Cooldown" : "Up";
    }

    private static string FormatAge(DateTime timestampUtc)
    {
        var elapsed = DateTime.UtcNow - timestampUtc;
        if (elapsed.TotalSeconds < 5)
        {
            return "now";
        }

        if (elapsed.TotalMinutes < 1)
        {
            return $"{elapsed.TotalSeconds:N0}s ago";
        }

        return $"{elapsed.TotalMinutes:N0}m ago";
    }

    private static RenderFragment Metric(string label, string value) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "rounded-lg border border-slate-700/70 bg-slate-950/40 px-3 py-2");
        builder.OpenElement(2, "p");
        builder.AddAttribute(3, "class", "text-[11px] font-semibold uppercase tracking-wide text-slate-500");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "p");
        builder.AddAttribute(6, "class", "mt-1 break-words font-semibold text-white");
        builder.AddContent(7, value);
        builder.CloseElement();
        builder.CloseElement();
    };
}
