@page "/xbond"
@using XNetwork.Models
@using XNetwork.Services
@using XNetwork.Utils
@implements IAsyncDisposable
@inject XBondStatsService XBondStatsService
@inject XBondTrafficEngineService TrafficEngineService
@inject XBondLabService LabService
@inject XBondScopedRouteService ScopedRouteService
@inject XBondSpeedTestService SpeedTestService

<PageTitle>XBond</PageTitle>

<div class="mx-auto flex w-full max-w-6xl flex-col gap-5 px-4 pb-28 pt-4 md:px-6 md:pb-10">
    <section>
        <h1 class="text-2xl font-bold text-white">XBond</h1>
        <p class="mt-1 text-sm text-slate-400">Runtime status, diagnostics, and IPv4 route tests.</p>
    </section>

    <section class="grid gap-4 lg:grid-cols-[1.2fr_.8fr]">
        <article class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-lg font-semibold text-white">Tunnel Runtime</h2>
                    <p class="mt-1 text-sm text-slate-400">@(_snapshot?.Message ?? "Loading XBond status")</p>
                </div>
                <span class="@RuntimePillClass">@RuntimeLabel</span>
            </div>
            <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                @Info("Server", _snapshot?.ServerAddress ?? "--")
                @Info("Device", _snapshot?.TunnelDevice ?? "xbond0")
                @Info("Mode", FormatMode(_snapshot?.Mode))
                @Info("Policy", FormatMode(_snapshot?.RedundancyPolicy))
            </div>
        </article>

        <article class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
            <h2 class="text-lg font-semibold text-white">Service</h2>
            <p class="mt-1 text-sm text-slate-400">@(_trafficStatus?.Message ?? "Loading service status")</p>
            <div class="mt-4 flex flex-wrap gap-2">
                <button type="button" class="rounded-lg bg-emerald-500 px-3 py-2 text-sm font-semibold text-slate-950 disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStart ?? false) || _busy)" @onclick="StartAsync">Start</button>
                <button type="button" class="rounded-lg bg-rose-500 px-3 py-2 text-sm font-semibold text-white disabled:opacity-40" disabled="@(!(_trafficStatus?.CanStop ?? false) || _busy)" @onclick="StopAsync">Stop</button>
                <button type="button" class="rounded-lg border border-slate-700 bg-slate-950/60 px-3 py-2 text-sm font-semibold text-slate-200 disabled:opacity-40" disabled="@(!(_trafficStatus?.CanEnableAtBoot ?? false) || _busy)" @onclick="EnableBootAsync">Enable boot</button>
            </div>
        </article>
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <div class="mb-4 flex items-center justify-between gap-3">
            <h2 class="text-lg font-semibold text-white">Path Roles</h2>
            <span class="text-xs text-slate-500">Updated @FormatUpdated()</span>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
            @foreach (var path in _snapshot?.DashboardPaths ?? Array.Empty<XBondPathStatsSnapshot>())
            {
                <article class="rounded-lg border border-slate-800 bg-slate-950/50 p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="font-semibold text-white">@path.Name</h3>
                            <p class="mt-1 text-sm text-slate-500">@path.InterfaceName</p>
                        </div>
                        <span class="@RolePill(path)">@RoleLabel(path)</span>
                    </div>
                    <div class="mt-4 grid grid-cols-2 gap-3 text-sm text-slate-300 sm:grid-cols-4">
                        <span>@FormatLatency(path.RttMs)</span>
                        <span>@FormatPercent(path.LossPercent) loss</span>
                        <span class="text-cyan-300" title="@DownloadTitle(path)">Down @SpeedFormatter.FormatSpeed(path.DownloadMbps)</span>
                        <span class="text-pink-300">Up @SpeedFormatter.FormatSpeed(path.UploadMbps)</span>
                    </div>
                    <p class="mt-3 text-xs text-slate-500">
                        @path.StateText, score @Math.Round(path.Score)
                        @if (!string.IsNullOrWhiteSpace(path.DecisionText))
                        {
                            <span>, @path.DecisionText</span>
                        }
                        @if (path.DuplicateDownloadMbps > 0)
                        {
                            <span>, duplicate down @SpeedFormatter.FormatSpeed(path.DuplicateDownloadMbps)</span>
                        }
                    </p>
                </article>
            }
        </div>
    </section>

    <section class="grid gap-4 xl:grid-cols-3">
        <article class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
            <h2 class="text-lg font-semibold text-white">Heartbeat Diagnostic</h2>
            <p class="mt-1 text-sm text-slate-400">Sends sealed XBond heartbeat packets to the configured server.</p>
            <button type="button" class="mt-4 rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:opacity-40" disabled="@_busy" @onclick="RunHeartbeatAsync">
                Run heartbeat
            </button>
            @if (_heartbeat is not null)
            {
                <div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
                    <p class="font-semibold text-white">@_heartbeat.Message</p>
                    <p class="mt-1">@_heartbeat.Received/@_heartbeat.Sent received, avg @FormatLatency(_heartbeat.AvgRttMs)</p>
                    @if (!string.IsNullOrWhiteSpace(_heartbeat.Error))
                    {
                        <p class="mt-1 text-rose-200">@_heartbeat.Error</p>
                    }
                </div>
            }
        </article>

        <article class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
            <h2 class="text-lg font-semibold text-white">Multi-Path Diagnostic</h2>
            <p class="mt-1 text-sm text-slate-400">Verifies physical path isolation and duplicate packet delivery.</p>
            <button type="button" class="mt-4 rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:opacity-40" disabled="@_busy" @onclick="RunMultiPathAsync">
                Run multi-path
            </button>
            @if (_multiPath is not null)
            {
                <div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
                    <p class="font-semibold text-white">@_multiPath.Message</p>
                    <p class="mt-1">Anchor @_multiPath.AnchorPathId, ACKs @_multiPath.TotalAcks/@_multiPath.TotalSent</p>
                    @if (!string.IsNullOrWhiteSpace(_multiPath.Error))
                    {
                        <p class="mt-1 text-rose-200">@_multiPath.Error</p>
                    }
                </div>
            }
        </article>

        <article class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
            <h2 class="text-lg font-semibold text-white">Tunnel Speed Test</h2>
            <p class="mt-1 text-sm text-slate-400">Runs Pi to Vultr tunnel throughput, then a public speedtest through the current default route.</p>
            <button type="button" class="mt-4 rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:opacity-40" disabled="@_busy" @onclick="RunSpeedTestAsync">
                @(_busy ? "Running..." : "Run speed test")
            </button>
            <button type="button" class="ml-0 mt-2 rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-2 text-sm font-semibold text-amber-100 disabled:opacity-40 sm:ml-2" disabled="@_busy" @onclick="RunSimulationTestAsync">
                Simulate bad backup
            </button>
            <button type="button" class="mt-2 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-100 disabled:opacity-40" disabled="@_busy" @onclick="RunPerformanceMatrixAsync">
                Run matrix
            </button>
            <button type="button" class="ml-0 mt-2 rounded-lg border border-slate-600 bg-slate-950/60 px-4 py-2 text-sm font-semibold text-slate-200 disabled:opacity-40 sm:ml-2" disabled="@_busy" @onclick="RunMtuSweepAsync">
                MTU sweep
            </button>
            @if (_speedTest is not null)
            {
                @SpeedTestResult(_speedTest)
            }
            @if (_simulationTest is not null)
            {
                @SpeedTestResult(_simulationTest)
            }
            @if (_matrix is not null)
            {
                @PerformanceMatrixResult(_matrix)
            }
            @if (_mtuSweep is not null)
            {
                @MtuSweepResult(_mtuSweep)
            }
        </article>
    </section>

    <section class="rounded-lg border border-slate-700/70 bg-slate-900/75 p-5">
        <h2 class="text-lg font-semibold text-white">Scoped IPv4 Route</h2>
        <p class="mt-1 text-sm text-slate-400">Manual diagnostics only. This does not install automatic rollback.</p>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <input class="rounded-lg border border-slate-700 bg-slate-950/60 px-3 py-2 text-slate-100 outline-none focus:border-cyan-500 sm:w-64" @bind="_routeTarget" />
            <button type="button" class="rounded-lg bg-cyan-400 px-4 py-2 text-sm font-semibold text-slate-950 disabled:opacity-40" disabled="@_busy" @onclick="RunRouteTestAsync">Run route test</button>
        </div>
        @if (_routeTest is not null)
        {
            <div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
                <p class="font-semibold text-white">@_routeTest.Message</p>
                <p class="mt-1">Packets @_routeTest.Received/@_routeTest.Sent, avg @FormatLatency(_routeTest.AvgRttMs)</p>
                @if (!string.IsNullOrWhiteSpace(_routeTest.Error))
                {
                    <p class="mt-1 text-rose-200">@_routeTest.Error</p>
                }
            </div>
        }
    </section>
</div>

@code {
    private readonly PeriodicTimer _timer = new(TimeSpan.FromSeconds(1));
    private readonly CancellationTokenSource _refreshCts = new();
    private XBondStatsSnapshot? _snapshot;
    private XBondTrafficEngineStatus? _trafficStatus;
    private XBondPublicTestResult? _heartbeat;
    private XBondProbeResult? _multiPath;
    private XBondSpeedTestResult? _speedTest;
    private XBondSpeedTestResult? _simulationTest;
    private XBondPerformanceMatrixResult? _matrix;
    private XBondMtuSweepResult? _mtuSweep;
    private XBondScopedRouteTestResult? _routeTest;
    private string _routeTarget = "1.1.1.1";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _routeTarget = ScopedRouteService.Settings.ScopedRouteDefaultTarget;
        await RefreshAsync();
        _ = RunRefreshLoopAsync();
    }

    private async Task RunRefreshLoopAsync()
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(_refreshCts.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshAsync()
    {
        _snapshot = await XBondStatsService.GetSnapshotAsync(_refreshCts.Token);
        _trafficStatus = await TrafficEngineService.GetStatusAsync(_refreshCts.Token);
        StateHasChanged();
    }

    private async Task StartAsync() => await RunBusyAsync(() => TrafficEngineService.StartAsync());

    private async Task StopAsync() => await RunBusyAsync(() => TrafficEngineService.StopAsync());

    private async Task EnableBootAsync() => await RunBusyAsync(() => TrafficEngineService.EnableAtBootAsync());

    private async Task RunHeartbeatAsync()
    {
        await RunBusyAsync(async () =>
        {
            _heartbeat = await LabService.RunPublicHeartbeatTestAsync();
            return _trafficStatus ?? new XBondTrafficEngineStatus();
        });
    }

    private async Task RunMultiPathAsync()
    {
        await RunBusyAsync(async () =>
        {
            _multiPath = await LabService.RunPublicMultiPathTestAsync();
            return _trafficStatus ?? new XBondTrafficEngineStatus();
        });
    }

    private async Task RunRouteTestAsync()
    {
        await RunBusyAsync(async () =>
        {
            _routeTest = await ScopedRouteService.RunScopedRouteTestAsync(_routeTarget);
            return _trafficStatus ?? new XBondTrafficEngineStatus();
        });
    }

    private async Task RunSpeedTestAsync()
    {
        await RunBusyAsync(async () =>
        {
            _speedTest = await SpeedTestService.RunAsync();
            return _trafficStatus ?? new XBondTrafficEngineStatus();
        });
    }

    private async Task RunSimulationTestAsync()
    {
        await RunBusyAsync(async () =>
        {
            _simulationTest = await SpeedTestService.RunBadNetworkSimulationAsync();
            return _trafficStatus ?? new XBondTrafficEngineStatus();
        });
    }

    private async Task RunPerformanceMatrixAsync()
    {
        await RunBusyAsync(async () =>
        {
            _matrix = await SpeedTestService.RunPerformanceMatrixAsync();
            return _trafficStatus ?? new XBondTrafficEngineStatus();
        });
    }

    private async Task RunMtuSweepAsync()
    {
        await RunBusyAsync(async () =>
        {
            _mtuSweep = await SpeedTestService.RunMtuSweepAsync();
            return _trafficStatus ?? new XBondTrafficEngineStatus();
        });
    }

    private async Task RunBusyAsync(Func<Task<XBondTrafficEngineStatus>> action)
    {
        _busy = true;
        try
        {
            _trafficStatus = await action();
        }
        finally
        {
            _busy = false;
            await RefreshAsync();
        }
    }

    private string RuntimeLabel => _snapshot switch
    {
        null => "Loading",
        { HasError: true } => "Unavailable",
        { IsRunning: true } => "Running",
        _ => "Stopped"
    };

    private string RuntimePillClass => _snapshot?.IsRunning == true
        ? "rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200"
        : "rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-200";

    private static RenderFragment Info(string label, string value) => @<div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
        <p class="text-xs uppercase tracking-wide text-slate-500">@label</p>
        <p class="mt-1 truncate font-semibold text-white">@value</p>
    </div>;

    private static string RolePill(XBondPathStatsSnapshot path) => path.Role.ToLowerInvariant() switch
    {
        "anchor" => "rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200",
        "backup" => "rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 text-xs font-semibold text-cyan-200",
        "unavailable" => "rounded-full border border-slate-600 bg-slate-700/40 px-2 py-0.5 text-xs font-semibold text-slate-300",
        _ => "rounded-full border border-slate-600 bg-slate-700/40 px-2 py-0.5 text-xs font-semibold text-slate-300"
    };

    private static string RoleLabel(XBondPathStatsSnapshot path)
    {
        if (!path.IsConfigured)
        {
            return "not in XBond";
        }

        return path.Role;
    }

    private string FormatUpdated() => _snapshot?.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss") ?? "--";

    private static string FormatMode(string? mode) => string.IsNullOrWhiteSpace(mode) ? "XBond" : mode.Replace('-', ' ');

    private static string FormatLatency(double? value) => value.HasValue && value.Value > 0 ? $"{Math.Round(value.Value)} ms" : "--";

    private static string FormatPercent(double? value) => value.HasValue ? $"{Math.Round(value.Value, 1)}%" : "--";

    private static string DownloadTitle(XBondPathStatsSnapshot path) =>
        path.DuplicateDownloadMbps > 0
            ? $"Raw adapter receive: {SpeedFormatter.FormatSpeed(path.DownloadMbps)}. Useful tunnel receive: {SpeedFormatter.FormatSpeed(path.UsefulDownloadMbps)}. Duplicate receive: {SpeedFormatter.FormatSpeed(path.DuplicateDownloadMbps)}."
            : $"Useful tunnel receive: {SpeedFormatter.FormatSpeed(path.UsefulDownloadMbps)}.";

    private static string FormatSpeed(double? value) => value.HasValue ? SpeedFormatter.FormatSpeed(value.Value) : "--";

    private static string FormatSpeedTestRoute(XBondSpeedTestResult result) =>
        result.RouteUsesXBond ? "Route: XBond default" : "Route: not using XBond default";

    private static RenderFragment SpeedTestResult(XBondSpeedTestResult result) => @<div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
        <p class="font-semibold text-white">@result.Message</p>
        @if (result.IsSimulation)
        {
            <p class="mt-1 text-xs text-amber-100">
                Simulated @result.SimulatedInterface: @result.SimulationProfile. Cleanup @(result.SimulationCleanupSucceeded ? "completed" : "not confirmed").
            </p>
        }
        <div class="mt-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3">
            <div class="flex items-center justify-between gap-3">
                <p class="font-semibold text-white">Pi to Vultr</p>
                <p class="text-xs text-slate-500">@result.XBondServerEndpoint</p>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-3">
                <div>
                    <p class="text-xs text-slate-500">Download</p>
                    <p class="font-semibold text-white">@FormatSpeed(result.ServerDownloadMbps)</p>
                </div>
                <div>
                    <p class="text-xs text-slate-500">Upload</p>
                    <p class="font-semibold text-white">@FormatSpeed(result.ServerUploadMbps)</p>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(result.ServerTestError))
            {
                <p class="mt-2 text-xs text-rose-200">@result.ServerTestError</p>
            }
        </div>
        @if (!result.IsSimulation)
        {
            <div class="mt-3 rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                <div class="flex items-center justify-between gap-3">
                    <p class="font-semibold text-white">Public speedtest</p>
                    @if (!string.IsNullOrWhiteSpace(result.PublicServerName))
                    {
                        <p class="text-xs text-slate-500">@result.PublicServerName</p>
                    }
                </div>
                <div class="mt-3 grid grid-cols-3 gap-3">
                    <div>
                        <p class="text-xs text-slate-500">Download</p>
                        <p class="font-semibold text-white">@FormatSpeed(result.PublicDownloadMbps)</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500">Upload</p>
                        <p class="font-semibold text-white">@FormatSpeed(result.PublicUploadMbps)</p>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500">Ping</p>
                        <p class="font-semibold text-white">@FormatLatency(result.PublicPingMs)</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(result.PublicTestError))
                {
                    <p class="mt-2 text-xs text-rose-200">@result.PublicTestError</p>
                }
            </div>
            <p class="mt-3 text-xs text-slate-500">@FormatSpeedTestRoute(result)</p>
        }
        @if (!string.IsNullOrWhiteSpace(result.Error))
        {
            <p class="mt-1 text-rose-200">@result.Error</p>
        }
    </div>;

    private static RenderFragment PerformanceMatrixResult(XBondPerformanceMatrixResult result) => @<div class="mt-4 rounded-lg border border-cyan-500/20 bg-cyan-500/5 p-3 text-sm text-slate-300">
        <div class="flex items-center justify-between gap-3">
            <p class="font-semibold text-white">@result.Message</p>
            <span class="rounded-full border border-cyan-500/30 bg-cyan-500/10 px-2 py-0.5 text-xs font-semibold text-cyan-100">@result.BottleneckSummary</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(result.ArtifactPath))
        {
            <p class="mt-1 break-all text-xs text-slate-500">@result.ArtifactPath</p>
        }
        <div class="mt-3 grid gap-2">
            @foreach (var run in result.Runs)
            {
                <div class="rounded-lg border border-slate-800 bg-slate-950/50 p-3">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="font-semibold text-white">@run.Name</p>
                            <p class="mt-1 text-xs text-slate-500">@run.Kind @run.InterfaceName @run.Mode</p>
                        </div>
                        <span class="text-xs text-slate-400">@run.Bottleneck</span>
                    </div>
                    <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
                        <span>Down <strong class="text-cyan-200">@FormatSpeed(run.DownloadMbps)</strong></span>
                        <span>Up <strong class="text-pink-200">@FormatSpeed(run.UploadMbps)</strong></span>
                        <span>RTT <strong class="text-white">@FormatLatency(run.RttMs)</strong></span>
                        <span>Loss <strong class="text-white">@FormatPercent(run.LossPercent)</strong></span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(run.Error))
                    {
                        <p class="mt-2 text-xs text-rose-200">@run.Error</p>
                    }
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(result.Error))
        {
            <p class="mt-2 text-rose-200">@result.Error</p>
        }
    </div>;

    private static RenderFragment MtuSweepResult(XBondMtuSweepResult result) => @<div class="mt-4 rounded-lg border border-slate-800 bg-slate-950/50 p-3 text-sm text-slate-300">
        <p class="font-semibold text-white">@result.Message</p>
        <p class="mt-1 text-xs text-slate-500">Current MTU @result.CurrentMtu, recommended MTU @result.RecommendedMtu, recommended MSS @result.RecommendedMss.</p>
        <div class="mt-3 grid gap-2">
            @foreach (var probe in result.Probes)
            {
                <div class="flex items-center justify-between rounded-md border border-slate-800 bg-slate-950/50 px-3 py-2 text-xs">
                    <span>MTU @probe.Mtu / payload @probe.PayloadSize</span>
                    <span class="@(probe.Succeeded ? "text-emerald-200" : "text-rose-200")">@(probe.Succeeded ? "passed" : "failed")</span>
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(result.Error))
        {
            <p class="mt-2 text-rose-200">@result.Error</p>
        }
    </div>;

    public async ValueTask DisposeAsync()
    {
        await _refreshCts.CancelAsync();
        _timer.Dispose();
        _refreshCts.Dispose();
    }
}
