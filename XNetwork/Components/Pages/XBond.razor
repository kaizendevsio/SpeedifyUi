@page "/xbond"
@using Microsoft.AspNetCore.Components
@using XNetwork.Models
@using XNetwork.Services
@inject XBondStatusService XBondStatusService
@inject XBondLabService XBondLabService
@inject XBondTrafficEngineService XBondTrafficEngineService

<PageTitle>XBond - XNetwork</PageTitle>

<div class="p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-cyan-300">Reliability Tunnel Prototype</p>
            <h2 class="mt-1 text-3xl font-bold text-white">XBond</h2>
            <p class="mt-2 max-w-3xl text-sm text-slate-400">
                Rust dataplane prototype for dynamic stable-anchor routing, packet-level redundancy, and first-arrival-wins delivery.
            </p>
        </div>
        <button type="button"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-100 transition-colors hover:bg-cyan-500/20 disabled:cursor-not-allowed disabled:opacity-60"
                disabled="@_isLoading"
                @onclick="RefreshAsync">
            <i class="fas fa-rotate @(_isLoading ? "animate-spin" : "")"></i>
            Refresh
        </button>
    </div>

    @if (_status == null)
    {
        <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-5 text-slate-300">
            Loading XBond status...
        </div>
    }
    else
    {
        <section class="mb-6 rounded-xl border border-slate-700 bg-slate-800/50 p-4 shadow-lg">
            <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="@GetStateBadgeClass()">@GetStateLabel()</span>
                        <span class="rounded-full border border-slate-700 bg-slate-950/60 px-2.5 py-1 text-xs font-semibold text-slate-300">
                            @FormatMode(_status.Mode)
                        </span>
                    </div>
                    <h3 class="mt-3 text-xl font-semibold text-white">@GetSummaryTitle()</h3>
                    <p class="mt-2 text-sm text-slate-400">@(_status.HasError ? _status.Error : _status.Message)</p>
                </div>
                <div class="grid grid-cols-2 gap-3 text-sm md:min-w-80">
                    @Metric("Server", DisplayValue(_status.ServerAddress))
                    @Metric("Anchor", GetAnchorLabel())
                    @Metric("Tunnel", FormatTunnelState(_status.Tunnel))
                    @Metric("Data sent", _status.DataPacketsSent.ToString("N0"))
                    @Metric("Data received", _status.DataPacketsReceived.ToString("N0"))
                    @Metric("Duplicates sent", _status.DuplicatePacketsSent.ToString("N0"))
                    @Metric("Duplicates dropped", _status.DuplicatePacketsDropped.ToString("N0"))
                    @Metric("Late dropped", _status.LatePacketsDropped.ToString("N0"))
                    @Metric("FEC", GetFecLabel(_status.Fec))
                    @Metric("Updated", FormatAge(_status.UpdatedAtUtc))
                </div>
            </div>
        </section>

        <section class="mb-6 rounded-xl border border-indigo-500/20 bg-slate-800/50 shadow-lg">
            <div class="flex flex-col gap-4 border-b border-slate-700 px-4 py-4 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="@GetEngineBadgeClass()">@GetEngineModeLabel(_trafficEngineStatus?.Mode)</span>
                        @if (_trafficEngineStatus?.ClientServiceRunning == true)
                        {
                            <span class="rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200">
                                Service active
                            </span>
                        }
                        else
                        {
                            <span class="rounded-full border border-slate-700 bg-slate-950/60 px-2.5 py-1 text-xs font-semibold text-slate-400">
                                Service @_trafficEngineStatus?.ClientServiceState
                            </span>
                        }
                    </div>
                    <h3 class="mt-3 text-xl font-semibold text-white">Traffic engine</h3>
                    <p class="mt-2 text-sm text-slate-400">@(_trafficEngineStatus?.HasError == true ? _trafficEngineStatus.Error : _trafficEngineStatus?.Message)</p>
                </div>
                <div class="grid grid-cols-1 gap-2 sm:grid-cols-3 lg:min-w-[34rem]">
                    @EngineModeButton(XBondTrafficEngineModes.SpeedifyPrimary, "Speedify", "Primary")
                    @EngineModeButton(XBondTrafficEngineModes.XBondCanary, "XBond", "Canary")
                    @EngineModeButton(XBondTrafficEngineModes.XBondPrimary, "XBond", "Primary")
                </div>
            </div>
            <div class="grid gap-4 p-4 lg:grid-cols-[1fr_auto] lg:items-center">
                <div class="grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
                    @Metric("Mode", GetEngineModeLabel(_trafficEngineStatus?.Mode))
                    @Metric("Client service", DisplayValue(_trafficEngineStatus?.ClientServiceName))
                    @Metric("Service state", DisplayValue(_trafficEngineStatus?.ClientServiceState))
                    @Metric("Control", _trafficEngineStatus?.ServiceControlAllowed == true ? "Unlocked" : "Locked")
                </div>
                <div class="flex flex-col gap-2 sm:flex-row">
                    <button type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-100 transition-colors hover:bg-emerald-500/20 disabled:cursor-not-allowed disabled:opacity-60"
                            disabled="@(!CanStartCanary() || _isChangingTrafficEngine)"
                            @onclick="StartXBondCanaryAsync">
                        <i class="fas fa-play @(_isChangingTrafficEngine ? "animate-pulse" : "")"></i>
                        Start Canary
                    </button>
                    <button type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-2 text-sm font-semibold text-amber-100 transition-colors hover:bg-amber-500/20 disabled:cursor-not-allowed disabled:opacity-60"
                            disabled="@(!CanStopCanary() || _isChangingTrafficEngine)"
                            @onclick="StopXBondCanaryAsync">
                        <i class="fas fa-stop @(_isChangingTrafficEngine ? "animate-pulse" : "")"></i>
                        Stop XBond
                    </button>
                </div>
            </div>
        </section>

        <section class="mb-6 grid gap-4 lg:grid-cols-3">
            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Data paths</p>
                <p class="mt-2 text-2xl font-bold text-white">@FormatPathList(_status.Schedule.DataPathIds)</p>
                <p class="mt-1 text-sm text-slate-400">Immediate packets use only the selected anchor path.</p>
            </div>
            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Duplicate paths</p>
                <p class="mt-2 text-2xl font-bold text-white">@FormatPathList(_status.Schedule.DuplicatePathIds)</p>
                <p class="mt-1 text-sm text-slate-400">Late duplicates are discarded by sequence number.</p>
            </div>
            <div class="rounded-xl border border-slate-700 bg-slate-800/50 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">FEC paths</p>
                <p class="mt-2 text-2xl font-bold text-white">@FormatPathList(_status.Schedule.FecPathIds)</p>
                <p class="mt-1 text-sm text-slate-400">@_status.Fec.Message</p>
            </div>
        </section>

        <section class="mb-6 rounded-xl border border-cyan-500/20 bg-slate-800/50 shadow-lg">
            <div class="flex flex-col gap-4 border-b border-slate-700 px-4 py-4 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-semibold text-white">XBond Lab</h3>
                    <p class="mt-1 text-sm text-slate-400">Single heartbeat can use Speedify bypass; multi-path probes use physical interface isolation by default.</p>
                </div>
                <div class="flex flex-col gap-2 sm:flex-row">
                    <button type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-4 py-2 text-sm font-semibold text-cyan-100 transition-colors hover:bg-cyan-500/20 disabled:cursor-not-allowed disabled:opacity-60"
                            disabled="@(_isRunningPublicTest || _isRunningMultiPathTest)"
                            @onclick="RunPublicTestAsync">
                        <i class="fas fa-satellite-dish @(_isRunningPublicTest ? "animate-pulse" : "")"></i>
                        @(_isRunningPublicTest ? "Running..." : "Run Public Test")
                    </button>
                    <button type="button"
                            class="inline-flex items-center justify-center gap-2 rounded-lg border border-emerald-500/40 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-100 transition-colors hover:bg-emerald-500/20 disabled:cursor-not-allowed disabled:opacity-60"
                            disabled="@(_isRunningPublicTest || _isRunningMultiPathTest)"
                            @onclick="RunMultiPathTestAsync">
                        <i class="fas fa-code-branch @(_isRunningMultiPathTest ? "animate-pulse" : "")"></i>
                        @(_isRunningMultiPathTest ? "Probing..." : "Run Multi-Path Probe")
                    </button>
                </div>
            </div>
            <div class="grid gap-4 p-4 lg:grid-cols-[1fr_1.2fr]">
                <div class="grid grid-cols-2 gap-3 text-sm">
                    @Metric("Server", XBondLabService.Settings.PublicTestServerAddress)
                    @Metric("Heartbeat bypass", $"{XBondLabService.Settings.PublicTestBypassPort}/{XBondLabService.Settings.PublicTestBypassProtocol}")
                    @Metric("Multi-path bypass", XBondLabService.Settings.MultiPathUseSpeedifyBypass ? "Enabled" : "Disabled")
                    @Metric("Packets", XBondLabService.Settings.PublicTestCount.ToString("N0"))
                    @Metric("Timeout", $"{XBondLabService.Settings.PublicTestPacketTimeoutMs:N0} ms")
                    @Metric("Probe config", GetProbeConfigLabel())
                </div>
                <div class="rounded-xl border border-slate-700/70 bg-slate-950/40 p-4">
                    @if (_isRunningPublicTest)
                    {
                        <div class="flex items-center gap-3 text-cyan-100">
                            <i class="fas fa-circle-notch animate-spin"></i>
                            <span class="text-sm font-semibold">Running public heartbeat test...</span>
                        </div>
                    }
                    else if (_publicTestResult == null)
                    {
                        <p class="text-sm text-slate-400">No public test has been run in this dashboard session.</p>
                    }
                    else
                    {
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="@GetTestBadgeClass(_publicTestResult)">
                                @(_publicTestResult.Succeeded ? "Passed" : "Failed")
                            </span>
                            <span class="text-sm text-slate-400">@_publicTestResult.Message</span>
                        </div>

                        @if (_publicTestResult.HasError)
                        {
                            <p class="mt-3 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-100">
                                @_publicTestResult.Error
                            </p>
                        }

                        <div class="mt-4 grid grid-cols-2 gap-3 text-sm md:grid-cols-4">
                            @Metric("Sent", _publicTestResult.Sent.ToString("N0"))
                            @Metric("Received", _publicTestResult.Received.ToString("N0"))
                            @Metric("Loss", $"{_publicTestResult.LossRate:P1}")
                            @Metric("Avg RTT", FormatNullableMs(_publicTestResult.AvgRttMs))
                            @Metric("Min RTT", FormatNullableMs(_publicTestResult.MinRttMs))
                            @Metric("Max RTT", FormatNullableMs(_publicTestResult.MaxRttMs))
                            @Metric("Client bind", DisplayValue(_publicTestResult.Bind))
                            @Metric("Cleanup", GetCleanupLabel(_publicTestResult))
                        </div>
                    }
                </div>
                <div class="rounded-xl border border-emerald-500/20 bg-slate-950/40 p-4 lg:col-span-2">
                    <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                        <div>
                            <h4 class="text-sm font-semibold uppercase tracking-wide text-emerald-200">Multi-path shadow probe</h4>
                            <p class="mt-1 text-sm text-slate-400">Duplicate heartbeats across configured paths; first arrival wins.</p>
                        </div>
                        @if (_multiPathTestResult != null)
                        {
                            <span class="@GetProbeBadgeClass(_multiPathTestResult)">
                                @GetProbeBadgeLabel(_multiPathTestResult)
                            </span>
                        }
                    </div>

                    @if (_isRunningMultiPathTest)
                    {
                        <div class="mt-4 flex items-center gap-3 text-emerald-100">
                            <i class="fas fa-circle-notch animate-spin"></i>
                            <span class="text-sm font-semibold">Running multi-path probe...</span>
                        </div>
                    }
                    else if (_multiPathTestResult == null)
                    {
                        <p class="mt-4 text-sm text-slate-400">No multi-path probe has been run in this dashboard session.</p>
                    }
                    else
                    {
                        <p class="mt-3 text-sm text-slate-400">@_multiPathTestResult.Message</p>

                        @if (_multiPathTestResult.HasError)
                        {
                            <p class="mt-3 rounded-lg border border-red-500/30 bg-red-500/10 px-3 py-2 text-sm text-red-100">
                                @_multiPathTestResult.Error
                            </p>
                        }

                        <div class="mt-4 grid grid-cols-2 gap-3 text-sm md:grid-cols-5">
                            @Metric("Mode", FormatMode(_multiPathTestResult.Mode))
                            @Metric("Anchor", FormatProbePathId(_multiPathTestResult.AnchorPathId))
                            @Metric("Duplicates", FormatPathList(_multiPathTestResult.DuplicatePathIds))
                            @Metric("First arrivals", $"{_multiPathTestResult.TotalFirstArrivals:N0}/{_multiPathTestResult.ExpectedSequences:N0}")
                            @Metric("Total ACKs", _multiPathTestResult.TotalAcks.ToString("N0"))
                        </div>

                        <div class="mt-4 overflow-hidden rounded-xl border border-slate-700/70">
                            <div class="grid grid-cols-[1.2fr_0.8fr_0.8fr_0.8fr_1.1fr] gap-3 border-b border-slate-700 bg-slate-900/70 px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                <span>Path</span>
                                <span>Packets</span>
                                <span>RTT</span>
                                <span>Route</span>
                                <span>Source</span>
                            </div>
                            <div class="divide-y divide-slate-700/70">
                                @foreach (var path in _multiPathTestResult.Paths)
                                {
                                    <div class="grid gap-3 px-3 py-3 text-sm text-slate-200 md:grid-cols-[1.2fr_0.8fr_0.8fr_0.8fr_1.1fr] md:items-center">
                                        <div class="min-w-0">
                                            <p class="truncate font-semibold text-white">@FormatProbePathName(path)</p>
                                            <p class="mt-0.5 text-xs text-slate-500">ID @path.PathId</p>
                                        </div>
                                        <div>
                                            <p>@path.FirstArrivals first / @path.Acks ACK</p>
                                            <p class="text-xs text-slate-500">@path.Sent sent, @($"{path.LossRate:P1}") loss</p>
                                        </div>
                                        <div>
                                            <p>@FormatNullableMs(path.AvgRttMs)</p>
                                            <p class="text-xs text-slate-500">Dup drops @FormatNullableCount(path.DuplicatesDropped)</p>
                                        </div>
                                        <div>
                                            <span class="@GetRouteBadgeClass(path)">@GetRouteLabel(path)</span>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="truncate">@DisplayValue(path.Source)</p>
                                            <p class="mt-0.5 truncate text-xs text-slate-500">@DisplayValue(path.RouteVerification.Reason)</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="rounded-xl border border-slate-700 bg-slate-800/50 shadow-lg">
            <div class="border-b border-slate-700 px-4 py-3">
                <h3 class="text-lg font-semibold text-white">Path health</h3>
                <p class="mt-1 text-sm text-slate-400">Roles are selected by observed health, not adapter name.</p>
            </div>
            <div class="divide-y divide-slate-700/70">
                @if (_status.Paths.Count == 0)
                {
                    <div class="p-4 text-sm text-slate-400">No XBond paths are configured yet.</div>
                }
                else
                {
                    @foreach (var path in _status.Paths)
                    {
                        <div class="grid gap-3 p-4 md:grid-cols-[1fr_auto] md:items-center">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="font-semibold text-white">@path.Name</p>
                                    <span class="@GetRoleBadgeClass(path.Role)">@FormatRole(path.Role)</span>
                                    <span class="@GetIsolationBadgeClass(path.PathIsolation)">@GetIsolationLabel(path.PathIsolation)</span>
                                    <span class="rounded-full border border-slate-700 bg-slate-950/60 px-2 py-0.5 text-xs font-semibold text-slate-400">
                                        ID @path.PathId
                                    </span>
                                </div>
                                <p class="mt-1 text-sm text-slate-400">@DisplayPathBinding(path)</p>
                            </div>
                            <div class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4 lg:grid-cols-8">
                                @Metric("Score", path.Score.ToString("N0"))
                                @Metric("RTT", path.RttMs.HasValue ? $"{path.RttMs.Value:N0} ms" : "--")
                                @Metric("Jitter", path.JitterMs.HasValue ? $"{path.JitterMs.Value:N0} ms" : "--")
                                @Metric("Loss", $"{path.LossRate:P1}")
                                @Metric("Late", $"{path.LateRate:P1}")
                                @Metric("Queue", path.QueueDepth.ToString("N0"))
                                @Metric("Throughput", FormatBits(path.ThroughputBps))
                                @Metric("State", GetPathState(path))
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private XBondStatus? _status;
    private XBondTrafficEngineStatus? _trafficEngineStatus;
    private XBondPublicTestResult? _publicTestResult;
    private XBondProbeResult? _multiPathTestResult;
    private bool _isLoading;
    private bool _isRunningPublicTest;
    private bool _isRunningMultiPathTest;
    private bool _isChangingTrafficEngine;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        try
        {
            var statusTask = XBondStatusService.GetStatusAsync();
            var trafficTask = XBondTrafficEngineService.GetStatusAsync();
            await Task.WhenAll(statusTask, trafficTask);
            _status = await statusTask;
            _trafficEngineStatus = await trafficTask;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunPublicTestAsync()
    {
        _isRunningPublicTest = true;
        try
        {
            _publicTestResult = await XBondLabService.RunPublicHeartbeatTestAsync();
        }
        finally
        {
            _isRunningPublicTest = false;
        }
    }

    private async Task RunMultiPathTestAsync()
    {
        _isRunningMultiPathTest = true;
        try
        {
            _multiPathTestResult = await XBondLabService.RunPublicMultiPathTestAsync();
        }
        finally
        {
            _isRunningMultiPathTest = false;
        }
    }

    private async Task SetTrafficEngineModeAsync(string mode)
    {
        _isChangingTrafficEngine = true;
        try
        {
            _trafficEngineStatus = await XBondTrafficEngineService.SetModeAsync(mode);
            _status = await XBondStatusService.GetStatusAsync();
        }
        finally
        {
            _isChangingTrafficEngine = false;
        }
    }

    private async Task StartXBondCanaryAsync()
    {
        _isChangingTrafficEngine = true;
        try
        {
            _trafficEngineStatus = await XBondTrafficEngineService.StartCanaryAsync();
            _status = await XBondStatusService.GetStatusAsync();
        }
        finally
        {
            _isChangingTrafficEngine = false;
        }
    }

    private async Task StopXBondCanaryAsync()
    {
        _isChangingTrafficEngine = true;
        try
        {
            _trafficEngineStatus = await XBondTrafficEngineService.StopCanaryAsync();
            _status = await XBondStatusService.GetStatusAsync();
        }
        finally
        {
            _isChangingTrafficEngine = false;
        }
    }

    private bool CanStartCanary() => _trafficEngineStatus?.CanStartCanary == true;

    private bool CanStopCanary() => _trafficEngineStatus?.CanStopCanary == true;

    private string GetStateLabel()
    {
        if (_status?.HasError == true)
        {
            return "Error";
        }

        if (_status?.Running == true)
        {
            return "Running";
        }

        return _status?.Enabled == true ? "Enabled" : "Disabled";
    }

    private string GetStateBadgeClass()
    {
        if (_status?.HasError == true)
        {
            return "rounded-full border border-red-500/40 bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-200";
        }

        if (_status?.Running == true)
        {
            return "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200";
        }

        return _status?.Enabled == true
            ? "rounded-full border border-cyan-500/40 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-200"
            : "rounded-full border border-slate-700 bg-slate-950/60 px-2.5 py-1 text-xs font-semibold text-slate-400";
    }

    private string GetSummaryTitle()
    {
        if (_status?.HasError == true)
        {
            return "Status command failed";
        }

        if (_status?.Running == true)
        {
            return "XBond tunnel is running";
        }

        return _status?.Enabled == true ? "XBond prototype is enabled" : "XBond prototype is parked";
    }

    private string GetAnchorLabel()
    {
        if (_status?.AnchorPathId == null)
        {
            return "--";
        }

        var path = _status.Paths.FirstOrDefault(path => path.PathId == _status.AnchorPathId.Value);
        return path == null ? $"Path {_status.AnchorPathId}" : $"{path.Name} ({path.PathId})";
    }

    private static string FormatMode(string mode)
    {
        return mode switch
        {
            "anchor-only" => "Anchor Only",
            "anchor-duplicate-1" => "Anchor + Duplicate",
            "anchor-fec" => "Anchor + FEC",
            "full-duplicate-debug" => "Full Duplicate Debug",
            _ => mode
        };
    }

    private static string GetEngineModeLabel(string? mode)
    {
        return XBondTrafficEngineModes.Normalize(mode) switch
        {
            XBondTrafficEngineModes.XBondCanary => "XBond Canary",
            XBondTrafficEngineModes.XBondPrimary => "XBond Primary",
            _ => "Speedify Primary"
        };
    }

    private string GetEngineBadgeClass()
    {
        return XBondTrafficEngineModes.Normalize(_trafficEngineStatus?.Mode) switch
        {
            XBondTrafficEngineModes.XBondCanary => "rounded-full border border-cyan-500/40 bg-cyan-500/10 px-2.5 py-1 text-xs font-semibold text-cyan-200",
            XBondTrafficEngineModes.XBondPrimary => "rounded-full border border-fuchsia-500/40 bg-fuchsia-500/10 px-2.5 py-1 text-xs font-semibold text-fuchsia-200",
            _ => "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200"
        };
    }

    private static string FormatRole(string role)
    {
        return role switch
        {
            "anchor" => "Anchor",
            "backup" => "Backup",
            "probe" => "Probe",
            "cooldown" => "Cooling down",
            "unavailable" => "Unavailable",
            _ => role
        };
    }

    private static string FormatTunnelState(XBondTunnelStatus tunnel)
    {
        if (!string.IsNullOrWhiteSpace(tunnel.DeviceName))
        {
            return $"{FormatStateLabel(tunnel.State)} ({tunnel.DeviceName})";
        }

        return FormatStateLabel(tunnel.State);
    }

    private static string GetFecLabel(XBondFecStatus fec)
    {
        if (!fec.Configured)
        {
            return "Not configured";
        }

        return fec.ProductionReady ? "Ready" : "Canary stub";
    }

    private static string GetIsolationLabel(XBondPathIsolationStatus isolation)
    {
        if (isolation.Active)
        {
            return "Isolated";
        }

        return isolation.Requested ? "Isolation pending" : "No isolation";
    }

    private static string GetIsolationBadgeClass(XBondPathIsolationStatus isolation)
    {
        if (isolation.Active)
        {
            return "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200";
        }

        if (isolation.Requested)
        {
            return "rounded-full border border-cyan-500/40 bg-cyan-500/10 px-2 py-0.5 text-xs font-semibold text-cyan-200";
        }

        return "rounded-full border border-slate-700 bg-slate-950/60 px-2 py-0.5 text-xs font-semibold text-slate-400";
    }

    private static string DisplayPathBinding(XBondPathStatus path)
    {
        var parts = new[]
        {
            path.InterfaceName,
            string.IsNullOrWhiteSpace(path.BindAddress) ? null : $"bind {path.BindAddress}",
            string.IsNullOrWhiteSpace(path.PathIsolation.Message) ? null : path.PathIsolation.Message
        }.Where(part => !string.IsNullOrWhiteSpace(part));

        return string.Join(" - ", parts);
    }

    private static string FormatStateLabel(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "--";
        }

        return string.Join(' ', value.Split('-', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => char.ToUpperInvariant(part[0]) + part[1..]));
    }

    private static string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "anchor" => "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200",
            "backup" => "rounded-full border border-cyan-500/40 bg-cyan-500/10 px-2 py-0.5 text-xs font-semibold text-cyan-200",
            "cooldown" => "rounded-full border border-amber-500/40 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-200",
            "unavailable" => "rounded-full border border-red-500/40 bg-red-500/10 px-2 py-0.5 text-xs font-semibold text-red-200",
            _ => "rounded-full border border-slate-700 bg-slate-950/60 px-2 py-0.5 text-xs font-semibold text-slate-400"
        };
    }

    private static string GetTestBadgeClass(XBondPublicTestResult result)
    {
        return result.Succeeded
            ? "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200"
            : "rounded-full border border-red-500/40 bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-200";
    }

    private static string GetProbeBadgeClass(XBondProbeResult result)
    {
        if (result.FullyVerified)
        {
            return "rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-200";
        }

        if (result.Succeeded)
        {
            return "rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-200";
        }

        return result.HasAnyPathResponse
            ? "rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-200"
            : "rounded-full border border-red-500/40 bg-red-500/10 px-2.5 py-1 text-xs font-semibold text-red-200";
    }

    private static string GetProbeBadgeLabel(XBondProbeResult result)
    {
        if (result.FullyVerified)
        {
            return "Verified";
        }

        if (result.Succeeded)
        {
            return "Route warning";
        }

        return result.HasAnyPathResponse ? "Degraded" : "Failed";
    }

    private static string GetRouteBadgeClass(XBondProbePathResult path)
    {
        return path.RouteVerified
            ? "inline-flex rounded-full border border-emerald-500/40 bg-emerald-500/10 px-2 py-0.5 text-xs font-semibold text-emerald-200"
            : "inline-flex rounded-full border border-amber-500/40 bg-amber-500/10 px-2 py-0.5 text-xs font-semibold text-amber-200";
    }

    private static string GetRouteLabel(XBondProbePathResult path)
    {
        return path.RouteVerified ? "Verified" : "Unverified";
    }

    private static string FormatPathList(IReadOnlyCollection<int> pathIds)
    {
        return pathIds.Count == 0 ? "--" : string.Join(", ", pathIds.Select(id => $"Path {id}"));
    }

    private static string FormatProbePathId(int? pathId)
    {
        return pathId.HasValue ? $"Path {pathId.Value}" : "--";
    }

    private string GetProbeConfigLabel()
    {
        if (XBondLabService.Settings.PublicTestPathIds.Count > 0)
        {
            return string.Join(", ", XBondLabService.Settings.PublicTestPathIds.Select(id => $"Path {id}"));
        }

        if (XBondLabService.Settings.PublicTestBinds.Count > 0)
        {
            return $"{XBondLabService.Settings.PublicTestBinds.Count:N0} bind override(s)";
        }

        return "client.toml paths";
    }

    private static string FormatProbePathName(XBondProbePathResult path)
    {
        var name = string.IsNullOrWhiteSpace(path.Adapter) ? $"Path {path.PathId}" : path.Adapter;
        if (!string.IsNullOrWhiteSpace(path.InterfaceName))
        {
            return $"{name} ({path.InterfaceName})";
        }

        return name;
    }

    private static string DisplayValue(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "--" : value;
    }

    private static string FormatBits(ulong bitsPerSecond)
    {
        if (bitsPerSecond == 0)
        {
            return "0 bps";
        }

        return bitsPerSecond >= 1_000_000
            ? $"{bitsPerSecond / 1_000_000d:N1} Mbps"
            : $"{bitsPerSecond / 1_000d:N1} kbps";
    }

    private static string FormatNullableMs(double? value)
    {
        return value.HasValue ? $"{value.Value:N1} ms" : "--";
    }

    private static string FormatNullableCount(int? value)
    {
        return value.HasValue ? value.Value.ToString("N0") : "--";
    }

    private static string GetCleanupLabel(XBondPublicTestResult result)
    {
        if (result.BypassWasAlreadyPresent)
        {
            return "Preserved";
        }

        return result.BypassRemoved ? "Removed" : "Check";
    }

    private static string GetPathState(XBondPathStatus path)
    {
        if (!path.InterfaceUp)
        {
            return "Down";
        }

        return path.InCooldown ? "Cooldown" : "Up";
    }

    private static string FormatAge(DateTime timestampUtc)
    {
        var elapsed = DateTime.UtcNow - timestampUtc;
        if (elapsed.TotalSeconds < 5)
        {
            return "now";
        }

        if (elapsed.TotalMinutes < 1)
        {
            return $"{elapsed.TotalSeconds:N0}s ago";
        }

        return $"{elapsed.TotalMinutes:N0}m ago";
    }

    private static RenderFragment Metric(string label, string value) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "rounded-lg border border-slate-700/70 bg-slate-950/40 px-3 py-2");
        builder.OpenElement(2, "p");
        builder.AddAttribute(3, "class", "text-[11px] font-semibold uppercase tracking-wide text-slate-500");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "p");
        builder.AddAttribute(6, "class", "mt-1 break-words font-semibold text-white");
        builder.AddContent(7, value);
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment EngineModeButton(string mode, string title, string detail) => builder =>
    {
        var normalizedCurrent = XBondTrafficEngineModes.Normalize(_trafficEngineStatus?.Mode);
        var selected = normalizedCurrent == mode;
        var disabled = _isChangingTrafficEngine ||
                       (mode == XBondTrafficEngineModes.XBondPrimary &&
                        _trafficEngineStatus?.PrimaryModeAllowed != true);
        var css = selected
            ? "rounded-lg border border-cyan-400/60 bg-cyan-500/20 px-3 py-3 text-left shadow-lg shadow-cyan-950/30"
            : "rounded-lg border border-slate-700/80 bg-slate-950/40 px-3 py-3 text-left transition-colors hover:border-cyan-500/50 hover:bg-slate-900/70 disabled:cursor-not-allowed disabled:opacity-50";

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", css);
        builder.AddAttribute(3, "disabled", disabled);
        builder.AddAttribute(4, "onclick", EventCallback.Factory.Create(this, () => SetTrafficEngineModeAsync(mode)));
        builder.OpenElement(5, "p");
        builder.AddAttribute(6, "class", "text-sm font-semibold text-white");
        builder.AddContent(7, title);
        builder.CloseElement();
        builder.OpenElement(8, "p");
        builder.AddAttribute(9, "class", selected ? "mt-1 text-xs font-semibold text-cyan-100" : "mt-1 text-xs font-semibold text-slate-400");
        builder.AddContent(10, detail);
        builder.CloseElement();
        builder.CloseElement();
    };
}
