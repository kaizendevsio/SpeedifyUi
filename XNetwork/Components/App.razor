<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <base href="/"/>
        
        <!-- PWA Manifest -->
        <link rel="manifest" href="/manifest.json?v=20260511-xnetwork-logo"/>
        <link rel="icon" type="image/png" href="/icons/xnetwork-logo.png?v=20260511"/>
        <link rel="shortcut icon" type="image/png" href="/icons/xnetwork-logo.png?v=20260511"/>
        <meta name="theme-color" content="#1e293b"/>
        
        <!-- Apple Touch Icons -->
        <meta name="apple-mobile-web-app-capable" content="yes"/>
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
        <meta name="apple-mobile-web-app-title" content="XNetwork"/>
        <link rel="apple-touch-icon" sizes="180x180" href="/icons/xnetwork-logo.png?v=20260511"/>
        
        <!-- App Description -->
        <meta name="description" content="XNetwork - Speedify and Cudy network management"/>
        <meta name="application-name" content="XNetwork"/>
        
        <!-- Stylesheets -->
        <link rel="stylesheet" href="vendor/odometer/odometer-theme-minimal.min.css" />
        <link rel="stylesheet" href="@Assets["app.css"]"/>
        <link rel="stylesheet" href="@Assets["XNetwork.styles.css"]"/>
        <link rel="stylesheet" href="vendor/fontawesome/css/all.min.css" />
        
        <!-- Scripts -->
        <script src="vendor/tailwind/tailwindcss-3.4.17.js"></script>
        <script src="vendor/chartjs/chart.umd.min.js"></script>
        <script>window.odometerOptions = { auto: false, duration: 300 };</script>
        <script src="vendor/odometer/odometer.min.js"></script>
        
        <script script="@Assets["statisticsCharts.js"]"></script>
        <ImportMap/>
        <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(false))"/>
    </head>

    <body>
        <Routes @rendermode="@(new InteractiveServerRenderMode(false))"/>
        <div id="components-reconnect-modal" class="components-reconnect-hide xnetwork-reconnect-shell" data-nosnippet>
            <div class="xnetwork-reconnect-blur" aria-hidden="true"></div>
            <div class="xnetwork-reconnect-toast" role="status" aria-live="polite">
                <div class="xnetwork-reconnect-spinner" aria-hidden="true"></div>
                <div class="xnetwork-reconnect-copy">
                    <p class="xnetwork-reconnect-title xnetwork-reconnect-title-trying">Connection stalled</p>
                    <p class="xnetwork-reconnect-title xnetwork-reconnect-title-failed">Still reconnecting</p>
                    <p class="xnetwork-reconnect-title xnetwork-reconnect-title-rejected">Session expired</p>
                    <p class="xnetwork-reconnect-message xnetwork-reconnect-message-trying">
                        Restoring the live dashboard connection.
                    </p>
                    <p class="xnetwork-reconnect-message xnetwork-reconnect-message-failed">
                        Automatic retries are continuing in the background.
                    </p>
                    <p class="xnetwork-reconnect-message xnetwork-reconnect-message-rejected">
                        Reloading will create a fresh dashboard session.
                    </p>
                    <p class="xnetwork-reconnect-attempt">
                        Attempt <span id="components-reconnect-current-attempt">0</span>/<span id="components-reconnect-max-retries">0</span>
                    </p>
                </div>
                <div class="xnetwork-reconnect-actions">
                    <button id="xnetwork-reconnect-retry" type="button" class="xnetwork-reconnect-button">Retry</button>
                    <button id="xnetwork-reconnect-reload" type="button" class="xnetwork-reconnect-button xnetwork-reconnect-button-primary">Reload</button>
                </div>
            </div>
        </div>
        <script src="_framework/blazor.web.js" autostart="false"></script>
        <script src="js/blazorReconnect.js"></script>
        <script>
            window.XNetworkBlazorReconnect.start()
                .catch(error => console.error('[XNetwork] Blazor startup failed', error));
        </script>
        
        <!-- PWA Service Worker Registration -->
        <script src="js/pwa.js"></script>
    </body>

</html>
