<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <base href="/"/>
        
        <!-- PWA Manifest -->
        <link rel="manifest" href="/manifest.json?v=20260721-ulink"/>
        <link rel="icon" type="image/svg+xml" href="/icons/ulink-logo.svg?v=202606105"/>
        <link rel="shortcut icon" type="image/svg+xml" href="/icons/ulink-logo.svg?v=202606105"/>
        <meta name="theme-color" content="#1e1e1e"/>
        
        <!-- Apple Touch Icons -->
        <meta name="apple-mobile-web-app-capable" content="yes"/>
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
        <meta name="apple-mobile-web-app-title" content="uLink"/>
        <link rel="apple-touch-icon" href="/icons/ulink-logo.svg?v=202606105"/>
        
        <!-- App Description -->
        <meta name="description" content="uLink - resilient multi-path network management"/>
        <meta name="application-name" content="uLink"/>
        
        <!-- Stylesheets -->
        <link rel="stylesheet" href="vendor/odometer/odometer-theme-minimal.min.css" />
        <link rel="stylesheet" href="@Assets["app.css"]"/>
        <link rel="stylesheet" href="@Assets["XNetwork.styles.css"]"/>
        <link rel="stylesheet" href="vendor/fontawesome/css/all.min.css" />
        
        <!-- Scripts -->
        <script src="vendor/tailwind/tailwindcss-3.4.17.js"></script>
        <script src="vendor/chartjs/chart.umd.min.js"></script>
        <script>window.odometerOptions = { auto: false, duration: 300 };</script>
        <script src="vendor/odometer/odometer.min.js"></script>
        
        <script script="@Assets["statisticsCharts.js"]"></script>
        <ImportMap/>
        <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(false))"/>
    </head>

    <body>
        <Routes @rendermode="@(new InteractiveServerRenderMode(false))"/>
        <div id="components-reconnect-modal" class="components-reconnect-hide xnetwork-reconnect-shell" data-nosnippet>
            <div class="xnetwork-reconnect-blur" aria-hidden="true"></div>
            <div class="xnetwork-reconnect-toast" role="status" aria-live="polite">
                <div class="xnetwork-reconnect-spinner" aria-hidden="true"></div>
                <p class="xnetwork-reconnect-text xnetwork-reconnect-text-trying">Reconnecting dashboard</p>
                <p class="xnetwork-reconnect-text xnetwork-reconnect-text-failed">Still reconnecting</p>
                <p class="xnetwork-reconnect-text xnetwork-reconnect-text-rejected">Session expired. Reloading</p>
            </div>
        </div>
        <script src="_framework/blazor.web.js" autostart="false"></script>
        <script src="js/blazorReconnect.js"></script>
        <script>
            window.XNetworkBlazorReconnect.start()
                .catch(error => console.error('[uLink] Blazor startup failed', error));
        </script>
        
        <!-- PWA Service Worker Registration -->
        <script src="js/pwa.js"></script>
    </body>

</html>
