@inherits LayoutComponentBase
@implements IAsyncDisposable
@using XNetwork.Components.Custom
@using XNetwork.Models
@using XNetwork.Services
@inject BuildInfoService BuildInfoService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject RouteTransitionDirectionService RouteTransitionDirection

<div class="flex min-h-screen bg-slate-900">
    <!-- SIDEBAR (Desktop) -->
    <aside class="hidden md:flex md:flex-col md:w-64 bg-slate-950 p-4 border-r border-slate-800 h-screen sticky top-0">
        <div class="mb-8">
            <img src="/icons/ulink-logo-horizontal.svg?v=20260724-brand" alt="uLink" class="h-12 w-auto max-w-full brightness-0 invert" />
        </div>
        <nav class="flex flex-col gap-2">
            <NavLink href="/" Match="NavLinkMatch.All" 
                     class="desktop-nav-item"
                     ActiveClass="desktop-nav-item-active">
                <i class="fas fa-tachometer-alt w-6 text-center text-lg"></i>
                <span class="font-medium">Dashboard</span>
            </NavLink>
            <NavLink href="/details"
                      class="desktop-nav-item"
                      ActiveClass="desktop-nav-item-active">
                <i class="fas fa-chart-line w-6 text-center text-lg"></i>
                <span class="font-medium">Analytics</span>
            </NavLink>
            <NavLink href="/xrouter"
                      class="desktop-nav-item"
                      ActiveClass="desktop-nav-item-active">
                <i class="fas fa-wifi w-6 text-center text-lg"></i>
                <span class="font-medium">Wifi</span>
            </NavLink>
            <NavLink href="/settings"
                      class="desktop-nav-item"
                      ActiveClass="desktop-nav-item-active">
                <i class="fas fa-cog w-6 text-center text-lg"></i>
                <span class="font-medium">Settings</span>
            </NavLink>
        </nav>
        <div class="mt-auto rounded-xl border border-slate-800 bg-slate-900/70 p-3 text-xs text-slate-500">
            <button type="button"
                    class="w-full rounded-lg text-left transition-colors hover:bg-slate-800/60 focus:outline-none focus:ring-2 focus:ring-cyan-500/40"
                    title="Open changelog for version @BuildInfo.DisplayVersion"
                    aria-label="Open changelog for version @BuildInfo.DisplayVersion"
                    @onclick="OpenChangelog">
                <div class="flex items-center justify-between gap-2 font-semibold text-slate-300">
                    <span>Version @BuildInfo.DisplayVersion</span>
                    <i class="fas fa-circle-info text-[11px] text-cyan-300" aria-hidden="true"></i>
                </div>
                <div class="mt-1 truncate">Commit @BuildInfo.ShortCommit</div>
                <div class="truncate">@BuildInfo.Branch</div>
                <div>@FormatBuildTime()</div>
            </button>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content-shell">
        <!-- App Header (Mobile) -->
        <header class="mobile-app-header">
            <div class="flex items-center justify-between gap-3">
                <div class="flex min-w-0 items-center">
                    <img src="/icons/ulink-logo-horizontal.svg?v=20260724-brand" alt="uLink" class="h-8 w-auto max-w-[9rem] brightness-0 invert" />
                </div>
                <button type="button"
                        class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-slate-700/80 bg-slate-950/60 px-2.5 py-1 text-xs font-semibold text-slate-300 transition-colors hover:border-cyan-500/50 hover:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/40"
                        title="Open changelog for version @BuildInfo.DisplayVersion"
                        aria-label="Open changelog for version @BuildInfo.DisplayVersion"
                        @onclick="OpenChangelog">
                    @BuildInfo.DisplayVersion
                    <i class="fas fa-circle-info text-[11px] text-cyan-300" aria-hidden="true"></i>
                </button>
            </div>
        </header>

        <div class="route-transition-host">
            @Body
        </div>
    </main>
</div>

<ActionSheet IsOpen="_showChangelog"
             Title="Changelog"
             Description="@($"Latest version {BuildInfo.DisplayVersion}")"
             CloseLabel="Close changelog"
             MaxWidthClass="md:max-w-xl"
             BodyClass="p-0"
             OnClose="CloseChangelogAsync">
    <div class="divide-y divide-slate-800">
        @foreach (var entry in AppChangelog.Entries)
        {
            <article class="p-4">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="font-semibold text-white">@entry.Version</p>
                        <p class="mt-1 text-sm text-slate-400">@entry.Summary</p>
                    </div>
                    <span class="shrink-0 rounded-md border border-slate-700/70 bg-slate-900/70 px-2 py-1 text-xs font-semibold text-slate-400">
                        @entry.Date
                    </span>
                </div>
                <ul class="mt-3 space-y-2 text-sm text-slate-300">
                    @foreach (var change in entry.Changes)
                    {
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check mt-1 text-[10px] text-emerald-300"></i>
                            <span>@change</span>
                        </li>
                    }
                </ul>
            </article>
        }
    </div>
</ActionSheet>

@code {
    private bool _showChangelog;
    private bool _isMobileTabbarExpanded;
    private DotNetObjectReference<MainLayout>? _mobileTabbarReference;
    private IJSObjectReference? _mobileTabbarModule;
    private IJSObjectReference? _mobileTabbarBehavior;

    private BuildInfo BuildInfo => BuildInfoService.GetBuildInfo();

    protected override void OnInitialized()
    {
        RouteTransitionDirection.Initialize(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _mobileTabbarReference = DotNetObjectReference.Create(this);
        var mobileTabbarCacheKey = Uri.EscapeDataString(BuildInfo.ShortCommit);
        _mobileTabbarModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", $"/js/mobileNavBehavior.js?v={mobileTabbarCacheKey}");
        _mobileTabbarBehavior = await _mobileTabbarModule.InvokeAsync<IJSObjectReference>("start", _mobileTabbarReference);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        RouteTransitionDirection.NotifyNavigated(args.Location);
    }

    private void OpenChangelog()
    {
        _showChangelog = true;
    }

    private Task CloseChangelogAsync()
    {
        _showChangelog = false;
        return Task.CompletedTask;
    }

    private string FormatBuildTime()
    {
        return BuildInfo.BuiltAtUtc.HasValue
            ? BuildInfo.BuiltAtUtc.Value.ToLocalTime().ToString("MMM d HH:mm")
            : "local build";
    }

    [JSInvokable]
    public Task SetMobileTabbarExpanded(bool expanded)
    {
        if (_isMobileTabbarExpanded == expanded)
        {
            return Task.CompletedTask;
        }

        _isMobileTabbarExpanded = expanded;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;

        try
        {
            if (_mobileTabbarBehavior is not null)
            {
                await _mobileTabbarBehavior.InvokeVoidAsync("dispose");
            }

            if (_mobileTabbarModule is not null)
            {
                await _mobileTabbarModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Navigation or reconnect disposal can race with JS interop shutdown.
        }

        _mobileTabbarReference?.Dispose();
    }
}

<!-- BOTTOM NAVIGATION (Mobile) -->
<nav class="mobile-tabbar @(_isMobileTabbarExpanded ? "mobile-tabbar-expanded" : "mobile-tabbar-compact") md:hidden" aria-label="Primary navigation">
    <NavLink href="/" Match="NavLinkMatch.All" 
             class="mobile-tabbar-item"
             title="Dashboard"
             aria-label="Dashboard"
             ActiveClass="mobile-tabbar-item-active">
        <span class="mobile-tabbar-icon"><i class="fas fa-tachometer-alt"></i></span>
        <span class="mobile-tabbar-label">Dashboard</span>
    </NavLink>
    <NavLink href="/details"
              class="mobile-tabbar-item"
              title="Analytics"
              aria-label="Analytics"
              ActiveClass="mobile-tabbar-item-active">
        <span class="mobile-tabbar-icon"><i class="fas fa-chart-line"></i></span>
        <span class="mobile-tabbar-label">Analytics</span>
    </NavLink>
    <NavLink href="/xrouter"
              class="mobile-tabbar-item"
              title="Wifi"
              aria-label="Wifi"
              ActiveClass="mobile-tabbar-item-active">
        <span class="mobile-tabbar-icon"><i class="fas fa-wifi"></i></span>
        <span class="mobile-tabbar-label">Wifi</span>
    </NavLink>
    <NavLink href="/settings"
              class="mobile-tabbar-item"
             title="Settings"
             aria-label="Settings"
             ActiveClass="mobile-tabbar-item-active">
        <span class="mobile-tabbar-icon"><i class="fas fa-cog"></i></span>
        <span class="mobile-tabbar-label">Settings</span>
    </NavLink>
</nav>

<div id="blazor-error-ui" aria-hidden="true" data-nosnippet></div>
<div id="ulink-fatal-recovery"
     class="ulink-fatal-recovery"
     role="alert"
     aria-live="assertive"
     aria-hidden="true"
     tabindex="-1"
     hidden
     data-nosnippet>
    <div class="ulink-fatal-recovery-message">
        <img src="/icons/ulink-logo.svg" alt="" aria-hidden="true" />
        <div>
            <strong>uLink could not refresh this page.</strong>
            <span>Automatic recovery is paused. Please reopen the page in a moment.</span>
        </div>
    </div>
</div>

