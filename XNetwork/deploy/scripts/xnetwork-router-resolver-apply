#!/usr/bin/env bash
# Pins the router's OWN resolver to the local dnsmasq instead of Tailscale MagicDNS.
#
# Tailscale rewrites /etc/resolv.conf to point at 100.100.100.100 and, when the coordination
# server supplies no global resolvers, forwards anything that is not a MagicDNS name to "the
# system default" -- which is the file it just rewrote. Across a reboot tailscaled reads that
# leftover file and adopts itself as its own upstream, so tailnet names keep resolving while
# every public name fails. The router then cannot look up its own WAN identities and the
# dashboard reports "ISP unavailable".
#
# Our dnsmasq already answers both halves correctly: public names via its configured upstreams
# and MagicDNS names via `server=/ts.net/100.100.100.100`. So the router should ask dnsmasq and
# leave Tailscale out of its resolver path entirely.
#
# Idempotent; safe to re-run on every deploy.
set -euo pipefail

RESOLV_CONF="/etc/resolv.conf"
NM_DROPIN="/etc/NetworkManager/conf.d/10-xnetwork-dns.conf"
MARKER="# Managed by XNetwork (uLink)"
FALLBACK_NS="1.1.1.1"

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "xnetwork-router-resolver-apply must run as root." >&2
  exit 1
fi

# Without a local resolver to point at, rewriting resolv.conf would leave the router with only
# the public fallback and silently drop every bypass domain rule. Leave it alone instead.
if ! systemctl is-enabled --quiet xnetwork-dns.service 2>/dev/null &&
   ! systemctl is-active --quiet xnetwork-dns.service 2>/dev/null; then
  echo "xnetwork-dns.service is neither enabled nor active; leaving $RESOLV_CONF untouched."
  exit 0
fi

# Keep whatever search domain is already in effect so short tailnet names still work. Prefer
# Tailscale's own view, since it knows the tailnet suffix even when resolv.conf is mid-rewrite.
search_domain=""
if command -v tailscale >/dev/null 2>&1; then
  search_domain="$(tailscale status --json 2>/dev/null |
    sed -n 's/.*"MagicDNSSuffix"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
fi
if [[ -z "$search_domain" && -f "$RESOLV_CONF" ]]; then
  search_domain="$(awk '/^search[[:space:]]/ {print $2; exit}' "$RESOLV_CONF" || true)"
fi

# Stop Tailscale owning resolv.conf. This is a persisted preference, so it survives reboots
# and is what actually breaks the self-reference.
if command -v tailscale >/dev/null 2>&1; then
  if tailscale set --accept-dns=false 2>/dev/null; then
    echo "Tailscale DNS takeover disabled (accept-dns=false)."
  else
    echo "Warning: could not set accept-dns=false; Tailscale may reclaim $RESOLV_CONF." >&2
  fi
fi

# Stop NetworkManager rewriting it either, so the file below is the single source of truth.
install -d -m 0755 "$(dirname "$NM_DROPIN")"
nm_desired="$(printf '%s\n[main]\ndns=none\nrc-manager=unmanaged\n' "$MARKER")"
if [[ ! -f "$NM_DROPIN" ]] || [[ "$(cat "$NM_DROPIN")" != "$nm_desired" ]]; then
  printf '%s\n' "$nm_desired" >"$NM_DROPIN"
  chmod 0644 "$NM_DROPIN"
  systemctl reload NetworkManager 2>/dev/null || true
  echo "NetworkManager set to leave $RESOLV_CONF alone."
fi

# One backup of whatever we found the first time, so the original is recoverable.
if [[ -f "$RESOLV_CONF" ]] && ! grep -qF "$MARKER" "$RESOLV_CONF" 2>/dev/null; then
  cp -a "$RESOLV_CONF" "${RESOLV_CONF}.pre-xnetwork" 2>/dev/null || true
fi

# Tailscale may hold resolv.conf immutable while it manages it.
chattr -i "$RESOLV_CONF" 2>/dev/null || true
rm -f "$RESOLV_CONF" 2>/dev/null || true

{
  echo "$MARKER -- do not edit; regenerated by deploy.sh"
  echo "# Local dnsmasq first (bypass domain rules, MagicDNS via server=/ts.net/), then a"
  echo "# public fallback so a stopped resolver cannot black-hole the router's own lookups."
  echo "nameserver 127.0.0.1"
  echo "nameserver $FALLBACK_NS"
  [[ -n "$search_domain" ]] && echo "search $search_domain"
  echo "options timeout:2 attempts:2"
} >"$RESOLV_CONF"
chmod 0644 "$RESOLV_CONF"

echo "Router resolver pinned to local dnsmasq${search_domain:+ (search $search_domain)}."
