{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "MyHttpEndpoint": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "NetworkMonitor": {
    "Enabled": true,
    "WhitelistedLinks": ["enxc8a3627e629b"],
    "DownTimeoutSeconds": 30,
    "MaxRestartAttemptsPerHour": 0,
    "RestartCooldownMinutes": 15
  },
  "XBond": {
    "Enabled": true,
    "TrafficEngineMode": "xbond-active",
    "AllowServiceControl": true,
    "ClientServiceName": "xbond-client.service",
    "ServiceManagerPath": "systemctl",
    "UseSudoForServiceManager": true,
    "SudoPath": "sudo",
    "ServiceCommandTimeoutSeconds": 10,
    "ClientBinaryPath": "xbond-client",
    "ClientConfigPath": "/etc/xbond/client.toml",
    "RuntimeStatusPath": "/run/xbond/client-status.json",
    "ClientControlSocketPath": "/run/xbond/client-control.sock",
    "ScheduleMode": "anchor-duplicate-1",
    "MaxActiveBackups": 1,
    "StatusTimeoutSeconds": 2,
    "PublicTestServerAddress": "45.77.241.247:8444",
    "PublicTestPathId": 1,
    "PublicTestPathIds": [],
    "PublicTestBinds": [],
    "PublicTestCount": 10,
    "PublicTestIntervalMs": 100,
    "PublicTestPacketTimeoutMs": 2500,
    "PublicTestCommandTimeoutSeconds": 45,
    "PublicTestKeyEnvironmentVariable": "XBOND_PSK",
    "PublicTestKeyFilePath": "/etc/xbond/client.env",
    "TunnelDevice": "xbond0",
    "TunnelSource": "10.250.0.2",
    "RouteCommandPath": "ip",
    "PingCommandPath": "ping",
    "ScopedRouteDefaultTarget": "8.8.8.8",
    "ScopedRouteTestCount": 10,
    "ScopedRoutePacketTimeoutSeconds": 2,
    "ScopedRouteCommandTimeoutSeconds": 45,
    "SpeedTestCommandPath": "speedtest",
    "SpeedTestCommandTimeoutSeconds": 180,
    "SpeedTestHttpTimeoutSeconds": 15,
    "IperfCommandPath": "iperf3",
    "ServerSpeedTestHost": "10.250.0.1",
    "ServerSpeedTestPort": 5201,
    "NativeSpeedTestHost": "45.77.241.247",
    "NativeSpeedTestPort": 5202,
    "ServerSpeedTestDurationSeconds": 8,
    "ServerSpeedTestCommandTimeoutSeconds": 45,
    "NativeSpeedTestCommandTimeoutSeconds": 12,
    "IperfConnectTimeoutMs": 3000,
    "PerformanceArtifactDirectory": "/var/lib/xnetwork/diagnostics",
    "PerformanceMatrixSettleSeconds": 4,
    "PerformanceMatrixOverrideTtlSeconds": 120,
    "IptablesCommandPath": "iptables",
    "MssClampEnabled": false,
    "MssClampValue": 1360,
    "MtuSweepValues": [1200, 1280, 1360, 1400, 1420]
  },
  "CudyApAutomation": {
    "Enabled": false,
    "ManagementBaseUrl": "",
    "AdminPassword": "",
    "AdminPasswordFilePath": "",
    "AdminPasswordEnvironmentVariable": "CUDY_ADMIN_PASSWORD",
    "WifiInterface": "wlan0",
    "HomeSsid": "",
    "HomeBssid": "",
    "DisableWhenSignalAtLeast": 55,
    "EnableWhenSignalBelow": 35,
    "CheckIntervalSeconds": 15,
    "DisableAfterSeenSeconds": 30,
    "EnableAfterMissingSeconds": 120,
    "ReEnableWhenHomeMissing": true,
    "Disable2G": true,
    "Disable5G": true,
    "RequestTimeoutSeconds": 10
  },
  "AdapterIdentity": {
    "Enabled": true,
    "Endpoints": [ "https://ipwho.is/", "http://ip-api.com/json/" ],
    "RefreshIntervalSeconds": 60,
    "SuccessTtlMinutes": 15,
    "FailureBackoffSeconds": 120,
    "RequestTimeoutSeconds": 5
  },
  "StarlinkTelemetry": {
    "Enabled": true,
    "Host": "192.168.100.1",
    "GrpcPort": 9200,
    "GrpcWebPort": 9201,
    "UseGrpcWebFallback": true,
    "PollIntervalSeconds": 5,
    "RequestTimeoutSeconds": 2,
    "StaleAfterSeconds": 30,
    "AdapterNameHints": ["Starlink"],
    "AdapterProbeEnabled": true,
    "AdapterProbeIntervalSeconds": 30
  },
  "StarlinkLanAccess": {
    "Enabled": true,
    "Destination": "192.168.100.1",
    "LanInterface": "eth0",
    "LanSubnet": "192.168.145.0/24",
    "ApplyHelperPath": "/usr/local/sbin/xnetwork-starlink-lan-access-apply",
    "CheckIntervalSeconds": 10,
    "VerifyIntervalSeconds": 60,
    "CommandTimeoutSeconds": 10
  },
  "F50ModemRecovery": {
    "Enabled": true,
    "CheckIntervalMinutes": 3,
    "FailedRecoveryCooldownRounds": 1,
    "SettleTimeoutSeconds": 75,
    "UsbResetEnabled": true,
    "UsbResetCommandPath": "usbreset",
    "PingTarget": "45.77.241.247",
    "PingCount": 2,
    "PingTimeoutSeconds": 2,
    "SevereLossPercent": 95
  },
  "XBondClientWatchdog": {
    "Enabled": true,
    "CheckIntervalSeconds": 10,
    "ConsecutiveUnhealthyChecks": 3,
    "TunnelRttThresholdMs": 300,
    "TunnelLossThresholdPercent": 25,
    "TunnelStaleAfterSeconds": 10,
    "PhysicalProbeTarget": "",
    "PhysicalMaxRttMs": 200,
    "PhysicalMaxLossPercent": 25,
    "MinimumHealthyPhysicalPaths": 1,
    "ProbeCount": 3,
    "ProbeTimeoutSeconds": 2,
    "RestartCooldownMinutes": 10,
    "PostRestartGraceSeconds": 45,
    "MaxRestartsPerHour": 2
  }
}
