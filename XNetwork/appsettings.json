{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "MyHttpEndpoint": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "NetworkMonitor": {
    "Enabled": true,
    "WhitelistedLinks": ["enxc8a3627e629b"],
    "DownTimeoutSeconds": 30,
    "MaxRestartAttemptsPerHour": 0,
    "RestartCooldownMinutes": 15
  },
  "PrivateReconnect": {
    "Enabled": false,
    "IntervalMinutes": 30,
    "DelaySeconds": 2,
    "HealthTriggerEnabled": false,
    "HealthLatencyThresholdMs": 300,
    "HealthDegradedSeconds": 120,
    "HealthRecoveryObserveSeconds": 60,
    "HealthCooldownMinutes": 15
  },
  "XBond": {
    "Enabled": true,
    "TrafficEngineMode": "speedify-primary",
    "AllowServiceControl": true,
    "AllowPrimaryMode": false,
    "ClientServiceName": "xbond-client.service",
    "ServiceManagerPath": "systemctl",
    "UseSudoForServiceManager": true,
    "SudoPath": "sudo",
    "ServiceCommandTimeoutSeconds": 10,
    "ClientBinaryPath": "xbond-client",
    "ClientConfigPath": "/etc/xbond/client.toml",
    "StatusTimeoutSeconds": 2,
    "PublicTestServerAddress": "45.77.241.247:8444",
    "PublicTestBypassPort": 8444,
    "PublicTestBypassProtocol": "udp",
    "PublicTestPathId": 1,
    "PublicTestPathIds": [],
    "PublicTestBinds": [],
    "PublicTestCount": 10,
    "PublicTestIntervalMs": 100,
    "PublicTestPacketTimeoutMs": 2500,
    "PublicTestBypassSettleMs": 2000,
    "MultiPathUseSpeedifyBypass": false,
    "PublicTestCommandTimeoutSeconds": 45,
    "PublicTestKeyEnvironmentVariable": "XBOND_PSK",
    "PublicTestKeyFilePath": "/home/xeon-network/.config/XNetwork/xbond-psk",
    "CanaryTunnelDevice": "xbond0",
    "CanaryTunnelSource": "10.250.0.2",
    "RouteCommandPath": "ip",
    "PingCommandPath": "ping",
    "ScopedRouteDefaultTarget": "1.1.1.1",
    "ScopedRouteTestCount": 10,
    "ScopedRoutePacketTimeoutSeconds": 2,
    "ScopedRouteCommandTimeoutSeconds": 45
  },
  "AdapterRoutingPriority": {
    "Enabled": false,
    "ApplyOnStartup": false,
    "AdapterMetrics": []
  },
  "CudyApAutomation": {
    "Enabled": false,
    "ManagementBaseUrl": "",
    "AdminPassword": "",
    "AdminPasswordFilePath": "",
    "AdminPasswordEnvironmentVariable": "CUDY_ADMIN_PASSWORD",
    "WifiInterface": "wlan0",
    "HomeSsid": "",
    "HomeBssid": "",
    "DisableWhenSignalAtLeast": 55,
    "EnableWhenSignalBelow": 35,
    "CheckIntervalSeconds": 15,
    "DisableAfterSeenSeconds": 30,
    "EnableAfterMissingSeconds": 120,
    "ReEnableWhenHomeMissing": true,
    "Disable2G": true,
    "Disable5G": true,
    "RequestTimeoutSeconds": 10
  },
  "StarlinkTelemetry": {
    "Enabled": true,
    "Host": "192.168.100.1",
    "GrpcPort": 9200,
    "GrpcWebPort": 9201,
    "UseGrpcWebFallback": true,
    "PollIntervalSeconds": 5,
    "RequestTimeoutSeconds": 2,
    "StaleAfterSeconds": 30,
    "AdapterNameHints": ["Starlink"],
    "AdapterProbeEnabled": true,
    "AdapterProbeIntervalSeconds": 30
  },
  "AutoServerSwitch": {
    "Enabled": false,
    "PreferredCountry": "sg",
    "PreferredCity": "singapore",
    "FallbackCountries": ["hk", "jp", "ph"],
    "IncludePremiumServers": true,
    "IncludePrivateServers": false,
    "CheckIntervalSeconds": 15,
    "DegradedSecondsBeforeSwitch": 90,
    "HealthWindowSeconds": 120,
    "MinimumBadSamplesInWindow": 3,
    "MinimumBadSampleRatio": 0.35,
    "RequireProbeCurrentServerBad": true,
    "CooldownMinutes": 10,
    "AvoidServerMinutes": 30,
    "MinimumConnectedAdaptersBeforeSwitch": 2,
    "RequiredRecommendationConfirmations": 2,
    "ProbeApiBaseUrl": "",
    "ProbeApiKey": "",
    "ProbeRequestTimeoutSeconds": 10,
    "ProbeMaxScoreAgeMinutes": 30,
    "MinimumProbeScore": 70,
    "MinimumScoreImprovement": 10,
    "MaxLatencyMs": 250,
    "MaxJitterMs": 80,
    "MinSuccessRate": 85
  }
}
